STR3_1  = '("Taurus") Controlador de teclado de segunda generación para FreeDOS';
STR3_2  = 'Licencia:  GNU-GPL 2.0';
STR3_3  = '(/? ayuda, /V ampliar información)';
STR3_4  = 'KEYB  disposición[,[PC][,nombrearchivo] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'disposición Identificador de una disposición de teclado física, como SP o ES';
STR3_6  = 'PC          Página de códigos inicial para este teclado';
STR3_7  = 'archivo     Archivo que contiene la información para esta disposición';
STR3_8  = '/ID:nnn     Identificador numérico para una variante de teclado';
STR3_9  = '/?          Mostrar esta ayuda';
STR3_10 = '/9          Instala el controlador para int9h (incompatible con /E) ';
STR3_11 = '/B          Desactiva efectos sonoros de KEYB (altavoz)';
STR3_12 = '/CAPSLOCK=ON|OFF    Activa o desactiva del Bloqueo Mayúsculas';
STR3_13 = '/Dx         Separador decimal: x es el carácter que se utilizará';
STR3_14 = '/E          Especifica que el teclado es un teclado AT mejorado';
STR3_15 = '            (incompatible con /9)';
STR3_16 = '/I          (forzar Instalación) Fuerza la instalación incondicional de KEYB';
STR3_17 = '/L=m        (forzar subDisposición) Fuerza usar la subdisposición m';
STR3_18 = '/NOHI       Evita que KEYB cargue datos en la memoria ALTA';
STR3_19 = '/NOUMB      Evita que KEYB cargue datos en la memoria SUPERIOR';
STR3_20 = '/NUMLOCK=ON|OFF    Activa o desactiva el Bloqueo Numérico';
STR3_21 = '/S          (modo Seguro) Impide usar Strings,... (ver documentación)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Activa o Desactiva el Bloqueo de Desplazamiento';
STR3_23 = '/U          Desistala la parte residente del controlador';
STR3_24 = '/V          Muestra información extendida al instalar';
STR3_25 = 'Más información: ver README.TXT';


