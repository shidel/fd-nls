STR3_1  = '("Taurus") Driver tastiera di seconda generazione per FreeDOS';
STR3_2  = 'Licenza: GNU-GPL 2.0 o successiva';
STR3_3  = '(/? aiuto, /V dettagliato)';
STR3_4  = 'KEYB nomeLayout[,[CP][,nomefile] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'nomeLayout  Identificatore fisico del layout, come GR o IT';
STR3_6  = 'CP          Codepage iniziale per il layout';
STR3_7  = 'nomefile    File contenente le informazioni per il layout';
STR3_8 = '/ID:nnn     Identificatore numerico per una variante di tastiera';
STR3_9  = '/?          Mostra questo aiuto';
STR3_10 = '/9          Installa il gestore int9h (incompatibile con /E)';
STR3_11 = '/B          Beep off: disattiva effetti sonori di KEYB (altoparlante)';
STR3_12 = '/CAPSLOCK=ON|OFF    Attiva o disattiva il Blocco Maiuscole';
STR3_13 = '/Dx         Separatore decimale: x Š il carattere da usare';
STR3_14 = '/E          Specifica che la tastiera Š di tipo esteso';
STR3_15 = '            (incompatibile con /9)';
STR3_16 = '/I          (Installa forzatamente) Installa KEYB in ogni caso';
STR3_17 = '/L=m        (Sottolayout forzato) Forza l uso del sottolayout m';
STR3_18 = '/NOHI       Evita che KEYB carichi i dati nella memoria alta';
STR3_19 = '/NOUMB      Evita che KEYB carichi i dati nella memoria superiore';
STR3_20 = '/NUMLOCK=ON|OFF    Attiva o disattiva il Blocco Numeri';
STR3_21 = '/S          (Safemode) proibisce stringhe,... (vedi documentazione)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Attiva o disattiva il Blocco Scorrimento';
STR3_23 = '/U          (Uninstall) scarica il driver dalla memoria';
STR3_24 = '/V          (Verbose) mostra informazioni dettagliate sull install';
STR3_25 = 'Ulteriori informazioni: README.TXT';

