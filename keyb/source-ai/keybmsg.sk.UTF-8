STR3_1  = '("Taurus") Druhá generácia ovládača klávesnice pre FreeDOS';
STR3_2  = 'Licencia: GNU GPL 2.0 alebo novšia';
STR3_3  = '(/? pomoc, /V podrobne)';
STR3_4  = 'KEYB názov[,[CP][,súbor] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'názov       Fyzický identifikátor rozloženia, napr. GR alebo SK';
STR3_6  = 'CP          Počiatočná codepage pre rozloženie';
STR3_7  = 'súbor       Súbor obsahujúci informácie o rozložení';
STR3_8 = '/ID:nnn     Číselný identifikátor variantu klávesnice';
STR3_9  = '/?          Zobrazí túto pomoc';
STR3_10 = '/9          Inštaluje obsluhu int9h (nekompatibilné s /E)';
STR3_11 = '/B          Pípnutie vypnuté: vypne zvukové efekty KEYB (reproduktor)';
STR3_12 = '/CAPSLOCK=ON|OFF    Zapne alebo vypne Caps Lock';
STR3_13 = '/Dx         Desatinný oddeľovač: x je znak, ktorý sa má použiť';
STR3_14 = '/E          Určuje, že klávesnica je rozšírená (Enhanced)';
STR3_15 = '            (nekompatibilné s /9)';
STR3_16 = '/I          (force Install) Inštaluje keyb bezpodmienečne';
STR3_17 = '/L=m        (force subLayout) Vynúti použitie podrozloženia m';
STR3_18 = '/NOHI       Zabráni KEYB v načítaní dát do pamäte High Memory';
STR3_19 = '/NOUMB      Zabráni KEYB v načítaní dát do pamäte Upper Memory';
STR3_20 = '/NUMLOCK=ON|OFF    Zapne alebo vypne Num Lock';
STR3_21 = '/S          (Safemode) zakáže reťazce... (pozri dokumentáciu)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Zapne alebo vypne Scroll Lock';
STR3_23 = '/U          (Uninstall) uvoľní ovládač z pamäte';
STR3_24 = '/V          (Verbose) zobrazí podrobné informácie o inštalácii';
STR3_25 = 'Ďalšie informácie: README.TXT';

