STR3_1  = '("Taurus") Otrās paaudzes tastatūras draiveris priekš FreeDOS';
STR3_2  = 'Licence: GNU GPL 2.0 vai jaunāka';
STR3_3  = '(/? palīdzība, /V izvērsti)';
STR3_4  = 'KEYB Izkārtojums[,[CP][,failvārds] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V]';
STR3_5  = 'Izkārtojums  Fizisks identifikators, piemēram, GR vai LV';
STR3_6  = 'CP           Sākotnējā codepage izkārtojumam';
STR3_7  = 'failvārds    Fails, kas satur informāciju par izkārtojumu';
STR3_8 = '/ID:nnn      Skaitlisks identifikators tastatūras variantam';
STR3_9  = '/?           Rāda šo palīdzību';
STR3_10 = '/9           Instalē int9h apstrādātāju (nesaderīgs ar /E)';
STR3_11 = '/B           Beep off: izslēgt KEYB skaņas efektus (skaļrunis)';
STR3_12 = '/CAPSLOCK=ON|OFF    Iespējo vai atspējo Caps Lock';
STR3_13 = '/Dx          Decimālais atdalītājs: x ir izmantojamā rakstzīme';
STR3_14 = '/E           Norāda, ka tastatūra ir uzlabotā (Enhanced)';
STR3_15 = '             (nesaderīgs ar /9)';
STR3_16 = '/I           (force Install) Instalēt keyb bez nosacījumiem';
STR3_17 = '/L=m         (force subLayout) Piespiest apakšizkārtojuma m lietošanu';
STR3_18 = '/NOHI        Neļauj KEYB ielādēt datus augstajā atmiņā';
STR3_19 = '/NOUMB       Neļauj KEYB ielādēt datus augšējā atmiņā (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF    Iespējo vai atspējo Num Lock';
STR3_21 = '/S           (Safemode) aizliedz virknes... (skatīt dokumentāciju)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Iespējo vai atspējo Scroll Lock';
STR3_23 = '/U           (Uninstall) izlādē draiveri no atmiņas';
STR3_24 = '/V           (Verbose) rāda izvērstu info par instalēšanu';
STR3_25 = 'Vairāk informācijas: README.TXT';

