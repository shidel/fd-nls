STR3_1  = '("Taurus") Dua generacio de klavara pelilo por FreeDOS';
STR3_2  = 'Permesilo: GNU GPL 2.0 aŭ poste';
STR3_3  = '(/? helpo, /V detala)';
STR3_4  = 'KEYB Aranĝnomo[,[CP][,dosiernomo] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'Aranĝnomo    Fizika aranĝ-identigilo, kiel GR aŭ EO';
STR3_6  = 'CP           La komenca codepage por la aranĝo';
STR3_7  = 'dosiernomo   Dosiero enhavanta la informojn por la aranĝo';
STR3_8 = '/ID:nnn      Numera identigilo por klavara varianto';
STR3_9  = '/?           Montras ĉi tiun helpon';
STR3_10 = '/9           Instalas la int9h-traktilon (nekongrua kun /E)';
STR3_11 = '/B           Bipo malŝaltita: malŝalti KEYB-son-efektojn (parolilo)';
STR3_12 = '/CAPSLOCK=ON|OFF    Ŝaltas aŭ malŝaltas la majusklo-ŝlosilon';
STR3_13 = '/Dx          Dekuma apartigilo: x estas la uzota signo';
STR3_14 = '/E           Specifas, ke la klavaro estas plibonigita (Enhanced)';
STR3_15 = '             (nekongrua kun /9)';
STR3_16 = '/I           (force Install) Instali keyb senkondiĉe';
STR3_17 = '/L=m         (force subLayout) Devigi uzon de subaranĝo m';
STR3_18 = '/NOHI        Malhelpas KEYB ŝargi datumojn en altan memoron';
STR3_19 = '/NOUMB       Malhelpas KEYB ŝargi datumojn en supran memoron (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF    Ŝaltas aŭ malŝaltas la cifero-ŝlosilon';
STR3_21 = '/S           (Safemode) malpermesas ĉenojn... (vidu dokumentaron)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Ŝaltas aŭ malŝaltas la rulo-ŝlosilon';
STR3_23 = '/U           (Uninstall) malŝargas la pelilon de la memoro';
STR3_24 = '/V           (Verbose) montras detalajn informojn pri la instalo';
STR3_25 = 'Plia informo: README.TXT';

