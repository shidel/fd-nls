STR3_6  = 'CP          Pradinė codepage išdėstymui';
STR3_7  = 'failas      Failas, kuriame yra išdėstymo informacija';
STR3_8 = '/ID:nnn     Skaitinis klaviatūros varianto identifikatorius';
STR3_9  = '/?          Rodo šią pagalbą';
STR3_10 = '/9          Įdiegia int9h doroklį (nesuderinama su /E)';
STR3_11 = '/B          Beep off: išjungti KEYB garso efektus (garsiakalbis)';
STR3_12 = '/CAPSLOCK=ON|OFF    Įjungia arba išjungia Caps Lock';
STR3_13 = '/Dx         Dešimtainis skirtukas: x yra naudojamas simbolis';
STR3_14 = '/E          Nurodo, kad klaviatūra yra išplėstinė (Enhanced)';
STR3_15 = '            (nesuderinama su /9)';
STR3_16 = '/I          (force Install) Įdiegti keyb besąlygiškai';
STR3_17 = '/L=m        (force subLayout) Priverstinai naudoti subišdėstymą m';
STR3_18 = '/NOHI       Neleidžia KEYB įkelti duomenų į aukštąją atmintį';
STR3_19 = '/NOUMB      Neleidžia KEYB įkelti duomenų į viršutinę atmintį (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF    Įjungia arba išjungia Num Lock';
STR3_21 = '/S          (Safemode) draudžia eilutes... (žr. dokumentaciją)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Įjungia arba išjungia Scroll Lock';
STR3_23 = '/U          (Uninstall) pašalina tvarkyklę iš atminties';
STR3_24 = '/V          (Verbose) rodo išsamią informaciją apie diegimą';
