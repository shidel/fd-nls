STR3_1  = '("Taurus") Önnur kynslóð lyklaborðsrekla fyrir FreeDOS';
STR3_2  = 'Leyfi: GNU GPL 2.0 eða síðar';
STR3_3  = '(/? hjálp, /V ítarlegt)';
STR3_4  = 'KEYB Uppsetningarheiti[,[CP][,skráarnafn] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V]';
STR3_5  = 'Uppsetningarheiti  Auðkenni fyrir uppsetningu, eins og GR eða IS';
STR3_6  = 'CP                 Upphaflega codepage fyrir uppsetninguna';
STR3_7  = 'skráarnafn         Skrá sem inniheldur upplýsingar fyrir uppsetninguna';
STR3_8 = '/ID:nnn            Talnaauðkenni fyrir lyklaborðsgerð';
STR3_9  = '/?                 Sýnir þessa hjálp';
STR3_10 = '/9                 Setur upp int9h-meðhöndlun (ósamrýmanlegt við /E)';
STR3_11 = '/B                 Beep off: slökkva á KEYB hljóðum (hátalari)';
STR3_12 = '/CAPSLOCK=ON|OFF   Virkjar eða afvirkjar Caps Lock';
STR3_13 = '/Dx                Tugastafatákn: x er táknið sem á að nota';
STR3_14 = '/E                 Tilgreinir að lyklaborðið sé útvíkkað (Enhanced)';
STR3_15 = '                   (ósamrýmanlegt við /9)';
STR3_16 = '/I                 (force Install) Setja upp keyb skilyrðislaust';
STR3_17 = '/L=m               (force subLayout) Þvinga notkun undiruppsetningar m';
STR3_18 = '/NOHI              Kemur í veg fyrir að KEYB hlaði gögnum í háminni';
STR3_19 = '/NOUMB             Kemur í veg fyrir að KEYB hlaði gögnum í efra minni';
STR3_20 = '/NUMLOCK=ON|OFF    Virkjar eða afvirkjar Num Lock';
STR3_21 = '/S                 (Safemode) bannar strengi... (sjá skjöl)';
STR3_22 = '/SCROLLLOCK=ON|OFF Virkjar eða afvirkjar Scroll Lock';
STR3_23 = '/U                 (Uninstall) fjarlægir rekilinn úr minni';
STR3_24 = '/V                 (Verbose) sýnir ítarlegar upplýsingar um uppsetningu';
STR3_25 = 'Frekari upplýsingar: README.TXT';

