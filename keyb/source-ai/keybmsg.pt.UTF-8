STR3_1  = '("Taurus") Driver de teclado de segunda geração para FreeDOS';
STR3_2  = 'Licença: GNU-GPL 2.0 ou posterior';
STR3_3  = '(/? ajuda, /V detalhado)';
STR3_4  = 'KEYB nomeLayout[,[CP][,ficheiro] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'nomeLayout  Um identificador de layout físico, como GR ou PT';
STR3_6  = 'CP          A codepage inicial para o layout';
STR3_7  = 'ficheiro    Ficheiro contendo as informações para o layout';
STR3_8 = '/ID:nnn     Identificador numérico para uma variante de teclado';
STR3_9  = '/?          Mostra esta ajuda';
STR3_10 = '/9          Instala o manipulador int9h (inkompatível com /E)';
STR3_11 = '/B          Beep off: desativa efeitos sonoros do KEYB (altifalante)';
STR3_12 = '/CAPSLOCK=ON|OFF    Ativa ou desativa o Caps Lock';
STR3_13 = '/Dx         Separador decimal: x é o caractere a ser usado';
STR3_14 = '/E          Especifica que o teclado é um teclado estendido';
STR3_15 = '            (inkompatível com /9)';
STR3_16 = '/I          (force Install) Instala o keyb incondicionalmente';
STR3_17 = '/L=m        (force subLayout) Força o uso do sublayout m';
STR3_18 = '/NOHI       Evita que o KEYB carregue dados na memória alta';
STR3_19 = '/NOUMB      Evita que o KEYB carregue dados na memória superior';
STR3_20 = '/NUMLOCK=ON|OFF    Ativa ou desativa o Num Lock';
STR3_21 = '/S          (Safemode) proíbe strings... (ver documentação)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Ativa ou desativa o Scroll Lock';
STR3_23 = '/U          (Uninstall) descarrega o driver da memória';
STR3_24 = '/V          (Verbose) mostra informações detalhadas sobre a inst.';
STR3_25 = 'Mais informações: README.TXT';

