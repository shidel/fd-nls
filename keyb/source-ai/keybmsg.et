STR3_3  = '(/? abi, /V Åksikasjalik)';
STR3_4  = 'KEYB PaigutusNimi[,[CP][,failinimi] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V]';
STR3_5  = 'PaigutusNimi FÅÅsiline identifikaator, nagu GR v‰i ET';
STR3_6  = 'CP           Paigutuse algne koodileht';
STR3_7  = 'failinimi    Fail, mis sisaldab teavet paigutuse kohta';
STR3_8 = '/ID:nnn      Klaviatuuri variandi numbriline identifikaator';
STR3_9  = '/?           NÑitab seda abi';
STR3_10 = '/9           Installib int9h-kÑitleja (Åhildumatu /E-ga)';
STR3_11 = '/B           Beep off: lÅlita vÑlja KEYB heliefektid (k‰lar)';
STR3_12 = '/CAPSLOCK=ON|OFF    LÅlitab sisse v‰i vÑlja suurtÑheluku';
STR3_13 = '/Dx          KÅmnendkohtade eraldaja: x on kasutatav mÑrk';
STR3_14 = '/E           MÑÑrab, et klaviatuur on laiendatud (Enhanced)';
STR3_15 = '             (Åhildumatu /9-ga)';
STR3_16 = '/I           (force Install) Installi keyb tingimusteta';
STR3_17 = '/L=m         (force subLayout) Sunni alampaigutuse m kasutus';
STR3_18 = '/NOHI        Takistab KEYB-il andmete laadimist k‰rgesse mÑllu';
STR3_19 = '/NOUMB       Takistab KEYB-il andmete laadimist ÅlamÑllu (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF    LÅlitab sisse v‰i vÑlja numbriluku';
STR3_21 = '/S           (Safemode) keelab stringid... (vt dokumentatsiooni)';
STR3_22 = '/SCROLLLOCK=ON|OFF    LÅlitab sisse v‰i vÑlja kerimisluku';
STR3_23 = '/U           (Uninstall) eemaldab draiveri mÑlust';
STR3_24 = '/V           (Verbose) nÑitab Åksikasjalikku infot installi kohta';
