STR3_1  = '("Taurus") Teise põlvkonna klaviatuuri draiver FreeDOS-ile';
STR3_2  = 'Litsents: GNU GPL 2.0 või hilisem';
STR3_3  = '(/? abi, /V üksikasjalik)';
STR3_4  = 'KEYB PaigutusNimi[,[CP][,failinimi] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V]';
STR3_5  = 'PaigutusNimi Füüsiline identifikaator, nagu GR või ET';
STR3_6  = 'CP           Paigutuse algne koodileht';
STR3_7  = 'failinimi    Fail, mis sisaldab teavet paigutuse kohta';
STR3_8 = '/ID:nnn      Klaviatuuri variandi numbriline identifikaator';
STR3_9  = '/?           Näitab seda abi';
STR3_10 = '/9           Installib int9h-käitleja (ühildumatu /E-ga)';
STR3_11 = '/B           Beep off: lülita välja KEYB heliefektid (kõlar)';
STR3_12 = '/CAPSLOCK=ON|OFF    Lülitab sisse või välja suurtäheluku';
STR3_13 = '/Dx          Kümnendkohtade eraldaja: x on kasutatav märk';
STR3_14 = '/E           Määrab, et klaviatuur on laiendatud (Enhanced)';
STR3_15 = '             (ühildumatu /9-ga)';
STR3_16 = '/I           (force Install) Installi keyb tingimusteta';
STR3_17 = '/L=m         (force subLayout) Sunni alampaigutuse m kasutus';
STR3_18 = '/NOHI        Takistab KEYB-il andmete laadimist kõrgesse mällu';
STR3_19 = '/NOUMB       Takistab KEYB-il andmete laadimist ülamällu (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF    Lülitab sisse või välja numbriluku';
STR3_21 = '/S           (Safemode) keelab stringid... (vt dokumentatsiooni)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Lülitab sisse või välja kerimisluku';
STR3_23 = '/U           (Uninstall) eemaldab draiveri mälust';
STR3_24 = '/V           (Verbose) näitab üksikasjalikku infot installi kohta';
STR3_25 = 'Lisainfo: README.TXT';

