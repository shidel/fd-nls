STR3_1  = '("Taurus") Második generációs billentyűzet-illesztőprogram FreeDOS-hoz';
STR3_2  = 'Licenc: GNU GPL 2.0 vagy újabb';
STR3_3  = '(/? súgó, /V részletes mód)';
STR3_4  = 'KEYB név[,[CP][,fájlnév] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'név         Fizikai kiosztás-azonosító, például GR vagy HU';
STR3_6  = 'CP          A kiosztás kezdeti kódlapja';
STR3_7  = 'fájlnév     A kiosztás információit tartalmazó fájl';
STR3_8 = '/ID:nnn     Numerikus azonosító egy billentyűzet-variánshoz';
STR3_9  = '/?          Megjeleníti ezt a súgót';
STR3_10 = '/9          Az int9h kezelő telepítése (inkompatibilis az /E-vel)';
STR3_11 = '/B          Beep off: KEYB hangeffektusok kikapcsolása (hangszóró)';
STR3_12 = '/CAPSLOCK=ON|OFF    Caps Lock be- vagy kikapcsolása';
STR3_13 = '/Dx         Tizedesjel: x a használandó karakter';
STR3_14 = '/E          Jelzi, hogy a billentyűzet bővített (Enhanced)';
STR3_15 = '            (inkompatibilis a /9-cel)';
STR3_16 = '/I          (force Install) Keyb telepítése feltétel nélkül';
STR3_17 = '/L=m        (force subLayout) Az m alkiosztás használata';
STR3_18 = '/NOHI       Megakadályozza az adatok felső memóriába töltését';
STR3_19 = '/NOUMB      Megakadályozza az adatok UMB memóriába töltését';
STR3_20 = '/NUMLOCK=ON|OFF    Num Lock be- vagy kikapcsolása';
STR3_21 = '/S          (Safemode) tiltja a karakterláncokat... (lásd dokumentáció)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Scroll Lock be- vagy kikapcsolása';
STR3_23 = '/U          (Uninstall) az illesztőprogram eltávolítása a memóriából';
STR3_24 = '/V          (Verbose) részletes információk a telepítésről';
STR3_25 = 'További információk: README.TXT';

