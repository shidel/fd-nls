STR3_1  = '("Taurus") Toisen sukupolven näppäimistöajuri FreeDOS-järjestelmälle';
STR3_2  = 'Lisenssi: GNU GPL 2.0 tai uudempi';
STR3_3  = '(/? ohje, /V yksityiskohdat)';
STR3_4  = 'KEYB asettelu[,[CP][,tiedosto] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'asettelu    Fyysinen asettelutunniste, kuten GR tai FI';
STR3_6  = 'CP          Asettelun alkuperäinen koodisivu';
STR3_7  = 'tiedosto    Tiedosto, joka sisältää asettelun tiedot';
STR3_8 = '/ID:nnn     Näppäimistömuunnelman numeerinen tunniste';
STR3_9  = '/?          Näyttää tämän ohjeen';
STR3_10 = '/9          Asentaa int9h-käsittelijän (yhteensopimaton /E kanssa)';
STR3_11 = '/B          Piippaus pois: poista KEYB-äänitehosteet (kaiutin)';
STR3_12 = '/CAPSLOCK=ON|OFF    Ottaa käyttöön tai poistaa Caps Lockin';
STR3_13 = '/Dx         Desimaalierotin: x on käytettävä merkki';
STR3_14 = '/E          Määrittää, että näppäimistö on laajennettu (Enhanced)';
STR3_15 = '            (yhteensopimaton /9 kanssa)';
STR3_16 = '/I          (Pakota asennus) Asentaa Keyb:n ehdoitta';
STR3_17 = '/L=m        (Pakota aliasettelu) Pakottaa aliasettelun m käytön';
STR3_18 = '/NOHI       Estää KEYB-ajuria lataamasta tietoja ylämuistiin';
STR3_19 = '/NOUMB      Estää KEYB-ajuria lataamasta tietoja UMB-muistiin';
STR3_20 = '/NUMLOCK=ON|OFF    Ottaa käyttöön tai poistaa Num Lockin';
STR3_21 = '/S          (Safemode) kieltää merkkijonot... (katso dokumentaatio)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Ottaa käyttöön tai poistaa Scroll Lockin';
STR3_23 = '/U          (Uninstall) poistaa ajurin muistista';
STR3_24 = '/V          (Verbose) näyttää yksityiskohtaiset tiedot asennuksesta';
STR3_25 = 'Lisätietoja: README.TXT';

