STR3_1  = '("Taurus") Andre generasjons tastaturdriver for FreeDOS';
STR3_2  = 'Lisens: GNU GPL 2.0 eller nyere';
STR3_3  = '(/? hjelp, /V utvidet info)';
STR3_4  = 'KEYB Oppsettnavn[,[CP][,filnavn] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'Oppsettnavn  En fysisk identifikator, slik som GR eller NO';
STR3_6  = 'CP           Den initiale codepage for oppsettet';
STR3_7  = 'filnavn      Fil som inneholder informasjon om oppsettet';
STR3_8 = '/ID:nnn      Numerisk identifikator for en tastaturvariant';
STR3_9  = '/?           Viser denne hjelpen';
STR3_10 = '/9           Installerer int9h-håndtereren (inkompatibel med /E)';
STR3_11 = '/B           Pip av: deaktiver KEYB-lydeffekter (høyttaler)';
STR3_12 = '/CAPSLOCK=ON|OFF    Aktiverer eller deaktiverer Caps Lock';
STR3_13 = '/Dx          Desimalskilletegn: x er tegnet som skal brukes';
STR3_14 = '/E           Spesifiserer at tastaturet er et utvidet tastatur';
STR3_15 = '             (inkompatibel med /9)';
STR3_16 = '/I           (Tving install) Installer keyb betingelsesløst';
STR3_17 = '/L=m         (Tving sublayout) Tving bruk av underoppsett m';
STR3_18 = '/NOHI        Hindrer KEYB i å laste data inn i høyhukommelse';
STR3_19 = '/NOUMB       Hindrer KEYB i å laste data inn i upper memory';
STR3_20 = '/NUMLOCK=ON|OFF    Aktiverer eller deaktiverer Num Lock';
STR3_21 = '/S           (Safemode) forbyr strenger... (se dokumentasjon)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Aktiverer eller deaktiverer Scroll Lock';
STR3_23 = '/U           (Uninstall) fjerner driveren fra minnet';
STR3_24 = '/V           (Verbose) viser detaljert info om installasjonen';
