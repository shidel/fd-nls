STR3_1  = '("Taurus") Sterownik klawiatury drugiej generacji dla FreeDOS';
STR3_2  = 'Licencja: GNU GPL 2.0 lub późniejsza';
STR3_3  = '(/? pomoc, /V tryb szczegółowy)';
STR3_4  = 'KEYB nazwa[,[CP][,nazwaPliku] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'nazwa       Identyfikator fizycznego układu, np. GR lub PL';
STR3_6  = 'CP          Początkowa strona kodowa dla układu';
STR3_7  = 'nazwaPliku  Plik zawierający informacje o układzie';
STR3_8 = '/ID:nnn     Numeryczny identyfikator wariantu klawiatury';
STR3_9  = '/?          Pokazuje tę pomoc';
STR3_10 = '/9          Instaluje obsługę int9h (niekompatybilne z /E)';
STR3_11 = '/B          Beep off: wyłącza efekty dźwiękowe KEYB (głośnik)';
STR3_12 = '/CAPSLOCK=ON|OFF    Włącza lub wyłącza Caps Lock';
STR3_13 = '/Dx         Separator dziesiętny: x to znak, który ma być użyty';
STR3_14 = '/E          Określa, że klawiatura jest rozszerzona (Enhanced)';
STR3_15 = '            (niekompatybilne z /9)';
STR3_16 = '/I          (force Install) Instaluje keyb bezwarunkowo';
STR3_17 = '/L=m        (force subLayout) Wymusza użycie podukładu m';
STR3_18 = '/NOHI       Zapobiega ładowaniu danych KEYB do pamięci wysokiej';
STR3_19 = '/NOUMB      Zapobiega ładowaniu danych KEYB do pamięci UMB';
STR3_20 = '/NUMLOCK=ON|OFF    Włącza lub wyłącza Num Lock';
STR3_21 = '/S          (Safemode) zabrania ciągów... (patrz dokumentacja)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Włącza lub wyłącza Scroll Lock';
STR3_23 = '/U          (Uninstall) usuwa sterownik z pamięci';
STR3_24 = '/V          (Verbose) pokazuje szczegółowe informacje o instalacji';
STR3_25 = 'Więcej informacji: README.TXT';

