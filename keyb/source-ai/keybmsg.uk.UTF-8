STR3_1  = '("Taurus") Драйвер клавіатури другого покоління для FreeDOS';
STR3_2  = 'Ліцензія: GNU GPL 2.0 або новіша';
STR3_3  = '(/? допомога, /V докладно)';
STR3_4  = 'KEYB ім яРозкладки[,[CP][,файл] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'ім яРозкладки Фізичний ідентифікатор, як GR або UA';
STR3_6  = 'CP           Початкова codepage для розкладки';
STR3_7  = 'файл         Файл, що містить інформацію для розкладки';
STR3_8 = '/ID:nnn      Числовий ідентифікатор для варіанту клавіатури';
STR3_9  = '/?           Показує цю допомогу';
STR3_10 = '/9           Встановлює обробник int9h (несумісно з /E)';
STR3_11 = '/B           Beep off: вимкнути звукові ефекти (динамік)';
STR3_12 = '/CAPSLOCK=ON|OFF    Вмикає або вимикає Caps Lock';
STR3_13 = '/Dx          Десятковий роздільник: x - символ, що використовується';
STR3_14 = '/E           Вказує на розширену клавіатуру (Enhanced)';
STR3_15 = '             (несумісно з /9)';
STR3_16 = '/I           (force Install) Встановити keyb безумовно';
STR3_17 = '/L=m         (force subLayout) Використовувати підрозкладку m';
STR3_18 = '/NOHI        Забороняє KEYB завантажувати дані у високу пам ять';
STR3_19 = '/NOUMB       Забороняє KEYB завантажувати дані у верхню пам ять (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF    Вмикає або вимикає Num Lock';
STR3_21 = '/S           (Safemode) забороняє рядки... (див. документацію)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Вмикає або вимикає Scroll Lock';
STR3_23 = '/U           (Uninstall) вивантажує драйвер з пам яті';
STR3_24 = '/V           (Verbose) показує докладну інфо про встановлення';
STR3_25 = 'Більше інформації: README.TXT';

