STR3_1  = '("Taurus") Друга генерација драјвера тастатуре за FreeDOS';
STR3_2  = 'Лиценца: GNU GPL 2.0 или новија';
STR3_3  = '(/? помоћ, /V опширно)';
STR3_4  = 'KEYB имеРаспореда[,[CP][,датотека] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V]';
STR3_5  = 'имеРаспореда Физички идентификатор распореда, нпр. GR или SR';
STR3_6  = 'CP           Почетни codepage за распоред';
STR3_7  = 'датотека     Датотека која садржи информације за распоред';
STR3_8 = '/ID:nnn      Нумерички идентификатор за варијанту тастатуре';
STR3_9  = '/?           приказује ову помоћ';
STR3_10 = '/9           Инсталира int9h хендлер (некомпатибилно са /E)';
STR3_11 = '/B           Beep off: онемогући звучне ефекте (звучник)';
STR3_12 = '/CAPSLOCK=ON|OFF     Омогућава или онемогућава Caps Lock';
STR3_13 = '/Dx          Децимални сепаратор: x је карактер који се користи';
STR3_14 = '/E           Наводи да је тастатура проширена (Enhanced)';
STR3_15 = '             (некомпатибилно са /9)';
STR3_16 = '/I           (force Install) Инсталирај безусловно';
STR3_17 = '/L=m         (force subLayout) Присили коришћење подраспореда m';
STR3_18 = '/NOHI        Спречава KEYB да учита податке у високу меморију';
STR3_19 = '/NOUMB       Спречава KEYB да учита податке у горњу меморију (UMB)';
STR3_20 = '/NUMLOCK=ON|OFF      Омогућава или онемогућава Num Lock';
STR3_21 = '/S           (Safemode) забрањује стрингове... (види документацију)';
STR3_22 = '/SCROLLLOCK=ON|OFF   Омогућава или онемогућава Scroll Lock';
STR3_23 = '/U           (Uninstall) уклања драјвер из меморије';
STR3_24 = '/V           (Verbose) приказује детаљне информације о инсталацији';
STR3_25 = 'Више информација: README.TXT';

