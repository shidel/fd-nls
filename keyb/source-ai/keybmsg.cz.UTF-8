STR3_1  = '("Taurus") Druhá generace ovladače klávesnice pro FreeDOS';
STR3_2  = 'Licence: GNU GPL 2.0 nebo novější';
STR3_3  = '(/? nápověda, /V podrobně)';
STR3_4  = 'KEYB název[,[CP][,soubor] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'název       Fyzický identifikátor rozložení, např. GR nebo CZ';
STR3_6  = 'CP          Počáteční codepage pro rozložení';
STR3_7  = 'soubor      Soubor obsahující informace o rozložení';
STR3_8 = '/ID:nnn     Číselný identifikátor varianty klávesnice';
STR3_9  = '/?          Zobrazí tuto nápovědu';
STR3_10 = '/9          Instaluje obsluhu int9h (nekompatibilní s /E)';
STR3_11 = '/B          Beep off: vypne zvukové efekty KEYB (reproduktor)';
STR3_12 = '/CAPSLOCK=ON|OFF    Zapne nebo vypne Caps Lock';
STR3_13 = '/Dx         Desetinný oddělovač: x je znak, který se má použít';
STR3_14 = '/E          Určuje, že klávesnice je rozšířená (Enhanced)';
STR3_15 = '            (nekompatibilní s /9)';
STR3_16 = '/I          (force Install) Nainstaluje keyb bezpodmínečně';
STR3_17 = '/L=m        (force subLayout) Vynutí použití podrozložení m';
STR3_18 = '/NOHI       Zabrání KEYB v načítání dat do paměti High Memory';
STR3_19 = '/NOUMB      Zabrání KEYB v načítání dat do paměti Upper Memory';
STR3_20 = '/NUMLOCK=ON|OFF    Zapne nebo vypne Num Lock';
STR3_21 = '/S          (Safemode) zakáže řetězce... (viz dokumentace)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Zapne nebo vypne Scroll Lock';
STR3_23 = '/U          (Uninstall) uvolní ovladač z paměti';
STR3_24 = '/V          (Verbose) zobrazí podrobné informace o instalaci';
STR3_25 = 'Další informace: README.TXT';

