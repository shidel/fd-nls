STR3_1  = '("Taurus") Andra generationens tangentbordsdrivrutin för FreeDOS';
STR3_2  = 'Licens: GNU-GPL 2.0 eller senare';
STR3_3  = '(/? hjälp, /V utförlig)';
STR3_4  = 'KEYB LayoutNamn[,[CP][,filnamn] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'LayoutNamn En fysisk identifierare, såsom GR eller SV';
STR3_6  = 'CP          Den initiala codepage för layouten';
STR3_7  = 'filnamn     Fil som innehåller information för layouten';
STR3_8 = '/ID:nnn     Numerisk identifierare för en tangentbordsvariant';
STR3_9  = '/?          Visar denna hjälp';
STR3_10 = '/9          Installerar int9h-hanteraren (inkompatibel med /E)';
STR3_11 = '/B          Pip av: inaktivera KEYB-ljudeffekter (högtalare)';
STR3_12 = '/CAPSLOCK=ON|OFF    Aktiverar eller inaktiverar Caps Lock';
STR3_13 = '/Dx         Decimaltecken: x är tecknet som ska användas';
STR3_14 = '/E          Anger att tangentbordet är ett utökat tangentbord';
STR3_15 = '            (inkompatibel med /9)';
STR3_16 = '/I          (Tvinga install) Installera keyb villkorslöst';
STR3_17 = '/L=m        (Tvinga sublayout) Tvinga användning av sublayout m';
STR3_18 = '/NOHI       Förhindrar KEYB att ladda data i högt minne';
STR3_19 = '/NOUMB      Förhindrar KEYB att ladda data i upper memory';
STR3_20 = '/NUMLOCK=ON|OFF    Aktiverar eller inaktiverar Num Lock';
STR3_21 = '/S          (Safemode) förbjuder strängar... (se dokumentation)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Aktiverar eller inaktiverar Scroll Lock';
