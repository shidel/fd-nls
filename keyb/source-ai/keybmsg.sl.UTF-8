STR3_1  = '("Taurus") Druga generacija gonilnika tipkovnice za FreeDOS';
STR3_2  = 'Licenca: GNU GPL 2.0 ali novejša';
STR3_3  = '(/? pomoč, /V podrobno)';
STR3_4  = 'KEYB ime[,[CP][,datoteka] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'ime         Fizični identifikator razporeda, npr. GR ali SL';
STR3_6  = 'CP           Začetni codepage za razpored';
STR3_7  = 'datoteka     Datoteka z informacijami o razporedu';
STR3_8 = '/ID:nnn      Numerični identifikator različice tipkovnice';
STR3_9  = '/?           Prikaže to pomoč';
STR3_10 = '/9           Namesti rokovalec int9h (nezdružljivo z /E)';
STR3_11 = '/B           Brez piska: onemogoči zvočne učinke KEYB (zvočnik)';
STR3_12 = '/CAPSLOCK=ON|OFF    Omogoči ali onemogoči Caps Lock';
STR3_13 = '/Dx          Decimalno ločilo: x je znak, ki se uporabi';
STR3_14 = '/E           Navede, da je tipkovnica razširjena (Enhanced)';
STR3_15 = '             (nezdružljivo z /9)';
STR3_16 = '/I           (force Install) Brezpogojna namestitev';
STR3_17 = '/L=m         (force subLayout) Prisili uporabo podrazporeda m';
STR3_18 = '/NOHI        Prepreči KEYB-u nalaganje podatkov v visoki pomnilnik';
STR3_19 = '/NOUMB       Prepreči KEYB-u nalaganje podatkov v zgornji pomnilnik';
STR3_20 = '/NUMLOCK=ON|OFF    Omogoči ali onemogoči Num Lock';
STR3_21 = '/S           (Safemode) prepove nize... (glej dokumentacijo)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Omogoči ali onemogoči Scroll Lock';
STR3_23 = '/U           (Uninstall) odstrani gonilnik iz pomnilnika';
STR3_24 = '/V           (Verbose) prikaže podrobne informacije o namestitvi';
STR3_25 = 'Več informacij: README.TXT';

