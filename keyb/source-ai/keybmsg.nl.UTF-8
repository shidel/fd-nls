STR3_1  = '("Taurus") Tweede generatie toetsenbordstuurprogramma voor FreeDOS';
STR3_2  = 'Licentie: GNU-GPL 2.0 of later';
STR3_3  = '(/? help, /V uitgebreid)';
STR3_4  = 'KEYB Indeling[,[CP][,bestandsnaam] [/ID:nnn] [/E] [/9] [/I] [/Dx] [/V] [/L=m]';
STR3_5  = 'Indeling    Een fysieke identificatie, zoals GR of NL';
STR3_6  = 'CP          De initiële codepage voor de indeling';
STR3_7  = 'bestandsnaam Bestandsnaam met informatie voor de indeling';
STR3_8 = '/ID:nnn     Numerieke identificatie voor een toetsenbordvariant';
STR3_9  = '/?          Toont deze hulp';
STR3_10 = '/9          Installeert de int9h handler (incompatibel met /E)';
STR3_11 = '/B          Beep uit: schakel KEYB-geluidseffecten uit (luidspreker)';
STR3_12 = '/CAPSLOCK=ON|OFF    Schakelt Caps Lock in of uit';
STR3_13 = '/Dx         Decimaalscheidingsteken: x is het te gebruiken teken';
STR3_14 = '/E          Geeft aan dat het een uitgebreid toetsenbord is';
STR3_15 = '            (incompatibel met /9)';
STR3_16 = '/I          (Forceer install) Installeer keyb onvoorwaardelijk';
STR3_17 = '/L=m        (Forceer subIndeling) Forceer gebruik van subindeling m';
STR3_18 = '/NOHI       Voorkomt dat KEYB gegevens in hoog geheugen laadt';
STR3_19 = '/NOUMB      Voorkomt dat KEYB gegevens in upper memory laadt';
STR3_20 = '/NUMLOCK=ON|OFF    Schakelt Num Lock in of uit';
STR3_21 = '/S          (Safemode) verbiedt strings... (zie documentatie)';
STR3_22 = '/SCROLLLOCK=ON|OFF    Schakelt Scroll Lock in of uit';
STR3_23 = '/U          (Uninstall) verwijdert het stuurprogramma uit geheugen';
STR3_24 = '/V          (Verbose) toont uitgebreide informatie over de install';
