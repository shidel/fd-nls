INTRO=
ERROR.NOBINS=/fLightRed Impossibile trovare i driver di rete. /fGrey /p
ERROR.HARDWARE=/fLightRed Il networking su hardware fisico non è supportato in questo momento. /fGrey /p
ERROR.DOSBOX=/fLightRed Il networking su DOSBox non è supportato in questo momento. /fGrey /p
FOUND.QEMU=/fLightGreen Rilevata rete QEMU. /fGrey /p
FOUND.VIRTUALBOX=/fLightGreen Rilevata rete VirtualBOX. /fGrey /p
NOTES.VIRTUALBOX=/p /fLightGreen Nota: potrebbe essere necessario regolare le impostazioni di rete di VirtualBOX. /fGrey /p
FOUND.VMWARE=/fLightGreen Rilevata rete VMware. /fGrey /p
NOTES.VMWARE=/p /fLightGreen Nota: potrebbe essere necessario configurare VMware in modalità /fYellow Bridged /fLightGreen. /fGrey /p
FOUND.STAGING=/fLightGreen Rilevata rete DOSBox Staging. /fGrey /p
NOTES.STAGING=/p /fLightGreen Nota: potrebbe essere necessario regolare le impostazioni di configurazione di DOSBox. /fGrey /p
NO.NETWORK=/fLightRed 'La rete non è raggiungibile/disponibile.' /fGray
USER.FDNETPD=/fLightGreen Utilizzo delle impostazioni personalizzate del packet driver in /fWhite FDNETPD.BAT /fGrey /p
USER.DRIVER=/fLightGreen Utilizzo del packet driver personalizzato /fWhite %1 /fGrey /p
NO.HELP=Impossibile trovare i file di aiuto.
NO.DRIVER=/fLightRed Impossibile trovare il driver di rete richiesto %1. /fGrey /p
