1.0:Tt
1.1:\040:\040
1.2:O.K.?\040
1.3:Błąd wprowadzania
1.4:%s: wczytano %lu linię\n
1.5:%s: wczytane linie: %lu\n
1.6:%s: zapisano %lu linię\n
1.7:%s: zapisane linie: %lu\n
1.8:%lu:%c%s\n
1.9:Naciśnij <Enter>, aby kontynuować
1.10:%lu:\040
1.11:Nie znaleziono
1.12:%lu: %s\n
1.13:\nPodpolecenia programu edlin:\n
1.14:#                 edytuj jedną linię    [#],[#],#m        przenieś
1.15:a                 dopisz                [#][,#]p          strona
1.16:[#],[#],#,[#]c    kopiuj                q                 zakończ
1.17:[#][,#]d          usuń                  [#][,#][?]r$,$    zamień
1.18:e<>               zapisz i zakończ      [#][,#][?]s$      szukaj
1.19:[#]i              wstaw                 [#]t<>            wstaw plik
1.20:[#][,#]l          wyświetl              [#]w<>            zapisz\n
1.21:gdzie $ to ciąg znaków, <> to nazwa pliku,
1.22:# to liczba (może być też . = bieżąca linia, $ = ostatnia linia
1.23:albo liczba + lub - inna liczba).\n
