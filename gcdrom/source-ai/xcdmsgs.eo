XCMsg	db	CR,LF,'GCDROM '
	db	VER		;XCDROM.ASM disponigas version kaj daton!
	db	CR,LF,'$'
DvrMsg	db	'Pelilo-nomo estas "'
DvrMsg1	db	'        "$'
CtlrMsg	db	'SATA-indiõena IDE-regilo Üe I-O-adreso '
CtlrAdr0 db	'xxxxh/'
CtlrAdr	db	'xxxxh, ico I.D. '
CtlrID	db	'xxxxxxxxh.',CR,LF,'$'
VEMsg	db	'.',CR,LF,'VDS-pravalorigeraro$'
LEMsg	db	'.',CR,LF,'/L nevalida$'
SyEMsg	db	'.',CR,LF,'ERARO '
SyMsg	db	'Sinkronigado de I-O kun XDMA-pelilo$'
PRMsg	db	'Neniu 80386+ CPU'
Suffix	db	'; GCDROM ne «argita!',CR,LF,'$'
UnitMsg	db	'Unuo '
UMsgNo	db	'0:  $'
TOMsg	db	' eltempiõo de aparat-elekto$'
IDMsg	db	' eraro de Identify Device$'
NCMsg	db	' ne estas ATAPI-KD-ROM$'
NDMsg	db	'Neniu KD-ROM drive por uzi$'
PriMsg	db	'Primara-$'
SecMsg	db	'Sekundara-$'
MstMsg	db	'mastro$'
SlvMsg	db	'sklavo$'
ComMsg	db	', $'
UDMsg	db	', ATA-'
UDMode	db	'   $'
PIOMsg	db	', PIO-reõimo$'
CRMsg	db	'.',CR,LF,'$'
