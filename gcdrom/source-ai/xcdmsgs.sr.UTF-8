; Language: Serbian (sr)
; File ending: sr
; Codepage: 855
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; ПАЖЊА: Коришћење ћирилице у порукама драјвера дозвољено је само
; ако је учитан одговарајући екрански фонт.

;
; XCDMSGS.SR -- "Српске" поруке иницијализације XCDROM-а.
; Написао Џек Р. Елис, 8-феб-2006.
;
; Корисници који желе да "интернационализују" XCDROM треба да измене само
; ОВУ датотеку! Новој датотеци се може дати име по жељи, на пример
; XCDMSGS.FR (француски), XCDMSGS.SR (српски) итд. Жељена датотека се мора
; копирати у XCDMSGS.TXT, а затим се жељени драјвер може поново асемблирати
; помоћу било ког NASM асемблера (доступног на SourceForge), користећи
; следећу командну линију:
;
;     NASM -o XCDROM.SYS -l XCDROM.LST -d language XCDROM.ASM
;
; Имајте на уму да услов -d language доводи до тога да асемблер чита
; XCDMSGS.TXT уместо подразумеване XCDMSGS.ENG датотеke.
;
; Следећа ПРАВИЛА се примењују на модификацију порука приказаних испод:
;
;  A) Све ОЗНАКЕ порука ("XCMsg" итд.) морају се појавити као што је приказано.
;
;  B) Сви CR, LF и завршни $ бајтови морају се појавити као што је приказано.
;     Само ТЕКСТУАЛНИ бајтови поруке (слова, бројеви и знаци интерпункције)
;     су отворени за промену.
;
;  C) Мора бити најмање 42 знака од почетка "XCMsg" до почетка "Suffix",
;     јер драјвер чита 40 бајтова података у ову област (име сваког уређаја)
;     и додаје завршни $ пре приказивања коначног имена CD-ROM уређаја.
;
;  D) Друге поруке које су МОДИФИКОВАНЕ иницијализацијом драјвера су:
;
;	1) 8 бајтова имена драјвера код "DvrMsg1".
;	2) 4 бајта адресе контролера код "CtlrAdr".
;	3) 8 бајтова I.D. контролера код "CtlrID".
;	4) Бајт броја јединице уређаја код "UMsgNo".
;	5) 4 бајта UltraDMA режима код "UDMode".
;
; За пример "интернационализације", упоредите датотеку XDMAMSGS.ENG са
; датотеком XDMAMSGS.NL, које су обе укључене у тренутни пакет XDMA драјвера.
; XDMAMSGS.NL преводи све XDMA поруке иницијализације на холандски језик.
; Ову датотеку је написао Бернд Блау, који је предложио да XDMA, а сада и
; XCDROM, постану "интернационални" драјвери.
;
;
XCMsg	db	CR,LF,'GCDROM '
	db	VER		;XCDROM.ASM обезбеђује верзију и датум!
	db	CR,LF,'$'
DvrMsg	db	'Назив драјвера је "'
DvrMsg1	db	'        "$'
CtlrMsg	db	'SATA Native IDE контролер на I-O адреси '
CtlrAdr0 db	'xxxxh/'
CtlrAdr	db	'xxxxh, Chip I.D. '
CtlrID	db	'xxxxxxxxh.',CR,LF,'$'
VEMsg	db	'.',CR,LF,'Грешка иницијализације VDS-а$'
LEMsg	db	'.',CR,LF,'/L неважеће$'
SyEMsg	db	'.',CR,LF,'ГРЕШКА '
SyMsg	db	'Синхронизација I-O са XDMA драјвером$'
PRMsg	db	'Нема 80386+ CPU-а'
Suffix	db	'; GCDROM није учитан!',CR,LF,'$'
UnitMsg	db	'Јединица '
UMsgNo	db	'0:  $'
TOMsg	db	' истекло време за избор уређаја$'
IDMsg	db	' Identify Device грешка$'
NCMsg	db	' није ATAPI CD-ROM$'
NDMsg	db	'Нема CD-ROM drive-а за коришћење$'
PriMsg	db	'Примарни-$'
SecMsg	db	'Секундарни-$'
MstMsg	db	'master$'
SlvMsg	db	'slave$'
ComMsg	db	', $'
UDMsg	db	', ATA-'
UDMode	db	'   $'
PIOMsg	db	', PIO режим$'
CRMsg	db	'.',CR,LF,'$'
