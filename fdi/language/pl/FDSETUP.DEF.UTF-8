# Status: reviewed by Piotr Okrutny in Weblate, 2026-10 (human review, AI-assisted draft).
# LANG_AUTHOR is unused at present, but you should set it to your name.
LANG_AUTHOR=Piotr Okrutny
LANG_NAME=Polish

# FDICLS - Title
TITLE=/s- /f %1 "%2 " /f %3 "%4" /f %1 " - Instalator"

# STAGE300 - Initial welcome screen message
LANG_ASK="Wybierz język:"
$LANG_SETLIST$
LANG_EN=Angielski
LANG_ES=Hiszpański
LANG_FR=Francuski
LANG_DE=Niemiecki
LANG_EO=Esperanto
LANG_NL=Niderlandzki
LANG_PL=Polski
LANG_TR=Turecki
LANG_RU=Rosyjski
LANG_SV=Szwedzki

HELLO_FRAME=/w70 /h15 /c
HELLO_OPTS=/w43 /h5 /c
HELLO=/s- "Witamy w programie instalacyjnym systemu " /f %1 "%2" /f %3 .
HELLO_ADV=/s- "Witamy w zaawansowanym instalatorze systemu " /f %1 "%2" /f %3 .
HELLO_WARN.1=/f%1 "%2" /f%3 "to kompletny system operacyjny. Jeśli go zainstalujesz" /p "na tym komputerze, możesz nadpisać obecny system operacyjny" /p "(na przykład Windows)."
HELLO_WARN.2=/p "Jeśli nie tego chcesz, przerwij teraz."
HELLO_WARN.3=
HELLO_WARN.4=
HELLO_WARN.5=

# RELDATE=/r56 /c32 "Release date %1" /e

PROCEED?=/p/p "Czy chcesz kontynuować?"
CONTINUE="  Tak - Kontynuuj instalację"
EXIT="  Nie - Wróć do DOS-u"

# STAGE400 - Partition screen specific
NOPART_FRAME=/w60 /h10 /c
NOPART_OPTS=/w40 /h5 /c
NOPART=/s- "Dysk " /f  %1 %2 /f %3 " nie wygląda na podzielony na partycje."
PART?="Czy chcesz podzielić dysk na partycje?"
PART_YES="  Tak - Podziel dysk %1 na partycje"
# EXIT

# STAGE400 - After partitioned specific
PARTED_FRAME=/w72 /h11 /c
PARTED_OPTS=/w40 /h5 /c
PARTED="Nowe partycje zaczną działać po ponownym uruchomieniu komputera."
REBOOT?="Czy chcesz teraz ponownie uruchomić komputer?"
REBOOT_YES="  Tak - Uruchom ponownie teraz"
# EXIT
REBOOT="Komputer powinien teraz uruchomić się ponownie."
PARTING_FRAME=/w46 /h5 /c
PARTING="Tworzenie partycji na dysku twardym..."

# STAGE500 - Formating specific
NOFORMAT_FRAME=/w55 /h10 /c
NOFORMAT_OPTS=/w48 /h5 /c
NOFORMATADV_FRAME=/w60 /h11 /c
NOFORMATADV_OPTS=/w52 /h6 /c
NOFORMAT=/s-  "Dysk " /f %1 %2 /f %3 " nie wygląda na sformatowany."
FORMAT?="Czy chcesz sformatować dysk?"
FORMAT_YES="  Tak - Wyczyść i sformatuj dysk %1"
FORMATADV_QUICK="  Tak - Szybko wyczyść i sformatuj dysk %1"
FORMATADV_SLOW="  Tak - Dokładnie wyczyść i sformatuj dysk %1"
# EXIT
FORMATTING=/s- /fGray "Formatowanie dysku " /fWhite %1 /fGray ...
PAUSE=/fLightGreen " Naciśnij dowolny klawisz... " /e

# STAGE600 - Install preparation
GATHERING_FRAME=/w68 /h5 /c
GATHERING="Zbieranie informacji potrzebnych do instalacji..."

# STAGE800 - Installing
INSTALL_FRAME=/w62 /h10 /c
INSTALL_OPTS=/w48 /h5 /c
INSTALL=/s- "Wszystko gotowe do instalacji systemu " /f %1 "%2" /f %3 .
INSTALL?="Czy chcesz teraz zainstalować system?"
INSTALL_YES="  Tak - Zainstaluj %1"
# EXIT
PREPARING_FRAME=/w42 /h5 /c
PREPARING="Przygotowywanie instalacji..."

# STAGE900 - All Done reboot?
COMPLETE_FRAME=/w60 /h10 /c
COMPLETE_OPTS=/w40 /h5 /c
COMPLETE=/s- "Instalacja systemu " /f %1 "%2" /f %3 " została zakończona."
# REBOOT?, REBOOT, EXIT

# FDSETUP - Installer Aborted
ABORTED=/fWhite /bRed " Instalacja systemu %1 została przerwana." /e /fGray

# FDSETUP - Missing Stage Error
STAGE_ERROR=/s- "Nie można wykonać etapu instalacji %1." /p "Instalator może być uszkodzony." /p "Pobierz go ponownie albo wybierz inną metodę instalacji."

# FDICTRLC - Control-C specific
CTRLC_FRAME=/w60 /h12 /c
CTRLC_OPTS=/w44 /h7 /c
CTRLC=/s- "Naciśnięto " /f %1 "CTRL-C" /f %2 .
CTRLC?="Czy na pewno przerwać instalację?"
CTRLCY="  Tak - Wróć do DOS-u"
CTRLCN="  Nie - Kontynuuj instalację"
CTRLCA="  Nie - Przełącz na tryb zaawansowany"
CTRLCB="  Nie - Przełącz na tryb podstawowy"

# FDIFAIL - Installation failure error message box
FAIL_FRAME=/w62 /h11 /c
FAIL_OPTS=/w40 /h5 /c
FAILADV_FRAME=/w62 /h13 /c
FAILADV_OPTS=/w40 /h7 /c
FAILH="Może pomóc ponowne uruchomienie komputera."
FAIL?="Czy chcesz teraz ponownie uruchomić komputer?"
FAILY="  Tak - Uruchom ponownie"
FAILN="  Nie - Wróć do DOS-u"
FAILI="  Nie - Ignoruj (niezalecane)"
FAILR="Komputer zostanie teraz ponownie uruchomiony."

# FDNOTICE - Already installed notice.
NOTICE.1=/r5/c32 /fGreen %1 /fCyan %2 /fGray "jest już zainstalowany."
NOTICE.2=/r5/c32 "Instalator możesz uruchomić ręcznie poleceniem" "'" /s- /fCyan SETUP.BAT /fGray "'"

# Failure messages
ERROR_BACKZIP="Tworzenie archiwum kopii zapasowej %1."
ERROR_BACKUP="Błąd podczas tworzenia kopii zapasowej."
ERROR_MKDOS="Nie można utworzyć katalogu '%1'."
ERROR_PACKAGE="Nie można zainstalować pakietu '%1'."
ERROR_SOURCE="Nie można zainstalować źródeł pakietu '%1'."
ERROR_READC="Problem z odczytem dysku C:."
ERROR_SHELL="Instalacja w bieżącej powłoce nie jest obsługiwana."
ERROR_MEDIA="Nie można odnaleźć pakietów instalacyjnych."
ERROR_REMOS="Problem z usuwaniem starych plików systemowych."
ERROR_XSYS="Błąd podczas przenoszenia plików systemowych na dysk %1."
ERROR_CONFIG="Problem z kopiowaniem nowych plików konfiguracyjnych."

REBOOT_PAUSE=/f%1/c32 "Wyjmij nośnik instalacyjny i naciśnij dowolny klawisz, aby uruchomić" /p/e/c32 "komputer ponownie. Aby wyjść, naciśnij" /f%2 CTRL+C /f%1 /s- .
REBOOT_FRAME=/w70 /h8 /c
REBOOT_WARN.1="Pamiętaj, że nie wymuszono aktualizacji kodu rozruchowego w MBR." /p
REBOOT_WARN.2="Jeśli" /s- /c32 /f%1 "%2" /f%3 /s+ "się nie uruchomi, uruchom ponownie komputer" /p
REBOOT_WARN.3="z nośnika instalacyjnego i wykonaj" "'" /s- /f%1 MBRZAP.BAT /f%3 "', aby" /s+ "zapisać" /p
REBOOT_WARN.4="w MBR nowy kod rozruchowy."
REBOOT_WARN.5=

# AUTOEXEC.BAT messages
AUTO_DONE=Zakończono przetwarzanie plików startowych /fCyan %1 /a7 i /fCyan %2 /a7
AUTO_HELP=Wpisz /fWhite %1 /fGray /s- , /s+ aby uzyskać pomoc dotyczącą poleceń i nawigacji.
AUTO_WELCOME=Witaj w systemie operacyjnym /fGreen %1 /fCyan %2 /fGray ( /s- /fYellow "%3" /fGray )

# FDASK000 - Select Keyboard Layout

# FDASK100 - Reserved
# PL: the order here must match KEYBOARD.LST (Polish layout is entry 1, the default).
KBS_FRAME=/w55 /h17 /c
KBS_OPTS=/w38 /h13 /c
KBS?=Wybierz układ klawiatury.
KBO.1=" Polski (programisty)" /p " Angielski (USA)" /p " Angielski (Wielka Brytania)" /p " Niemiecki" /p " Francuski" /p
KBO.2=" Hiszpański" /p " Niderlandzki"
KBM=/p/p " Więcej układów klawiatury..."
KBL=" Mniej układów klawiatury..."
KBA_FRAME=/w58 /h13 /c

# FDASK200 - Backup old OS
BACKUP_FRAME=/w68 /h10 /c
BACKUP_OPTS=/w52 /h5 /c
BACKUPADV_FRAME=/w68 /h11 /c
BACKUPADV_OPTS=/w52 /h5 /c
BACKUP="Wykryto poprzedni system operacyjny na dysku" /f %1 %2 /f %3 /s- .
BACKUP?="Czy przed instalacją utworzyć kopię zapasową starych plików?"
BACKUPY="  Tak - Najpierw utwórz kopię zapasową"
BACKUPZ="  Tak - Utwórz kopię zapasową jako archiwum ZIP"
BACKUPN="  Nie - Instaluj bez kopii zapasowej"

# FSASK100 - Advanced mode
TARGET_FRAME=/w50 /h7 /c
TARGET?="Czy zmienić katalog docelowy instalacji?"
TARGET_ASK=/f %1 /b %2 /d %3 %4

# FDASK300 - Advanced mode Replace system files
REPLACE_FRAME=/w55 /h8 /c
REPLACE_OPTS=/w40 /h5 /c
REPLACE?="Czy zastąpić systemowe pliki konfiguracyjne?"
REPLACEY="  Tak - Skopiuj nowe pliki domyślne"
REPLACEN="  Nie - Zachowaj stare pliki"

# FDASK400 - Advanced mode delete old OS files
DELETE_FRAME=/w55 /h8 /c
DELETE_OPTS=/w42 /h5 /c
DELETE?="Czy usunąć wszystkie stare pliki z" /f %1 %2 /f %3 /s- ?
DELETEY="  Tak - Zacznij od zera"
DELETEN="  Nie - Pozostaw istniejące pliki"

# FDASK500 - Advanced mode transfer system files
XFER_FRAME=/w55 /h8 /c
XFER_OPTS=/w46 /h5 /c
XFER?="Czy przenieść pliki systemowe na dysk" /f %1 %2 /f %3 /s- ?
XFERY="  Tak - Przenieś pliki systemowe"
XFERN="  Nie - Nie przenoś plików systemowych"

OBSS_FRAME=/w58 /h8 /c
OBSS_OPTS=/w34 /h5 /c
OBSS?="Czy wymusić nowy kod rozruchowy na dysku" /f %1 %2 /f %3 (%4:%5)?
OBSSY="  Tak - Nadpisz MBR"
OBSSN="  Nie - Nie wymuszaj nowego MBR"

# FDASK600 - Package group selection.
PAC_FRAME=/w70 /h11 /c
PAC_OPTS=/w58 /h8 /c
PAC_FRAME_B=/w70 /h8 /c
PAC_OPTS_B=/w54 /h5 /c
PAC_FRAME_D=/w70 /h14 /c
PAC_OPTS_D=/w58 /h11 /c
PAC_FRAME_BD=/w70 /h11 /c
PAC_OPTS_BD=/w54 /h8 /c
PACS?="Które pakiety systemu" /f %1 %2 /f %3 "chcesz zainstalować?"
PACBO="  Podstawowy system DOS"
PACBS="  Podstawowy system DOS ze źródłami"
PACAO="  Pełna instalacja z aplikacjami i grami"
PACAS="  Pełna instalacja ze źródłami"
PACDO_ADV="  Wybrane pakiety binarne"
PACDS_ADV="  Wybrane pakiety ze źródłami"

# FDASK700 - Reserved

# FDASK800 - Reserved

# Debug mode pause
PRESSKEY="Naciśnij dowolny klawisz..."

# Backing up old OS
IBACKUP_FRAME=/w60 /h7 /c
IBACKUP="Tworzenie kopii zapasowej"
ITARGET=/s- "'" /f %1 "%2" /f %3 "'"
IBACKUP_DONE=/f %1 "Kopia zapasowa została utworzona."

# Old Package removal
IRMPACK_FRAME=/w60 /h7 /c
IRMPACKS="Usuwanie starych pakietów powodujących konflikty."
IRMPACKN=/s- "Usuwanie starego pakietu '" /f %1 %2 /f %3 "'."

# Remove old OS files
IRMOS_FRAME=/w60 /h5 /c
IRMOS=/s- "Usuwanie starych plików z '" /f %1 %2 /f %3 "'."
IRMOS_DONE="Stare pliki systemu operacyjnego zostały usunięte."

# Remove old config files
ICLEAN_FRAME=/w50 /h5 /c
ICLEAN="Usuwanie starych plików konfiguracyjnych."
ICLEAN_DONE="Stare pliki konfiguracyjne zostały usunięte."

# Transfer system files
IXSYS_FRAME=/w62 /h5 /c
IXSYS= /s- "Przenoszenie plików rozruchowych systemu na dysk " /f %1 %2 /f %3 .
IXSYS_DONE="Pliki systemowe zostały przeniesione."

# Package installation.
IPAC_FRAME=/w60 /h7 /c
IPACBM="Instalowanie pakietów oprogramowania."
IPACBI=/s- "Instalowanie pakietu '" /f %1 %2 /f %3 "'"
IPACSM="Instalowanie źródeł."
IPACSI= /s- "Instalowanie źródeł pakietu '" /f %1 %2 /f %3 "'"
IPACDONE_FRAME=/w54 /h5 /c
IPACDONE="Pakiety oprogramowania zostały zainstalowane."

# Config file installation
ICONFIGS_FRAME=/w54 /h5 /c
ICONFIGS="Instalowanie nowych plików konfiguracyjnych."
ICONFIGS_DONE="Nowe pliki konfiguracyjne zostały zainstalowane."

# Virtual machine not supported with this install media.
NORUN.1="Niestety, ta metoda instalacji nie jest obsługiwana na tej"
NORUN.2=/p "platformie sprzętowej. Wybierz inną metodę instalacji."
