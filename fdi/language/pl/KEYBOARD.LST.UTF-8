; Polish: entry 1 is the Polish layout, so it is the default for LANG=PL
; (FDASK000.BAT selects entry 1 for languages without their own default).
; Entries 1-7 must match KBO.1/KBO.2 in FDSETUP.DEF.
TITLE.1=Polski (programisty)
VALUE.1=mkeyb PL
TITLE.2=Angielski (USA)
VALUE.2=
TITLE.3=Angielski (Wielka Brytania)
VALUE.3=mkeyb UK
TITLE.4=Niemiecki
VALUE.4=mkeyb GR
TITLE.5=Francuski
VALUE.5=mkeyb FR
TITLE.6=Hiszpański
VALUE.6=mkeyb SP
TITLE.7=Niderlandzki
VALUE.7=mkeyb NE
TITLE.8=Turecki
VALUE.8=keyb TR,857,%DOSDIR%\BIN\KEYBRD2.SYS
TITLE.9=Rosyjski
VALUE.9=keyb RU,,%DOSDIR%\BIN\KEYBRD2.SYS
