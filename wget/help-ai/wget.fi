GNU Wget 1.11.1, ei-interaktiivinen verkkolataaja.
K„ytt”: wget.exe [OPTION]... [URL]...

Pitkien valitsimien pakolliset argumentit ovat pakollisia my”s lyhyille.

K„ynnistys:
  -V,  --version                    n„yt„ Wgetin versio ja poistu.
  -h,  --help                       n„yt„ t„m„ ohje.
  -b,  --background                 siirry taustalle k„ynnistyksen j„lkeen.
  -e,  --execute=COMMAND            suorita `.wgetrc'-tyylinen komento.

Lokaus ja sy”tetiedosto:
  -o,  --output-file=FILE           kirjaa viestit tiedostoon FILE.
  -a,  --append-output=FILE         lis„„ viestit tiedostoon FILE.
  -d,  --debug                      tulosta paljon vianm„„ritystietoja.
       --wdebug                     tulosta Watt-32-vianm„„ritystuloste.
  -q,  --quiet                      hiljainen (ei tulostusta).
  -v,  --verbose                    ole monisanainen (t„m„ on oletus).
  -nv, --no-verbose                 poista monisanaisuus, olematta
                                    hiljainen.
  -i,  --input-file=FILE            lataa tiedostosta FILE l”ytyv„t URL:t.
  -F,  --force-html                 k„sittele sy”tetiedosto HTML:n„.
  -B,  --base=URL                   lis„„ URL relatiivisiin linkkeihin.

Lataus:
  -t,  --tries=NUMBER               aseta yritykset arvoon NUMBER
                                    (0 on rajaton).
       --retry-connrefused          yrit„ uudelleen, vaikka yhteys
                                    torjutaan.
  -O,  --output-document=FILE       kirjoita dokumentit tiedostoon FILE.
  -nc, --no-clobber                 ohita lataukset, jotka
                                    ylikirjoittaisivat olemassa olevia
                                    tiedostoja.
  -c,  --continue                   jatka osittain ladatun tiedoston
                                    latausta.
       --progress=TYPE              valitse edistymispalkin tyyppi.
  -N,  --timestamping               „l„ lataa uudelleen, ellei uudempi
                                    kuin paikallinen.
  -S,  --server-response            tulosta palvelimen vastaus.
       --spider                     „l„ lataa mit„„n.
  -T,  --timeout=SECONDS            aseta kaikki aikakatkaisut arvoon
                                    SECONDS.
       --dns-timeout=SECS           aseta DNS-aikakatkaisu arvoon SECS.
       --connect-timeout=SECS       aseta yhteysaikakatkaisu arvoon SECS.
       --read-timeout=SECS          aseta lukuaikakatkaisu arvoon SECS.
  -w,  --wait=SECONDS               odota SECONDS latausten v„lill„.
       --waitretry=SECONDS          odota 1..SECONDS yritysten v„lill„.
       --random-wait                odota 0...2*WAIT sek latausten
                                    v„lill„.
       --no-proxy                   ota v„lityspalvelin nimenomaisesti
                                    pois.
  -Q,  --quota=NUMBER               aseta latauskiinti” arvoon NUMBER.
       --bind-address=ADDRESS       sido paikalliseen ADDRESSiin
                                    (nimi/IP).
       --limit-rate=RATE            rajoita latausnopeus arvoon RATE.
       --no-dns-cache               poista DNS-hakujen v„limuisti
                                    k„yt”st„.
       --restrict-file-names=OS     rajoita tiedostonimien merkit OS:lle.
       --ignore-case                ohita kirjainkoko etsitt„ess„.
  -4,  --inet4-only                 yhdist„ vain IPv4-osoitteisiin.
  -6,  --inet6-only                 yhdist„ vain IPv6-osoitteisiin.
       --prefer-family=FAMILY       yhdist„ ensin t„h„n perheeseen,
                                    joko IPv6, IPv4 tai none.
       --user=USER                  aseta FTP- ja HTTP-k„ytt„j„ksi USER.
       --password=PASS              aseta FTP- ja HTTP-salasanaksi PASS.

Hakemistot:
  -nd, --no-directories             „l„ luo hakemistoja.
  -x,  --force-directories          pakota hakemistojen luonti.
  -nH, --no-host-directories        „l„ luo is„nt„hakemistoja.
       --protocol-directories       k„yt„ protokollan nime„ hakemistoissa.
  -P,  --directory-prefix=PREFIX    tallenna tiedostot t„nne: PREFIX/...
       --cut-dirs=NUMBER            ohita NUMBER
                                    et„hakemistokomponenttia.

HTTP-valitsimet:
       --http-user=USER             aseta HTTP-k„ytt„j„ksi USER.
       --http-password=PASS         aseta HTTP-salasanaksi PASS.
       --no-cache                   „l„ salli palvelimen v„limuistidataa.
  -E,  --html-extension             tallenna HTML-dokumentit
                                    `.html'-p„„tteell„.
       --ignore-length              ohita `Content-Length'-otsakekentt„.
       --header=STRING              lis„„ STRING otsakkeiden joukkoon.
       --max-redirect               sivun sallitut uudelleenohjaukset
                                    (maks.).
       --proxy-user=USER            aseta USER v„lityspalvelimen
                                    k„ytt„j„ksi.
       --proxy-password=PASS        aseta PASS v„lityspalvelimen
                                    salasanaksi.
       --referer=URL                sis„llyt„ `Referer: URL'-otsake
                                    pyynt””n.
       --save-headers               tallenna HTTP-otsakkeet tiedostoon.
  -U,  --user-agent=AGENT           tunnistaudu nimell„ AGENT (ei Wget).
       --no-http-keep-alive         poista HTTP keep-alive k„yt”st„.
       --no-cookies                 „l„ k„yt„ ev„steit„.
       --load-cookies=FILE          lataa ev„steet tiedostosta FILE ennen.
       --save-cookies=FILE          tallenna ev„steet tiedostoon FILE.
       --keep-session-cookies       lataa ja tallenna istuntoev„steet.
       --post-data=STRING           k„yt„ POST-metodia; l„het„ STRING.
       --post-file=FILE             k„yt„ POST-metodia; l„het„ FILE:n
                                    sis„lt”.
       --content-disposition        kunnioita Content-Disposition
                                    -otsaketta tiedostonimi„ valittaessa.
       --auth-no-challenge          L„het„ Basic HTTP -todennus
                                    odottamatta palvelimen haastetta.

HTTPS (SSL/TLS) -valitsimet:
       --secure-protocol=PR         valitse turvallinen protokolla:
                                    auto, SSLv2, SSLv3 tai TLSv1.
       --no-check-certificate       „l„ vahvista palvelimen varmennetta.
       --certificate=FILE           asiakasvarmentetiedosto.
       --certificate-type=TYPE      asiakasvarmenteen tyyppi, PEM tai DER.
       --private-key=FILE           yksityisen avaimen tiedosto.
       --private-key-type=TYPE      yksityisen avaimen tyyppi, PEM/DER.
       --ca-certificate=FILE        tiedosto, jossa on CA-nippu.
       --ca-directory=DIR           hakemisto, jossa on
                                    CA-tiivisteluettelo.
       --random-file=FILE           tiedosto SSL PRNG:n satunnaisdatalle.
       --egd-file=FILE              tiedosto, joka nime„„ EGD-pistokkeen.

FTP-valitsimet:
       --ftp-user=USER              aseta FTP-k„ytt„j„ksi USER.
       --ftp-password=PASS          aseta FTP-salasanaksi PASS.
       --no-remove-listing          „l„ poista `.listing'-tiedostoja.
       --no-glob                    poista FTP-tiedostonimien laajennus
                                    (globbing).
       --no-passive-ftp             poista "passiivinen" siirtotila
                                    k„yt”st„.
       --retr-symlinks              rekursiossa hae linkitetyt tiedostot.
       --preserve-permissions       s„ilyt„ et„tiedostojen oikeudet.

Rekursiivinen lataus:
  -r,  --recursive                  m„„rit„ rekursiivinen lataus.
  -l,  --level=NUMBER               maksimi rekursiosyvyys (inf/0
                                    „„ret”n).
       --delete-after               poista tiedostot paikallisesti
                                    latauksen j„lkeen.
  -k,  --convert-links              muuta ladatun HTML:n linkit
                                    paikallisiksi.
  -K,  --backup-converted           ennen tiedoston X muuntoa
                                    varmuuskopioi nimell„ X.orig.
  -m,  --mirror                     lyhenne valitsimille -N -r -l inf
                                    --no-remove-listing.
  -p,  --page-requisites            hae kaikki kuvat yms. HTML-sivua
                                    varten.
       --strict-comments            ota k„ytt””n tiukka (SGML)
                                    HTML-kommenttien k„sittely.

Rekursiivinen hyv„ksynt„/hylk„ys:
  -A,  --accept=LIST                pilkuin erotettu hyv„ksyttyjen
                                    p„„tteiden luettelo.
  -R,  --reject=LIST                pilkuin erotettu hyl„ttyjen
                                    p„„tteiden luettelo.
  -D,  --domains=LIST               pilkuin erotettu hyv„ksyttyjen
                                    verkkotunnusten luettelo.
       --exclude-domains=LIST       pilkuin erotettu hyl„ttyjen
                                    verkkotunnusten luettelo.
       --follow-ftp                 seuraa FTP-linkkej„ HTML-dokumenteista.
       --follow-tags=LIST           pilkuin erotettu seurattujen
                                    HTML-tunnisteiden luettelo.
       --ignore-tags=LIST           pilkuin erotettu ohitettujen
                                    HTML-tunnisteiden luettelo.
  -H,  --span-hosts                 siirry vieraille is„nnille rekursiossa.
  -L,  --relative                   seuraa vain relatiivisia linkkej„.
  -I,  --include-directories=LIST   sallittujen hakemistojen luettelo.
  -X,  --exclude-directories=LIST   poissuljettujen hakemistojen
                                    luettelo.
  -np, --no-parent                  „l„ nouse yl„hakemistoon.

L„het„ vikailmoitukset ja ehdotukset osoitteeseen <bug-wget@gnu.org>.
