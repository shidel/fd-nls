# File ending: eo
# Codepage: UTF-8
# This translation was created by Google AI.
# Please help the FreeDOS group to improve it.

GNU Wget 1.11.1, neinteraga reta elŝutilo.
Uzado: wget.exe [OPTION]... [URL]...

Devigaj argumentoj por longaj opcioj estas devigaj ankaŭ por mallongaj.

Starto:
  -V,  --version                    montri la version de Wget kaj eliri.
  -h,  --help                       eligi ĉi tiun helpon.
  -b,  --background                 iri al fono post lanĉo.
  -e,  --execute=COMMAND            plenumi komandon en `.wgetrc'-stilo.

Protokolado kaj enigdosiero:
  -o,  --output-file=FILE           protokoli mesaĝojn en FILE.
  -a,  --append-output=FILE         aldoni mesaĝojn al FILE.
  -d,  --debug                      eligi multajn sencimigajn informojn.
       --wdebug                     eligi Watt-32-sencimigan eligon.
  -q,  --quiet                      silenta (neniu eligo).
  -v,  --verbose                    esti babilema (ĉi tio estas apriora).
  -nv, --no-verbose                 malŝalti babilemecon, sen esti silenta.
  -i,  --input-file=FILE            elŝuti URL-ojn trovitajn en FILE.
  -F,  --force-html                 trakti enigdosieron kiel HTML.
  -B,  --base=URL                   antaŭaldoni URL al relativaj ligiloj.

Elŝuto:
  -t,  --tries=NUMBER               agordi nombron de provoj al NUMBER.
       --retry-connrefused          reprovi eĉ se konekto estas rifuzita.
  -O,  --output-document=FILE       skribi dokumentojn al FILE.
  -nc, --no-clobber                 pasi elŝutojn kiuj superskribus
                                    ekzistantajn dosierojn.
  -c,  --continue                   daŭrigi ricevadon de parta dosiero.
       --progress=TYPE              elekti tipon de progresa indikilo.
  -N,  --timestamping               ne re-elŝuti dosierojn krom se pli
                                    novaj ol lokaj.
  -S,  --server-response            eligi respondon de servilo.
       --spider                     ne elŝuti ion ajn.
  -T,  --timeout=SECONDS            agordi ĉiujn templimojn al SECONDS.
       --dns-timeout=SECS           agordi DNS-templimon al SECS.
       --connect-timeout=SECS       agordi konektan templimon al SECS.
       --read-timeout=SECS          agordi legan templimon al SECS.
  -w,  --wait=SECONDS               atendi SECONDS inter elŝutoj.
       --waitretry=SECONDS          atendi 1..SECONDS inter reprovoj.
       --random-wait                atendi 0...2*WAIT sek inter elŝutoj.
       --no-proxy                   eksplicite malŝalti prokurilon.
  -Q,  --quota=NUMBER               agordi elŝutan kvoton al NUMBER.
       --bind-address=ADDRESS       ligi al ADDRESS (nomo/IP) loke.
       --limit-rate=RATE            limigi elŝutan rapidon al RATE.
       --no-dns-cache               malŝalti kaŝmemoradon de DNS.
       --restrict-file-names=OS     limigi signojn en dosiernomoj por OS.
       --ignore-case                ignori usklecon ĉe dosieroj/ujoj.
  -4,  --inet4-only                 konekti nur al IPv4-adresoj.
  -6,  --inet6-only                 konekti nur al IPv6-adresoj.
       --prefer-family=FAMILY       konekti unue al specifa familio,
                                    unu el IPv6, IPv4, aŭ none.
       --user=USER                  agordi FTP- kaj HTTP-uzanton al USER.
       --password=PASS              agordi FTP- kaj HTTP-pason al PASS.

Dosierujoj:
  -nd, --no-directories             ne krei dosierujojn.
  -x,  --force-directories          devigi kreon de dosierujoj.
  -nH, --no-host-directories        ne krei gastigajn dosierujojn.
       --protocol-directories       uzi protokolan nomon en dosierujoj.
  -P,  --directory-prefix=PREFIX    konservi dosierojn al PREFIX/...
       --cut-dirs=NUMBER            ignori NUMBER forajn dosierujojn.

HTTP-opcioj:
       --http-user=USER             agordi HTTP-uzanton al USER.
       --http-password=PASS         agordi HTTP-pasvorton al PASS.
       --no-cache                   malpermesi servil-kaŝmemorajn datumojn.
  -E,  --html-extension             konservi HTML kun `.html' finaĵo.
       --ignore-length              ignori `Content-Length' kap-kampon.
       --header=STRING              enmeti STRING inter la kapliniojn.
       --max-redirect               maksimumaj alidirektoj po paĝo.
       --proxy-user=USER            agordi USER kiel prokurila uzantnomo.
       --proxy-password=PASS        agordi PASS kiel prokurila pasvorto.
       --referer=URL                inkluzivi `Referer: URL' en peto.
       --save-headers               konservi HTTP-kapliniojn al dosiero.
  -U,  --user-agent=AGENT           identigi kiel AGENT anstataŭ Wget.
       --no-http-keep-alive         malŝalti HTTP keep-alive.
       --no-cookies                 ne uzi kuketojn.
       --load-cookies=FILE          ŝargi kuketojn el FILE antaŭ seanco.
       --save-cookies=FILE          konservi kuketojn al FILE post seanco.
       --keep-session-cookies       ŝargi kaj konservi seancajn kuketojn.
       --post-data=STRING           uzi POST-metodon; sendi STRING.
       --post-file=FILE             uzi POST-metodon; sendi enhavon FILE.
       --content-disposition        respekti Content-Disposition kaplinion
                                    kiam oni elektas lokajn dosiernomojn.
       --auth-no-challenge          Sendi Bazan HTTP-aŭtentikigon sen unue
                                    atendi la defion de la servilo.

HTTPS (SSL/TLS)-opcioj:
       --secure-protocol=PR         elekti sekuran protokolon, unu el
                                    auto, SSLv2, SSLv3 kaj TLSv1.
       --no-check-certificate       ne validigi atestilon de servilo.
       --certificate=FILE           klienta atestila dosiero.
       --certificate-type=TYPE      klienta atestila tipo, PEM aŭ DER.
       --private-key=FILE           privata ŝlosila dosiero.
       --private-key-type=TYPE      privata ŝlosila tipo, PEM aŭ DER.
       --ca-certificate=FILE        dosiero kun la fasko de CA-oj.
       --ca-directory=DIR           dosierujo kun haketlisto de CA-oj.
       --random-file=FILE           dosiero kun hazardaj datumoj por PRNG.
       --egd-file=FILE              dosiero nomanta la EGD-konektingon.

FTP-opcioj:
       --ftp-user=USER              agordi FTP-uzanton al USER.
       --ftp-password=PASS          agordi FTP-pasvorton al PASS.
       --no-remove-listing          ne forigi `.listing'-dosierojn.
       --no-glob                    malŝalti FTP-dosiernoman globadon.
       --no-passive-ftp             malŝalti "pasivan" transigan reĝimon.
       --retr-symlinks              ĉe rekursio, ricevi ligitajn dosierojn.
       --preserve-permissions       konservi forajn dosierajn permesojn.

Rekursia elŝuto:
  -r,  --recursive                  specifi rekursian elŝuton.
  -l,  --level=NUMBER               maksimuma rekursia profundo (inf/0).
       --delete-after               forigi dosierojn loke post elŝuto.
  -k,  --convert-links              igi ligilojn en HTML montri loke.
  -K,  --backup-converted           antaŭ konverti dosieron X, savi kiel
                                    X.orig.
  -m,  --mirror                     mallongigo por -N -r -l inf
                                    --no-remove-listing.
  -p,  --page-requisites            ricevi ĉiujn bildojn ktp. por HTML.
       --strict-comments            ŝalti striktan (SGML) traktadon de
                                    HTML-komentoj.

Rekursie akcepti/malakcepti:
  -A,  --accept=LIST                koma listo de akceptitaj finaĵoj.
  -R,  --reject=LIST                koma listo de malakceptitaj finaĵoj.
  -D,  --domains=LIST               koma listo de akceptitaj domajnoj.
       --exclude-domains=LIST       koma listo de malakceptitaj domajnoj.
       --follow-ftp                 sekvi FTP-ligilojn el HTML-dokumentoj.
       --follow-tags=LIST           koma listo de sekvataj HTML-etikedoj.
       --ignore-tags=LIST           koma listo de ignorataj HTML-etikedoj.
  -H,  --span-hosts                 iri al fremdaj gastigantoj rekursie.
  -L,  --relative                   sekvi nur relativajn ligilojn.
  -I,  --include-directories=LIST   listo de permesitaj dosierujoj.
  -X,  --exclude-directories=LIST   listo de ekskluditaj dosierujoj.
  -np, --no-parent                  ne supreniri al gepatra dosierujo.

Sendu cimraportojn kaj sugestojn al <bug-wget@gnu.org>.
