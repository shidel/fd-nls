  -T,  --timeout=SECONDS            s‘t alle timeouts til SECONDS.
       --dns-timeout=SECS           s‘t DNS-timeout til SECS.
       --connect-timeout=SECS       s‘t forbindelsestimeout til SECS.
       --read-timeout=SECS          s‘t l‘setimeout til SECS.
  -w,  --wait=SECONDS               vent SECONDS mellem downloads.
       --waitretry=SECONDS          vent 1..SECONDS mellem fors›g.
       --random-wait                vent 0...2*WAIT sek. mellem downloads.
       --no-proxy                   sl† eksplicit proxy fra.
  -Q,  --quota=NUMBER               s‘t downloadkvote til NUMBER.
       --bind-address=ADDRESS       bind til ADDRESS (v‘rtsnavn/IP) lokalt.
       --limit-rate=RATE            begr‘ns downloadhastighed til RATE.
       --no-dns-cache               deaktiver DNS-caching.
       --restrict-file-names=OS     begr‘ns tegn i filnavne for OS.
       --ignore-case                ignorer store/sm† bogstaver.
  -4,  --inet4-only                 forbind kun til IPv4-adresser.
  -6,  --inet6-only                 forbind kun til IPv6-adresser.
       --prefer-family=FAMILY       forbind f›rst til denne familie,
