# Language: Polish
# Codepage: 852
# Translation: reviewed by Piotr Okrutny in Weblate, 2026-10 (human review, AI-assisted draft)
# Source: edict.pl.UTF-8; edict.pl (CP852) and edict.mz (Mazovia) are generated from it - edit only the UTF-8 file.

TITLE=Enhanced Disk Image Creation Tool, wersja %_ %s
COPYRIGHT=Copyright (c) 2018, Jerome Shidel

HELP_00="Opcje programu EDICT: "
HELP_01=
HELP_02="  /d <dysk>      określa literę stacji dysków"
HELP_03="  /f <plik>      określa nazwę pliku"
HELP_04="  /p <limit>     ogranicza liczbę dodatkowych przebiegów odczytu"
HELP_05=
HELP_06="  /t <rodzaj>    wymusza typ stacji zamiast ustawień BIOS-u"
HELP_07="                 (0=360Kib, 1=1.2Mib, 2=720Kib, 3=1.44Mib, a=auto)"
HELP_08=
HELP_09="  /c <liczba>    wymusza liczbę cylindrów/ścieżek (0-1023)"
HELP_0a="  /r <liczba>    wymusza liczbę stron (głowic) dyskietki (0-255)"
HELP_0b="  /s <liczba>    wymusza liczbę sektorów na ścieżkę (0-63)"
HELP_0c="  /b <liczba>    wymusza liczbę bajtów na sektor (1-8192)"
HELP_0d=
HELP_0e="  /h             wyświetla pomoc"

HELP_??="  /T             testuj tylko odczyt"
HELP_??="  /w             zapisz obraz na dyskietkę"
HELP_??="  /v             weryfikuj dyskietkę"
HELP_??="  /i             tylko informacje"
HELP_??="  /o             tylko jeden sektor"
HELP_??="  /q             tryb cichy"
HELP_??="  /e             kontynuuj z istniejącego pliku obrazu"
HELP_??="  /m <nazwa_pliku> zamontuj plik obrazu"
HELP_??="  /u             odmontuj plik obrazu"
HELP_??="  /l             lista typów dysków"

INVALID=%r "Nieprawidłowe polecenie: `" %s "'"
BAD_INT="Nieprawidłowa wartość liczbowa."
BAD_VAL="Wartość poza zakresem."

DRIVE=Stacja %_ %c: (ID 0x %b ) %_
DRIVE_TYPE=%_ (ID 0x %b )
DRIVE_TYPE_00=nieznany typ stacji
DRIVE_TYPE_01=stacja '5.25"' 360Kib
DRIVE_TYPE_02=stacja '5.25"' 1.2Mib
DRIVE_TYPE_03=stacja '3.5"' 720Kib
DRIVE_TYPE_04=stacja '3.5"' 1.44Mib
DRIVE_TYPE_05=inny typ stacji

DRIVE_SPEC=%i %_ bajtów na sektor, %_ %I %_ sektorów na ścieżkę, %_ %I %_ ścieżek, stron: %_ %I

PASS_LIMIT=Dodatkowe przebiegi odczytu dyskietki: maks. %_ %i %_
BUFFERS=%i %_ B bufora dyskietki, %_ %i %_ B bufora wyników ścieżki

PASS=Przebieg odczytu dyskietki nr %_ %i. Pozostało sektorów: %_ %i.

READ_FAST=ODCZYT ŚCIEŻKI: %_ %i, GŁOWICA: %_ %i
READ_SLOW=ODCZYT ŚCIEŻKI: %_ %i, GŁOWICA: %_ %i, SEKTOR: %_ %i

FAILED=Tworzenie obrazu nie powiodło się.
ABORTED=Tworzenie obrazu przerwane.
COMPLETED=Tworzenie obrazu zakończone.
BErr=%r "Kod błędu BIOS: 0x" %b %_ --> %_
BErr_01=nieprawidłowe polecenie przekazane do sterownika
BErr_02=nie znaleziono znacznika adresu lub uszkodzony sektor
BErr_03=dyskietka zabezpieczona przed zapisem
BErr_04=nie znaleziono sektora
BErr_05=nie udało się zresetować dysku twardego
BErr_06=dyskietka zmieniona lub wyjęta
BErr_07=nieprawidłowa tablica parametrów dysku twardego
BErr_08=przepełnienie DMA
BErr_09=dostęp DMA przekracza granicę 64k
BErr_0a=nieprawidłowy znacznik sektora dysku twardego
BErr_0b=nieprawidłowy cylinder dysku twardego
BErr_0c=nieobsługiwana ścieżka
BErr_0d=nieprawidłowa liczba sektorów przy formatowaniu dysku twardego
BErr_0e=dysk twardy: wykryto znacznik adresu danych sterujących
BErr_0f=dysk twardy: poziom arbitrażu DMA poza zakresem
BErr_10=błąd ECC/CRC przy odczycie dysku
BErr_11=naprawialny błąd danych dysku twardego, dane poprawione przez ECC
BErr_20=błąd kontrolera
BErr_40=błąd pozycjonowania głowicy
BErr_80=stacja nie jest gotowa
BErr_aa=dysk twardy nie jest gotowy
BErr_bb=niezdefiniowany błąd dysku twardego
BErr_cc=błąd zapisu na wybranym dysku twardym
BErr_e0=błąd stanu dysku twardego
BErr_ff=nie udało się odczytać stanu (sense)
DErr=%r "Kod błędu DOS: 0x" %b %_ --> %_
DErr_01=Nieprawidłowy numer funkcji
DErr_02=Nie znaleziono pliku
DErr_03=Nie znaleziono ścieżki
DErr_04=Za dużo otwartych plików
DErr_05=Odmowa dostępu
DErr_06=Nieprawidłowy uchwyt
DErr_08=Za mało pamięci
DErr_0f=Nieprawidłowe określenie dysku
DErr_15=Stacja nie jest gotowa



