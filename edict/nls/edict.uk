TITLE=Покращений засўб створення образўв дискўв, версўя %_ %s
COPYRIGHT=Copyright (c) 2018, Jerome Shidel

HELP_00="Ўнформацўя про параметри EDICT: "
HELP_01=
HELP_02="  /d <диск>      вказати лўтеру диска"
HELP_03="  /f <ўм'я_файлу> вказати ўм'я файлу"
HELP_04="  /p <лўмўт>     обмежити макс. кўлькўсть додаткових проходўв"
HELP_05=
HELP_06="  /t <тип>       перевизначити BIOS та обрати налаштування типу диска"
HELP_07="                 (0=360Kib, 1=1.2Mib, 2=720Kib, 3=1.44Mib, a=auto)"
HELP_08=
HELP_09="  /c <число>     перевизначити кўлькўсть цилўндрўв/дорўжок (0-1023)"
HELP_0a="  /r <число>     перевизначити кўлькўсть сторўн/головок на дорўжку (0-255)"
HELP_0b="  /s <число>     перевизначити кўлькўсть секторўв на сторону (0-63)"
HELP_0c="  /b <число>     перевизначити кўлькўсть байтўв у секторў (1-8192)"
HELP_0d=
HELP_0e="  /h             показати довўдку"

HELP_??="  /T             тест тўльки для читання"
HELP_??="  /w             записати образ на дискету"
HELP_??="  /v             перевўрити дискету"
HELP_??="  /i             тўльки ўнформацўя"
HELP_??="  /o             тўльки один сектор"
HELP_??="  /q             тихий режим"
HELP_??="  /e             продовжити з ўснуючого файлу образу"
HELP_??="  /m <ўм'я_файлу> пўдключити файл образу (mount)"
HELP_??="  /u             вўдключити файл образу (unmount)"
HELP_??="  /l             список типўв дискўв"

INVALID=%r "Неправильна команда: `" %s "'"
BAD_INT="Неправильне числове значення."
BAD_VAL="Значення поза дўапазоном."

DRIVE=Диск %_ %c: (ID 0x %b ) %_
DRIVE_TYPE=%_ (ID 0x %b )
DRIVE_TYPE_00=невўдомий тип дисковода
DRIVE_TYPE_01=дисковод '5.25"' 360Kib
DRIVE_TYPE_02=дисковод '5.25"' 1.2Mib
DRIVE_TYPE_03=дисковод '3.5"' 720Kib
DRIVE_TYPE_04=дисковод '3.5"' 1.44Mib
DRIVE_TYPE_05=ўнший тип дисковода

DRIVE_SPEC=%i %_ байтўв, %_ %I %_ секторўв, %_ %I %_ дорўжок, %_ %I %_ сторўн

PASS_LIMIT=Дозволено до %_ %i %_ дод. проходўв для читання дискети
BUFFERS=%i %_ байт буфер дискети, %_ %i %_ байт буфер дорўжки

PASS=Прохўд читання дискети № %i. Залишилося секторўв: %_ %i %_ .

READ_FAST=ЧИТАННЯ ДОРЎЖКИ: %_ %i, ГОЛОВКА: %_ %i
READ_SLOW=ЧИТАННЯ ДОРЎЖКИ: %_ %i, ГОЛОВКА: %_ %i, СЕКТОР: %_ %i

FAILED=Процес створення образу не вдався.
ABORTED=Процес створення образу перервано.
COMPLETED=Процес створення образу завершено.

BErr=%r "Код помилки BIOS: 0x" %b %_ --> %_
BErr_01=неправильна команда передана драйверу
BErr_02=адресна марка не знайдена або поганий сектор
BErr_03=помилка захисту запису на дискету
BErr_04=сектор не знайдено
BErr_05=помилка скидання жорсткого диска
BErr_06=дискету змўнено або вилучено
BErr_07=неправильна таблиця параметрўв жорсткого диска
BErr_08=переповнення DMA
BErr_09=доступ DMA через межу 64k
BErr_0a=поганий прапор сектора жорсткого диска
BErr_0b=поганий цилўндр жорсткого диска
BErr_0c=непўдтримувана дорўжка
BErr_0d=неправильна кўлькўсть секторўв у форматў жорсткого диска
BErr_0e=виявлено адресну марку даних пўд керуванням жорсткого диска
BErr_0f=рўвень арбўтражу DMA жорсткого диска поза дўапазоном
BErr_10=помилка ECC/CRC пўд час читання диска
BErr_11=виправна помилка даних жорсткого диска, данў виправлено ECC
BErr_20=помилка контролера
BErr_40=помилка позицўонування (seek failure)
BErr_80=дисковод не готовий
BErr_aa=жорсткий диск не готовий
BErr_bb=невизначена помилка жорсткого диска
BErr_cc=помилка запису на жорсткий диск на обраному дисководў
BErr_e0=помилка статусу жорсткого диска
BErr_ff=операцўя опитування (sense) не вдалася

DErr=%r "Код помилки DOS: 0x" %b %_ --> %_
DErr_01=Неправильний номер функцў∙
DErr_02=Файл не знайдено
DErr_03=Шлях не знайдено
DErr_04=Забагато вўдкритих файлўв
DErr_05=Доступ заборонено
DErr_06=Неправильний дескриптор (handle)
DErr_08=Недостатньо пам'ятў
DErr_0f=Вказано неправильний диск
DErr_15=Диск не готовий

