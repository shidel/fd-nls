# Language: Polish
# Codepage: 852
# Translation: reviewed by Piotr Okrutny in Weblate, 2026-10 (human review, AI-assisted draft)
# Source: PKGMAKER.PL.UTF-8; PKGMAKER.PL (CP852) and PKGMAKER.MZ (Mazovia) are generated from it - edit only the UTF-8 file.

LANG=PL
LANGUAGE=Polski
PROG.NAME=PkgMaker
PROG.VERSION=wersja $
PROG.TITLE=PkgMaker
PROG.DESC=Narzędzie do tworzenia pakietów
PROG.ABORT=przerwano
MEM.USAGE=Użycie pamięci

GBYTE=$ GB
OVERBYTE=>$ GB
PAUSED=naciśnij klawisz, aby kontynuować...

ERROR=Błąd ($)
ERROR.NUMBER=#$
ERROR.2=nie znaleziono pliku
ERROR.3=nie znaleziono ścieżki
ERROR.9=za mało pamięci

ERROR.BADOPT=nieprawidłowy przełącznik $
ERROR.NOTEMP=nie ustawiono zmiennej środowiskowej TEMP
ERROR.BADDRV=nie znaleziono dysku $, pominięto
ERROR.LOWMEM=bardzo mało wolnej pamięci
ERROR.LONGLN=Błąd: wiersz nr $ jest za długi
ERROR.ISULFN=prawdopodobnie długa nazwa (LFN)

ERROR.DEFCFG=przyjęto ustawienia domyślne
ERROR.NOPKG=nie podano identyfikatora/nazwy pakietu
ERROR.BADNAME=nie można użyć $ jako identyfikatora/nazwy pakietu
ERROR.EXISTS=metadane pakietu $ już istnieją
ERROR.NOINC=dodatkowe dyski można dołączyć tylko przy pierwszym skanowaniu
ERROR.NOLST=nie znaleziono listy plików pakietu $
ERROR.BADLSM=plik metadanych pakietu $ wymaga poprawienia
ERROR.NOZIP=nie znaleziono programu zip

FORCED=wymuszono kontynuację

FILE.APPEND=dopisywanie do istniejącego pliku $
FILE.KEEP=zachowano istniejący plik $
FILE.PRUNE=usuwanie wpisów z istniejącego pliku $

FILE=$ plik
FILES=plików: $
BYTE=$ B
BYTES=$ B
KBYTE=$ KB
MBYTE=$ MB

SCAN.INIT=Pierwsze skanowanie
SCAN.POST=Drugie skanowanie
SCAN.WAIT=To może chwilę potrwać
SCAN.MISSING=Nie znaleziono wyników pierwszego skanowania
SCAN.RUN=Skanowanie...
SCAN.DRIVE=Skanowanie $ ...
SCAN.DONE=Skanowanie zakończone
SCAN.DONE.FAST=Albo i nie. Ale szybko poszło! Gotowe!

FILE.DEL=usunięto plik $
STATS.NOW=znaleziono katalogów: $0, plików: $1, rozmiar: $2
STATS.NEW=znaleziono nowych plików: $1, rozmiar: $2
STATS.MOD=znaleziono zmienionych plików: $0, zobacz $1
STATS.DETACH=odłączono plików: $

META.MADE=utworzono metadane pakietu $
META.UPDATE=zaktualizowano metadane pakietu $

MODE.ADD=Dodawanie plików do pakietu $
MODE.DETACH=Odłączanie plików od pakietu $
MODE.ZIP=Tworzenie archiwum ZIP pakietu $

PKG.ADD=dodawanie: $
PKG.DETACH=odłączanie: $

IDX.NEW.FILE=Nowy: $
IDX.NEW.DIR=Nowy: $\
IDX.MOD.FILE=Zmieniony: $
IDX.MOD.DIR=Zmieniony: $\

NO.ZIP=Tworzenie archiwum ZIP niedostępne ze względu na zgodność, użyj pkgzipit.bat

HELP.0=Użycie: $ [opcje] [pakiet]
HELP.1=
HELP.2=Przy pierwszym uruchomieniu program domyślnie skanuje system plików
HELP.3=i zapisuje informacje o nim. Przy drugim uruchomieniu porównuje nowy stan
HELP.4=z poprzednim skanowaniem i na tej podstawie tworzy pliki LSM i LST pakietu.
HELP.5=
HELP.6=Opcje:
HELP.7=
HELP.8=    $H          Wyświetla pomoc i kończy działanie
HELP.9=
HELP.10=    $I          Wykonuje pierwsze skanowanie (domyślnie przy 1. uruchomieniu)
HELP.11=    $S          Wykonuje drugie skanowanie (domyślnie przy 2. uruchomieniu)
HELP.12=
HELP.13=    $D dysk     Dołącza dysk do skanowania (domyślnie skanowany jest tylko C:)
HELP.14=
HELP.15=    $K          Nie usuwa danych skanowania po drugim skanowaniu
HELP.16=    $M          Nie skanuje, tylko tworzy pliki metadanych pakietu.
HELP.17=
HELP.18=    $A plik     Dodaje plik do metadanych pakietu.
HELP.19=    $R wzorzec  Odłącza pliki od metadanych pakietu (nie usuwa ich z dysku).
HELP.20=    $F          Wymusza kontynuację mimo błędów (np. istniejących metadanych).
HELP.21=
HELP.22=    $Z          Tworzy archiwum ZIP pakietu
