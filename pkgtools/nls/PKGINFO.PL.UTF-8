; HELP numbers can change and vary. However, they must be consecutive. Add more
; lines, reduce the total count, insert between lines. Doesn't matter. Just do
; not skip or repeat line numbers.

HELP.0=Użycie: $ [opcje] [pakiet]
HELP.1=
HELP.2=     [opcje]     Wielkość liter w opcjach nie ma znaczenia. Bez żadnej opcji
HELP.3=                 program działa tak, jak z opcją $L.
HELP.4=
HELP.5=     [pakiet]    Złożony wzorzec wieloznaczny wskazujący pakiet(y), np.
HELP.6=                 fd*pkg, *zip*, ?d* itp.
HELP.7=
HELP.8=Podstawowe tryby działania:
HELP.9=
HELP.10=     $H          Wyświetla pomoc i kończy działanie
HELP.11=
HELP.12=     $N          Wyświetla nazwy zainstalowanych pakietów
HELP.13=     $L          Wyświetla zainstalowane pakiety (nazwa, tytuł, wersja)
HELP.14=     $I          Wyświetla szczegóły zainstalowanych pakietów
HELP.15=     $D          Jak $I, ale z dodatkowymi informacjami
HELP.16=
HELP.17=     $W element  Wyświetla tylko pakiety zawierające podany plik lub katalog
HELP.18=                 (pozwala sprawdzić, do którego pakietu należy).
HELP.19=
HELP.20=Opcje modyfikujące tryb:
HELP.21=
HELP.22=     $R          Zgłasza brakujące pliki
HELP.23=     $E          Wyświetla pliki wykonywalne
HELP.24=     $A          Wyświetla wszystkie pliki
HELP.25=     $U          Oblicza zajętość dysku
HELP.26=
HELP.27=     $P          Zatrzymuje wyświetlanie po każdej stronie
HELP.28=     $S wzorzec  Szuka w informacjach o pakiecie tekstu pasującego do wzorca
HELP.29=
HELP.30=Inne opcje:
HELP.31=
HELP.32=     $VER        Wyświetla informacje o wersji
HELP.33=     $NLS język  Używa tłumaczenia 'język' zamiast ustawienia systemowego
HELP.34=     //          Wymusza używanie / jako znaku przełącznika
