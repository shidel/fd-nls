GBYTE=$ GB
OVERBYTE=>$ GB
PAUSED=naciśnij klawisz, aby kontynuować...

MEM.USAGE=Użycie pamięci
BAD.SWITCH=Nieprawidłowy przełącznik '$' (zobacz pomoc)
LINE.TOOLONG=Błąd: wiersz nr $ jest za długi

ERROR=Błąd ($)
ERROR.NUMBER=#$
ERROR.2=nie znaleziono pliku
ERROR.3=nie znaleziono ścieżki

PKG.INSTALLED=pakiet '$' jest zainstalowany
PKG.NOTFOUND=Nie znaleziono pakietu pasującego do '$'

LST.NOTFOUND=Nie znaleziono listy plików pakietu

LSM.TITLE=Tytuł
