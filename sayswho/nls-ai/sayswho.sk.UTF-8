; Language: Slovak (sk)
; File ending: sk
; Codepage: 852
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Hneď ako bude hotový hlavný text pre tento program, budú tieto jazykovo
; špecifické súbory z tohto projektu odstránené a presunuté do prekladateľského
; projektu FD-NLS. Preklady alebo opravy sú vítané. Nebudú však prijaté
; priamo do vývoja zdrojového kódu tohto projektu.

VERSION=%0 (verzia %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Všetky práva vyhradené.

; Ak chcete uviesť svoje meno pri preklade zobrazenom v programe, jednoducho
; upravte pole LANGUAGE a vyplňte pole TRANSLATOR. :-)

LANGUAGE=Slovenčina
TRANSLATOR=

THANKS=Zvláštne poďakovanie %0 za poskytnutie prekladov do jazyka %1.

; Táto hra má veľmi málo textu a veľa prázdneho miesta na obrazovke. Preto
; štandardne používa väčšie anglické písmo 12x14. V tomto písme zaberá riadok
; HINT väčšinu šírky obrazovky. Pre iné jazyky sú však najväčšie písma
; 10x12 alebo 8x16. Tieto jazykovo špecifické fonty nájdete na FD-NLS v
; adresári "danger".

LEVEL=Sekvencia
TRIES=Pokusy
START=kliknite alebo stlačte kláves
DEATH=nesprávne
GAMEOVER=koniec hry

; Ak je váš preklad HINT oveľa dlhší, bude pravdepodobne orezaný. Zvážte
; vynechanie odkazu na numerickú klávesnicu. Možno ho preložte len ako
; "použite šípky alebo myš".

HINT=použite šípky, numerickú klávesnicu alebo myš

ERROR.MOUSE=nepodarilo sa nájsť myš. Je skutočne nevyhnutná.
ERROR.VIDEO=nepodarilo sa nájsť žiadny vhodný grafický ovládač

ERROR.DRIVER.FIND=nemožno nájsť ovládač %0
ERROR.DRIVER.INIT=nemožno inicializovať ovládač %0
ERROR.DRIVER.MODE=otváranie grafického ovládača %0 režim %1

ERROR.NOHELP=pomocník nie je k dispozícii
ERROR.FORMAT=nepodarilo sa rozpoznať formát súboru %0

; Je možných mnoho ďalších chybových hlásení/kódov. Tie by sa však mali
; vyskytovať len zriedka. Preto bola väčšina vynechaná. Z tých zvyšných
; by sa mali skutočne vyskytnúť iba pri kompilácii v režime "Debug".

ERROR.1=neplatná funkcia
ERROR.2=súbor sa nenašiel
ERROR.3=cesta sa nenašla
ERROR.4=príliš veľa otvorených súborov
ERROR.5=prístup k súboru odmietnutý
ERROR.8=nedostatok pamäte
ERROR.201=kontrola rozsahu údajov
ERROR.202=pretečenie zásobníka
ERROR.203=pretečenie pamäte
ERROR.204=operácia s ukazovateľom
ERROR.220=kontrola dátového typu
ERROR.221=nepodporovaná operácia
ERROR.222=neplatný formát súboru
ERROR.223=štruktúra je príliš veľká
ERROR.224=overenie údajov
ERROR.225=nepriradený ukazovateľ
ERROR.226=uvoľnenie uzamknutého prostriedku
ERROR.227=chyba komprimovaného obrazu
ERROR.230=chyba inicializácie
ERROR.231=nesprávne zarovnaný ovládač
ERROR.232=nepodporovaný typ ovládača
ERROR.233=neplatný typ ovládača
ERROR.234=overenie ovládača
ERROR.240=zlyhanie grafického ovládača
ERROR.241=zlyhanie zvukového ovládača
ERROR.242=zlyhanie ovládača klávesnice
ERROR.243=zlyhanie ovládača myši
ERROR.244=zlyhanie ovládača joysticku

