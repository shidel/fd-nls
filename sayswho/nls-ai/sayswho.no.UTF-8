; Når hovedteksten til dette programmet er klar, vil disse språkspesifikke
; filene fjernes fra dette prosjektet og flyttes til FD-NLS-prosjektet.
; Oversettelser eller rettelser er velkomne. De vil imidlertid ikke bli
; akseptert direkte inn i kildekodeutviklingen av dette prosjektet.

VERSION=%0 (versjon %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Alle rettigheter forbeholdt.

; Hvis De ønsker kreditt for Deres oversettelse vist i programmet, må De
; redigere feltet LANGUAGE og fylle ut feltet TRANSLATOR. :-)

LANGUAGE=Norsk
TRANSLATOR=

THANKS=Spesiell takk til %0 for å ha levert oversettelsene til %1.

; Dette spillet har veldig lite tekst og mye tom skjermplass. Derfor bruker
; det som standard en større 12x14 engelsk skrifttype. I den skrifttypen tar
; HINT-linjen opp det meste av skjermbredden. For andre språk er imidlertid de
; største skrifttypene 10x12 oder 8x16. De kan finne disse språkspesifikke
; skrifttypene på FD-NLS under "danger"-mappen.

LEVEL=Sekvens
TRIES=Forsøk
START=klikk eller trykk en tast
DEATH=feil
GAMEOVER=spillet er slutt

; Hvis Deres HINT-oversettelse er mye lengre, vil den sannsynligvis bli
; avkortet. Vurder å utelate referansen til det numeriske tastaturet.
; Kanskje bare oversett det som "bruk piltaster eller mus".

HINT=bruk piltaster, numerisk tastatur eller mus

ERROR.MOUSE=kunne ikke finne musen. Den er helt nødvendig.
ERROR.VIDEO=kunne ikke finne noen passende grafikkdriver

ERROR.DRIVER.FIND=kunne ikke finne %0-driver
ERROR.DRIVER.INIT=kunne ikke initialisere %0-driver
ERROR.DRIVER.MODE=åpner grafikkdriver %0 modus %1

ERROR.NOHELP=hjelp ikke tilgjengelig
ERROR.FORMAT=kunne ikke gjenkjenne formatet på fil %0

; Det er mange andre mulige feilmeldinger/koder. Men disse bør sjelden
; forekomme. Derfor er de fleste utelatt. De gjenværende bør egentlig kun
; forekomme ved kompilering i "Debug"-modus.

ERROR.1=ugyldig funksjon
ERROR.2=fil ikke funnet
ERROR.3=sti ikke funnet
ERROR.4=for mange åpne filer
ERROR.5=filadgang nektet
ERROR.8=slutt på minne
ERROR.201=kontroll av dataområde
ERROR.202=stakkoverflyt
ERROR.203=minneoverløp
ERROR.204=pekeroperasjon
ERROR.220=kontroll av datatype
ERROR.221=ikke-støttet handling
ERROR.222=ugyldig filformat
ERROR.223=struktur for stor
ERROR.224=dataverifisering
ERROR.225=peker ikke tildelt
ERROR.226=frigjør låst ressurs
ERROR.227=feil i komprimert bilde
ERROR.230=initialiseringsfeil
ERROR.231=feiljustert driver
ERROR.232=ikke-støttet drivertype
ERROR.233=ugyldig drivertype
ERROR.234=driververifisering
ERROR.240=grafikkdriver-feil
ERROR.241=lyddriver-feil
ERROR.242=tastaturdriver-feil
ERROR.243=musedriver-feil
ERROR.244=joystickdriver-feil

