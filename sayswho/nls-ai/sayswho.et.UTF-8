; Language: Estonian (et)
; File ending: et
; Codepage: 775
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Kui selle programmi põhiosad on valmis, eemaldatakse need keelespetsiifilised
; failid sellest projektist ja viiakse üle FD-NLS tõlkeprojekti. Tõlked ja
; parandused on teretulnud. Neid ei võeta aga vastu otse selle projekti
; lähtekoodi arendusse.

VERSION=%0 (versioon %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Kõik õigused kaitstud.

; Kui soovite oma tõlke eest programmi mainimist, siis lihtsalt
; muutke välja LANGUAGE ja täitke väli TRANSLATOR. :-)

LANGUAGE=Eesti
TRANSLATOR=

THANKS=Eriline tänu kasutajale %0 %1 keele tõlgete pakkumise eest.

; Selles mängus on väga vähe teksti ja palju tühja ekraanipinda. Seetõttu
; kasutab see vaikimisi suuremat 12x14 inglise fonti. Selles fondis täidab
; HINT-rida peaaegu kogu ekraani laiuse. Teiste keelte puhul on aga suurimad
; fondid 10x12 või 8x16. Need keelespetsiifilised fondid leiate FD-NLS-ist
; kataloogist "danger".

LEVEL=Järjestus
TRIES=Katsed
START=klõpsa või vajuta klahvi
DEATH=vale
GAMEOVER=mäng läbi

; Kui teie HINT-tõlge on palju pikem, lõigatakse see tõenäoliselt lühemaks.
; Kaaluge viite tegemata jätmist numbriklaviatuurile. Võib-olla tõlkige
; see lihtsalt kui "kasuta nooleklahve või hiirt".

HINT=kasuta nooleklahve, numbriklaviatuuri või hiirt

ERROR.MOUSE=hiirt ei leitud. See on tõesti vajalik.
ERROR.VIDEO=sobivat graafikadraiverit ei leitud

ERROR.DRIVER.FIND=draiverit %0 ei leitud
ERROR.DRIVER.INIT=draiverit %0 ei õnnestunud algatada
ERROR.DRIVER.MODE=graafikadraiveri %0 režiimi %1 avamine

ERROR.NOHELP=abi pole saadaval
ERROR.FORMAT=faili %0 vormingut ei tuvastatud

; Võimalikud on paljud teised veateated/koodid. Kuid need peaksid esinema
; harva. Seetõttu on enamik neist välja jäetud. Allesjäänud peaksid esinema
; tegelikult ainult "Debug" režiimis kompileerimisel.

ERROR.1=vigane funktsioon
ERROR.2=faili ei leitud
ERROR.3=teed ei leitud
ERROR.4=liiga palju avatud faile
ERROR.5=failile juurdepääs keelatud
ERROR.8=mälu on otsas
ERROR.201=andmevahemiku kontroll
ERROR.202=pinu ületäitumine (stack overflow)
ERROR.203=mälu ületäitumine
ERROR.204=viida (pointer) operatsioon
ERROR.220=andmetüübi kontroll
ERROR.221=toetamata operatsioon
ERROR.222=vigane failivorming
ERROR.223=struktuur on liiga suur
ERROR.224=andmete kontrollimine
ERROR.225=määramata viit
ERROR.226=vabasta lukustatud ressurss
ERROR.227=pakitud pildi viga
ERROR.230=algatamise tõrge
ERROR.231=valesti joondatud draiver
ERROR.232=toetamata draiveri tüüp
ERROR.233=vigane draiveri tüüp
ERROR.234=draiveri kontrollimine
ERROR.240=graafikadraiveri tõrge
ERROR.241=helidraiveri tõrge
ERROR.242=klaviatuuridraiveri tõrge
ERROR.243=hiiredraiveri tõrge
ERROR.244=juhtkangi draiveri tõrge

