; Language: Lithuanian (lt)
; File ending: lt
; Codepage: 775
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Kai tik pagrindinis šios programos tekstas bus paruoštas, šie specifiniai
; kalbų failai bus pašalinti iš šio projekto ir perkelti į FD-NLS vertimo
; projektą. Vertimai ar pataisymai yra laukiami. Tačiau jie nebus tiesiogiai
; įtraukti į šio projekto pradinio kodo kūrimą.

VERSION=%0 (versija %1)
LICENSE=BSD 3-Clause licencija
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Visos teisės saugomos.

; Jei norite, kad už jūsų vertimą programoje būtų parodyta padėka, tiesiog
; redaguokite lauką LANGUAGE ir užpildykite lauką TRANSLATOR. :-)

LANGUAGE=Lietuvių
TRANSLATOR=

THANKS=Ypatingas ačiū %0 už pateiktus %1 kalbos vertimus.

; Šiame žaidime yra labai mažai teksto ir daug tuščios ekrano vietos. Todėl
; pagal numatytuosius nustatymus naudojamas didesnis 12x14 anglų kalbos šriftas.
; Naudojant šį šriftą, HINT eilutė užima beveik visą ekrano plotį. Tačiau kitoms
; kalboms didžiausi šriftai yra 10x12 arba 8x16. Šiuos specifinius kalbų šriftus
; galite rasti FD-NLS, "danger" kataloge.

LEVEL=Seka
TRIES=Bandymai
START=spustelėkite arba paspauskite klavišą
DEATH=neteisinga
GAMEOVER=žaidimas baigtas

; Jei jūsų HINT vertimas yra daug ilgesnis, jis tikriausiai bus apkarpytas.
; Apsvarstykite galimybę praleisti nuorodą į skaičių klaviatūrą. Galbūt tiesiog
; išverskite tai kaip "naudokite rodyklių klavišus arba pelę".

HINT=naudokite rodykles, skaičių klaviatūrą arba pelę

ERROR.MOUSE=nepavyko rasti pelės. Ji yra tikrai būtina.
ERROR.VIDEO=nepavyko rasti tinkamos vaizdo tvarkyklės

ERROR.DRIVER.FIND=nepavyko rasti %0 tvarkyklės
ERROR.DRIVER.INIT=nepavyko inicijuoti %0 tvarkyklės
ERROR.DRIVER.MODE=atidaroma vaizdo tvarkyklė %0 režimu %1

ERROR.NOHELP=pagalba neprieinama
ERROR.FORMAT=nepavyko atpažinti %0 failo formato

; Galimi ir kiti klaidų pranešimai/kodai. Tačiau jie turėtų pasitaikyti retai.
; Todėl dauguma jų buvo praleisti. Iš likusių, jie turėtų pasitaikyti tik tada,
; kai programa sukompiliuota "Debug" režimu.

ERROR.1=neteisinga funkcija
ERROR.2=failas nerastas
ERROR.3=kelias nerastas
ERROR.4=per daug atidarytų failų
ERROR.5=prieiga prie failo uždrausta
ERROR.8=trūksta atminties
ERROR.201=duomenų intervalo tikrinimas
ERROR.202=steko perpildymas (stack overflow)
ERROR.203=atminties perpildymas
ERROR.204=operacija su rodikliu
ERROR.220=duomenų tipo tikrinimas
ERROR.221=nepalaikoma operacija
ERROR.222=neteisingas failo formatas
ERROR.223=struktūra per didelė
ERROR.224=duomenų patikra
ERROR.225=nepriskirtas rodiklis
ERROR.226=atlaisvinti užrakintą išteklių
ERROR.227=suspausto vaizdo klaida
ERROR.230=inicijavimo klaida
ERROR.231=netinkamai suderinta tvarkyklė
ERROR.232=nepalaikomas tvarkyklės tipas
ERROR.233=neteisingas tvarkyklės tipas
ERROR.234=tvarkyklės patikra
ERROR.240=vaizdo tvarkyklės gedimas
ERROR.241=garso tvarkyklės gedimas
ERROR.242=klaviatūros tvarkyklės gedimas
ERROR.243=pelės tvarkyklės gedimas
ERROR.244=žaidimų svirties tvarkyklės gedimas

