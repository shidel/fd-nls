; Language: Esperanto (eo)
; File ending: eo
; Codepage: 853
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Kiam la ĉefa teksto por ĉi tiu programo estos preta, ĉi tiuj lingvospecifaj
; dosieroj estos forigitaj el ĉi tiu projekto kaj movitaj al la tradukprojekto
; FD-NLS. Tradukoj aŭ korektoj estas bonvenaj. Tamen ili ne estos akceptitaj
; rekte en la fontkodan evoluigon de ĉi tiu projekto.

VERSION=%0 (versio %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Ĉiuj rajtoj rezervitaj.

; Se vi volas krediton por via traduko montrata en la programo, simple
; redaktu la kampon LANGUAGE kaj plenigu la kampon TRANSLATOR. :-)

LANGUAGE=Esperanto
TRANSLATOR=

THANKS=Specialan dankon al %0 pro la disponigo de la %1 lingvaj tradukoj.

; Ĉi tiu ludo havas tre malmulte da teksto kaj multe da malplena ekrana spaco.
; Tial ĝi uzas pli grandan 12x14 anglan tiparon defaŭlte. En tiu tiparo, la
; HINT-linio okupas la plej grandan parton de la larĝo de la ekrano. Tamen, por
; aliaj lingvoj la plej grandaj tiparoj estas 10x12 aŭ 8x16. Vi povas trovi tiujn
; lingvospecifajn tiparojn ĉe FD-NLS sub la dosierujo "danger".

LEVEL=Sekvenco
TRIES=Provoj
START=alklaku aŭ premu klavon
DEATH=malĝusta
GAMEOVER=ludo finita

; Se via HINT-traduko estas multe pli longa, ĝi verŝajne estos detranĉita.
; Konsideru preterlasi la referencon al la cifera klavaro. Eble nur traduku
; ĝin kiel "uzu sagoklavojn aŭ muson".

HINT=uzu sagoklavojn, ciferan klavaron aŭ muson

ERROR.MOUSE=ne eblas trovi la muson. Ĝi estas vere necesa.
ERROR.VIDEO=ne eblas trovi taŭgan grafikan pelilon

ERROR.DRIVER.FIND=ne eblas trovi pelilon %0
ERROR.DRIVER.INIT=ne eblas pravalorigi pelilon %0
ERROR.DRIVER.MODE=malfermo de grafika pelilo %0 reĝimo %1

ERROR.NOHELP=helpo ne disponeblas
ERROR.FORMAT=ne eblis rekoni formaton de dosiero %0

; Ekzistas multaj aliaj eblaj erarmesaĝoj/kodoj. Sed tiuj malofte (se entute)
; okazas. Do, la plej multaj estis preterlasitaj. El la restintaj, ili vere
; devus okazi nur kiam kompilitaj en reĝimo "Debug".

ERROR.1=nevalida funkcio
ERROR.2=dosiero ne trovita
ERROR.3=vojo ne trovita
ERROR.4=tro da malfermitaj dosieroj
ERROR.5=aliro al dosiero rifuzita
ERROR.8=memoro elĉerpita
ERROR.201=kontrolo de datuma gamo
ERROR.202=staka troo
ERROR.203=memora troo
ERROR.204=referenca operacio
ERROR.220=kontrolo de datuma tipo
ERROR.221=nesubtenata operacio
ERROR.222=nevalida dosierformato
ERROR.223=strukturo tro granda
ERROR.224=konfirmo de datumoj
ERROR.225=neasignita referenco
ERROR.226=forigi ŝlositan eron
ERROR.227=eraro de densigita bildo
ERROR.230=malsukceso de pravalorigo
ERROR.231=misliniigita pelilo
ERROR.232=nesubtenata peliltipo
ERROR.233=nevalida peliltipo
ERROR.234=pelila konfirmo
ERROR.240=fiasko de grafika pelilo
ERROR.241=fiasko de sona pelilo
ERROR.242=fiasko de klavara pelilo
ERROR.243=fiasko de musa pelilo
ERROR.244=fiasko de stirstanga pelilo

