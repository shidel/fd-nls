; Language: Slovenian (sl)
; File ending: sl
; Codepage: 852
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Ko bo glavni tekst za ta program pripravljen, bodo te jezikovno specifične
; datoteke odstranjene iz tega projekta in prestavljene v prevajalski projekt
; FD-NLS. Prevodi ali popravki so dobrodošli. Vendar ne bodo sprejeti
; neposredno v razvoj izvorne kode tega projekta.

VERSION=%0 (različica %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Vse pravice pridržane.

; Če želite zasluge za vaš prevod, ki je prikazan v programu, preprosto
; uredite polje LANGUAGE in izpolnite polje TRANSLATOR. :-)

LANGUAGE=Slovenščina
TRANSLATOR=

THANKS=Posebna zahvala %0 za zagotovitev prevodov v %1 jezik.

; Ta igra ima zelo malo besedila in veliko praznega prostora na zaslonu. Zato
; privzeto uporablja večjo angleško pisavo 12x14. V tej pisavi vrstica HINT
; zavzame večino širine zaslona. Za druge jezike pa so največje pisave 10x12
; ali 8x16. Te jezikovno specifične pisave najdete na FD-NLS v mapi "danger".

LEVEL=Zaporedje
TRIES=Poskusi
START=kliknite ali pritisnite tipko
DEATH=nepravilno
GAMEOVER=konec igre

; Če je vaš prevod HINT veliko daljši, bo verjetno skrajšan. Razmislite o
; opustitvi sklica na numerično tipkovnico. Morda ga prevedite le kot
; "uporabite smerne tipke ali miško".

HINT=uporabite smerne tipke, številčnico ali miško

ERROR.MOUSE=miške ni mogoče najti. Je res nujno potrebna.
ERROR.VIDEO=ni mogoče najti primernega grafičnega gonilnika

ERROR.DRIVER.FIND=gonilnika %0 ni mogoče najti
ERROR.DRIVER.INIT=gonilnika %0 ni mogoče inicializirati
ERROR.DRIVER.MODE=odpiranje grafičnega gonilnika %0 način %1

ERROR.NOHELP=pomoč ni na voljo
ERROR.FORMAT=ni mogoče prepoznati formata datoteke %0

; Možna so številna druga sporočila/kode o napakah. Vendar naj bi se ta
; redko pojavljala. Zato je bila večina izpuščena. Od tistih, ki so ostala,
; naj bi se dejansko pojavila le pri prevajanju v načinu "Debug".

ERROR.1=neveljavna funkcija
ERROR.2=datoteke ni mogoče najti
ERROR.3=poti ni mogoče najti
ERROR.4=preveč odprtih datotek
ERROR.5=dostop do datoteke zavrnjen
ERROR.8=zmanjkalo pomnilnika
ERROR.201=preverjanje obsega podatkov
ERROR.202=prekoračitev sklada (stack overflow)
ERROR.203=prekoračitev pomnilnika
ERROR.204=operacija s kazalcem
ERROR.220=preverjanje tipa podatkov
ERROR.221=nepodprta operacija
ERROR.222=neveljaven format datoteke
ERROR.223=struktura je prevelika
ERROR.224=preverjanje podatkov
ERROR.225=nedodeljen kazalec
ERROR.226=sproščanje zaklenjenega sredstva
ERROR.227=napaka stisnjene slike
ERROR.230=napaka pri inicializaciji
ERROR.231=nepravilno poravnan gonilnik
ERROR.232=nepodprta vrsta gonilnika
ERROR.233=neveljavna vrsta gonilnika
ERROR.234=preverjanje gonilnika
ERROR.240=napaka grafičnega gonilnika
ERROR.241=napaka zvočnega gonilnika
ERROR.242=napaka gonilnika tipkovnice
ERROR.243=napaka gonilnika miške
ERROR.244=napaka gonilnika igralne palice

