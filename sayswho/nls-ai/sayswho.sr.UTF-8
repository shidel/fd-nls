; Language: Serbian (sr)
; File ending: sr
; Codepage: 855
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Када главни текст за овај програм буде спреман, ове језички специфичне
; датотеке ће бити уклоњене из овог пројекта и премештене у FD-NLS пројекат
; превођења. Преводи или исправке су добродошли. Међутим, они неће бити
; прихваћени директно у развој изворног кода овог пројекта.

VERSION=%0 (верзија %1)
LICENSE=BSD 3-Clause лиценца
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Сва права задржана.

; Ако желите заслуге за ваш превод приказан у програму, једноставно
; уредите поље LANGUAGE и попуните поље TRANSLATOR. :-)

LANGUAGE=Српски
TRANSLATOR=

THANKS=Посебна захвалност %0 за пружање превода на %1 језик.

; Ова игра има врло мало текста и много празног простора на екрану. Зато
; подразумевано користи већи енглески фонт 12x14. У том фонту, линија HINT
; заузима скоро целу ширину екрана. Међутим, за друге језике највећи фонтови
; су 10x12 или 8x16. Ове фонтове можете пронаћи на FD-NLS у директоријуму
; "danger".

LEVEL=Секвенца
TRIES=Покушаји
START=кликните или притисните тастер
DEATH=неисправно
GAMEOVER=крај игре

; Ако је ваш превод HINT много дужи, вероватно ће бити одсечен. Размислите о
; изостављању помињања нумеричке тастатуре. Можда то само преведите као
; "користите тастере са стрелицама или миш".

HINT=користите стрелице, нумеричку тастатуру или миш

ERROR.MOUSE=није могуће пронаћи миша. Он је заиста неопходан.
ERROR.VIDEO=није могуће пронаћи одговарајући графички драјвер

ERROR.DRIVER.FIND=није могуће лоцирати драјвер %0
ERROR.DRIVER.INIT=није могуће иницијализовати драјвер %0
ERROR.DRIVER.MODE=отварање графичког драјвера %0 режим %1

ERROR.NOHELP=помоћ није доступна
ERROR.FORMAT=није могуће препознати формат датотеке %0

; Могуће су бројне друге поруке/кодови грешака. Али они би требало да се
; ретко појављују. Зато је већина изостављена. Од преосталих, они би заиста
; требало да се појаве само када се преводи у "Debug" режиму.

ERROR.1=неважећа функција
ERROR.2=датотека није пронађена
ERROR.3=путања није пронађена
ERROR.4=превише отворених датотека
ERROR.5=приступ датотеци одбијен
ERROR.8=недостатак меморије
ERROR.201=провера опсега података
ERROR.202=прекорачење стека
ERROR.203=прекорачење меморије
ERROR.204=операција са показивачем
ERROR.220=провера типа података
ERROR.221=неподржана операција
ERROR.222=неважећи формат датотеке
ERROR.223=структура је превелика
ERROR.224=верификација података
ERROR.225=недодељен показивач
ERROR.226=ослобађање закључаног ресурса
ERROR.227=грешка код компримоване слике
ERROR.230=неуспех иницијализације
ERROR.231=лоше поравнат драјвер
ERROR.232=неподржани тип драјвера
ERROR.233=неважећи тип драјвера
ERROR.234=верификација драјвера
ERROR.240=отказ графичког драјвера
ERROR.241=отказ аудио драјвера
ERROR.242=отказ драјвера тастатуре
ERROR.243=отказ драјвера миша
ERROR.244=отказ драјвера џојстика

