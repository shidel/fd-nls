; Language: Latvian (lv)
; File ending: lv
; Codepage: 775
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Tiklīdz šīs programmas galvenais teksts būs gatavs, šie valodai specifiskie
; faili tiks izņemti no šī projekta un pārvietoti uz FD-NLS tulkošanas projektu.
; Tulkojumi vai labojumi ir laipni gaidīti. Tomēr tie netiks pieņemti tieši
; šī projekta pirmkoda izstrādē.

VERSION=%0 (versija %1)
LICENSE=BSD 3-Clause licence
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Visas tiesības aizsargātas.

; Ja vēlaties, lai programmā tiktu parādīta pateicība par jūsu tulkojumu,
; vienkārši rediģējiet lauku LANGUAGE un aizpildiet lauku TRANSLATOR. :-)

LANGUAGE=Latviešu
TRANSLATOR=

THANKS=Īpašs paldies %0 par %1 valodas tulkojumu nodrošināšanu.

; Šajā spēlē ir ļoti maz teksta un daudz tukšas ekrāna vietas. Tāpēc pēc
; noklusējuma tajā tiek izmantots lielāks 12x14 angļu valodas fonts. Šajā fontā
; HINT rinda aizņem gandrīz visu ekrāna platumu. Tomēr citām valodām lielākie
; fonti ir 10x12 vai 8x16. Šos valodai specifiskos fontus varat atrast FD-NLS
; direktorijā "danger".

LEVEL=Secība
TRIES=Mēģinājumi
START=noklikšķiniet vai nospiediet taustiņu
DEATH=nepareizi
GAMEOVER=spēle beigusies

; Ja jūsu HINT tulkojums ir daudz garāks, tas, visticamāk, tiks apgriezts.
; Apsveriet iespēju neiekļaut atsauci uz ciparu tastatūru. Varbūt vienkārši
; tulkojiet to kā "izmantojiet bultiņu taustiņus vai peli".

HINT=izmantojiet bultiņas, ciparu tastatūru vai peli

ERROR.MOUSE=nevar atrast peli. Tā ir tiešām nepieciešama.
ERROR.VIDEO=nevar atrast piemērotu grafikas draiveri

ERROR.DRIVER.FIND=nevar atrast %0 draiveri
ERROR.DRIVER.INIT=nevar inicializēt %0 draiveri
ERROR.DRIVER.MODE=atver grafikas draivera %0 režīmu %1

ERROR.NOHELP=palīdzība nav pieejama
ERROR.FORMAT=neizdevās atpazīt %0 faila formātu

; Ir iespējami daudzi citi kļūdu ziņojumi/kodi. Bet tiem vajadzētu parādīties
; reti. Tāpēc lielākā daļa ir izlaista. No atlikušajiem tiem vajadzētu parādīties
; tikai tad, ja programma ir kompilēta "Debug" režīmā.

ERROR.1=nederīga funkcija
ERROR.2=fails nav atrasts
ERROR.3=ceļš nav atrasts
ERROR.4=pārāk daudz atvērtu failu
ERROR.5=piekļuve failam liegta
ERROR.8=atmiņa beigusies
ERROR.201=datu diapazona pārbaude
ERROR.202=steka pārpilde (stack overflow)
ERROR.203=atmiņas pārpilde
ERROR.204=rādītāja (pointer) operācija
ERROR.220=datu tipa pārbaude
ERROR.221=neatbalstīta darbība
ERROR.222=nederīgs faila formāts
ERROR.223=struktūra ir pārāk liela
ERROR.224=datu pārbaude
ERROR.225=nepiešķirts rādītājs
ERROR.226=atbrīvot bloķētu resursu
ERROR.227=saspiesta attēla kļūda
ERROR.230=inicializācijas kļūme
ERROR.231=nepareizi izlīdzināts draiveris
ERROR.232=neatbalstīts draivera veids
ERROR.233=nederīgs draivera veids
ERROR.234=draivera pārbaude
ERROR.240=grafikas draivera kļūme
ERROR.241=audio draivera kļūme
ERROR.242=tastatūras draivera kļūme
ERROR.243=peles draivera kļūme
ERROR.244=kursorsviras draivera kļūme

