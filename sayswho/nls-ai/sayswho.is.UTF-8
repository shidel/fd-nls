; Þegar aðaltexti þessa forrits er tilbúinn verða þessar tungumálasértæku
; skrár fjarlægðar úr þessu verkefni og færðar í FD-NLS þýðingarverkefnið.
; Þýðingar eða leiðréttingar eru velkomnar. Þær verða hins vegar ekki
; teknar beint inn í þróun frumkóða þessa verkefnis.

VERSION=%0 (útgáfa %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Allur réttur áskilinn.

; Ef Þér óskið eftir að nafn Yðar komi fram við þýðinguna í forritinu,
; breytið þá einfaldlega LANGUAGE reitnum og fyllið út TRANSLATOR reitinn. :-)

LANGUAGE=Íslenska
TRANSLATOR=

THANKS=Sérstakar þakkir til %0 fyrir að útvega þýðingar á %1.

; Þessi leikur hefur mjög lítinn texta og mikið autt pláss á skjánum. Því
; notar hann stærra 12x14 enskt letur sjálfgefið. Í því letri tekur HINT
; línan mestalla breidd skjásins. Fyrir önnur tungumál er stærsta letrið
; hins vegar 10x12 eða 8x16. Þér getið fundið þessi letur á FD-NLS undir
; "danger" möppunni.

LEVEL=Röð
TRIES=Tilraunir
START=smelltu eða ýttu á takka
DEATH=rangt
GAMEOVER=leik lokið

; Ef HINT þýðing Yðar er mikið lengri verður hún sennilega klippt af.
; Íhugið að sleppa tilvísun í talnaborðið. Kannski þýða það bara sem
; "notaðu örvatakka eða mús".

HINT=notaðu örvatakka, talnaborð eða mús

ERROR.MOUSE=fann ekki músina. Hún er bráðnauðsynleg.
ERROR.VIDEO=fann engan viðeigandi rekil fyrir skjástýringu

ERROR.DRIVER.FIND=fann ekki rekilinn %0
ERROR.DRIVER.INIT=tókst ekki að ræsa rekilinn %0
ERROR.DRIVER.MODE=opna skjárekil %0 ham %1

ERROR.NOHELP=hjálp ekki tiltæk
ERROR.FORMAT=gat ekki greint snið skrárinnar %0

; Fjöldi annarra villuskilaboða er mögulegur, en þau ættu sjaldan að koma
; fyrir. Því hefur flestum verið sleppt. Þau sem eftir eru ættu í raun
; aðeins að koma fyrir þegar forritið er þýtt í "Debug" ham.

ERROR.1=ógild aðgerð
ERROR.2=skrá fannst ekki
ERROR.3=slóð fannst ekki
ERROR.4=of margar opnar skrár
ERROR.5=aðgangi að skrá hafnað
ERROR.8=minni búið
ERROR.201=athugun á gagnasviði
ERROR.202=hlaðayfirflæði
ERROR.203=minnisyfirflæði
ERROR.204=bendiaðgerð
ERROR.220=athugun á gagnagerð
