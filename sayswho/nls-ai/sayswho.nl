; Language: Dutch (nl)
; File ending: nl
; Codepage: 850
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Zodra de hoofdtekst voor dit programma gereed is, zullen deze
; taalspecifieke bestanden uit dit project worden verwijderd en verplaatst
; naar het FD-NLS vertaalproject. Vertalingen of correcties zijn welkom.
; Ze zullen echter niet direct in de broncode-ontwikkeling van dit
; project worden opgenomen.

VERSION=%0 (versie %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Alle rechten voorbehouden.

; Als u vermeld wilt worden voor uw vertaling in het programma, bewerk dan
; gewoon het veld LANGUAGE en vul het veld TRANSLATOR in. :-)

LANGUAGE=Nederlands
TRANSLATOR=

THANKS=Met speciale dank aan %0 voor het leveren van de %1 vertalingen.

; Dit spel heeft weinig tekst en veel lege schermruimte. Daarom gebruikt het
; standaard een groter 12x14 Engels lettertype. In dat lettertype neemt de
; HINT-regel bijna de volledige breedte van het scherm in beslag. Voor andere
; talen zijn de grootste lettertypen echter 10x12 of 8x16. U kunt deze
; taalspecifieke lettertypen vinden op FD-NLS onder de map "danger".

LEVEL=Reeks
TRIES=Pogingen
START=klik of druk op een toets
DEATH=onjuist
GAMEOVER=game over

; Als uw HINT-vertaling veel langer is, zal deze waarschijnlijk worden
; afgekapt. Overweeg om de verwijzing naar het numeriek toetsenbord weg te
; laten. Misschien kunt u het vertalen als "gebruik pijltjestoetsen of muis".

HINT=gebruik pijltjestoetsen, numeriek toetsenbord of muis

ERROR.MOUSE=kan de muis niet vinden. Deze is echt nodig.
ERROR.VIDEO=kan geen geschikte grafische driver vinden

ERROR.DRIVER.FIND=kan driver %0 niet vinden
ERROR.DRIVER.INIT=kan driver %0 niet initialiseren
ERROR.DRIVER.MODE=bezig met openen grafische driver %0 modus %1

ERROR.NOHELP=help niet beschikbaar
ERROR.FORMAT=kon het formaat van bestand %0 niet herkennen

; Er zijn tal van andere foutmeldingen/codes mogelijk. Maar deze zouden
; zelden moeten voorkomen. Daarom zijn de meeste weggelaten. Van de
; overgebleven meldingen zouden ze eigenlijk alleen mogen voorkomen bij
; compilatie in "Debug" modus.

ERROR.1=ongeldige functie
ERROR.2=bestand niet gevonden
ERROR.3=pad niet gevonden
ERROR.4=te veel open bestanden
ERROR.5=toegang tot bestand geweigerd
ERROR.8=onvoldoende geheugen
ERROR.201=controle gegevensbereik
ERROR.202=stack overflow
ERROR.203=geheugenoverloop
ERROR.204=pointer-bewerking
ERROR.220=controle gegevenstype
ERROR.221=niet-ondersteunde bewerking
ERROR.222=ongeldig bestandsformaat
ERROR.223=structuur te groot
ERROR.224=gegevensverificatie
ERROR.225=niet-toegewezen pointer
ERROR.226=verwijder vergrendeld item
ERROR.227=fout in gecomprimeerde afbeelding
ERROR.230=initialisatiefout
ERROR.231=verkeerd uitgelijnde driver
ERROR.232=niet-ondersteund drivertype
ERROR.233=ongeldig drivertype
ERROR.234=driververificatie
ERROR.240=fout in grafische driver
ERROR.241=fout in audiodriver
ERROR.242=fout in toetsenborddriver
ERROR.243=fout in muisdriver
ERROR.244=fout in joystickdriver

