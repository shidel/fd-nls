; Language: Polish (pl)
; File ending: pl
; Codepage: 852
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Gdy tekst główny tego programu będzie gotowy, te pliky językowe zostaną
; usunięte z projektu i przeniesione do projektu tłumaczeń FD-NLS. Tłumaczenia
; lub poprawki są mile widziane. Nie zostaną one jednak przyjęte bezpośrednio
; do prac nad kodem źródłowym tego projektu.

VERSION=%0 (wersja %1)
LICENSE=Licencja BSD 3-Clause
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Wszelkie prawa zastrzeżone.

; Jeśli chcesz, aby informacja o Twoim tłumaczeniu pojawiła się w programie,
; po prostu edytuj pole LANGUAGE i wypełnij pole TRANSLATOR. :-)

LANGUAGE=Polski
TRANSLATOR=

THANKS=Specjalne podziękowania dla %0 za dostarczenie tłumaczeń na język %1.

; Ta gra ma bardzo mało tekstu i dużo wolnego miejsca na ekranie. Dlatego
; domyślnie używa większej angielskiej czcionki 12x14. W tej czcionce linia
; HINT zajmuje większość szerokości ekranu. Jednak dla innych języków
; największe czcionki to 10x12 lub 8x16. Te specyficzne dla języka czcionki
; można znaleźć w FD-NLS w katalogu "danger".

LEVEL=Sekwencja
TRIES=Próby
START=kliknij lub naciśnij klawisz
DEATH=nieprawidłowo
GAMEOVER=koniec gry

; Jeśli Twoje tłumaczenie HINT jest znacznie dłuższe, prawdopodobnie zostanie
; przycięte. Rozważ pominięcie wzmianki o klawiaturze numerycznej. Może po
; prostu przetłumacz to jako "użyj strzałek lub myszy".

HINT=użyj strzałek, klawiatury numerycznej lub myszy

ERROR.MOUSE=nie można znaleźć myszy. Jest ona naprawdę niezbędna.
ERROR.VIDEO=nie można znaleźć odpowiedniego sterownika karty graficznej

ERROR.DRIVER.FIND=nie można zlokalizować sterownika %0
ERROR.DRIVER.INIT=nie można zainicjować sterownika %0
ERROR.DRIVER.MODE=otwieranie sterownika graficznego %0 tryb %1

ERROR.NOHELP=pomoc niedostępna
ERROR.FORMAT=nie można rozpoznać formatu pliku %0

; Możliwych jest wiele innych komunikatów/kodów błędów. Powinny one jednak
; występować rzadko. Większość została więc pominięta. Te, które pozostały,
; powinny właściwie wystąpić tylko podczas kompilacji w trybie "Debug".

ERROR.1=nieprawidłowa funkcja
ERROR.2=nie znaleziono pliku
ERROR.3=nie znaleziono ścieżki
ERROR.4=zbyt wiele otwartych plików
ERROR.5=odmowa dostępu do pliku
ERROR.8=brak pamięci
ERROR.201=kontrola zakresu danych
ERROR.202=przepełnienie stosu
ERROR.203=przepełnienie pamięci
ERROR.204=operacja na wskaźniku
ERROR.220=kontrola typu danych
ERROR.221=nieobsługiwana operacja
ERROR.222=nieprawidłowy format pliku
ERROR.223=struktura zbyt duża
ERROR.224=weryfikacja danych
ERROR.225=nieprzypisany wskaźnik
ERROR.226=zwolnij zablokowany zasób
ERROR.227=błąd skompresowanego obrazu
ERROR.230=błąd inicjalizacji
ERROR.231=źle wyrównany sterownik
ERROR.232=nieobsługiwany typ sterownika
ERROR.233=nieprawidłowy typ sterownika
ERROR.234=weryfikacja sterownika
ERROR.240=awaria sterownika graficznego
ERROR.241=awaria sterownika dźwięku
ERROR.242=awaria sterownika klawiatury
ERROR.243=awaria sterownika myszy
ERROR.244=awaria sterownika joysticka

