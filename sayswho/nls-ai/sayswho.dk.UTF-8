; Language: Danish (dk)
; File ending: dk
; Codepage: 865
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Når hovedteksten til dette program er klar, vil disse sprogspecifikke
; filer blive fjernet fra dette projekt og flyttet til FD-NLS-projektet.
; Oversættelser eller rettelser er velkomne. De vil dog ikke blive
; accepteret direkte i kildekodeudviklingen af dette projekt.

VERSION=%0 (version %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Alle rettigheder forbeholdes.

; Hvis De ønsker kredit for Deres oversættelse vist i programmet, skal De
; blot redigere feltet LANGUAGE og udfylde feltet TRANSLATOR. :-)

LANGUAGE=Dansk
TRANSLATOR=

THANKS=Særlig tak til %0 for at levere %1 sprogoversættelser.

; Dette spil har meget lidt tekst og meget tom skærmplads. Derfor bruger det
; som standard en større 12x14 engelsk skrifttype. I den skrifttype optager
; HINT-linjen det meste af skærmens bredde. For andre sprog er de største
; skrifttyper dog 10x12 eller 8x16. De kan finde disse sprogspecifikke
; skrifttyper på FD-NLS under "danger"-mappen.

LEVEL=Sekvens
TRIES=Forsøg
START=klik eller tryk på en tast
DEATH=forkert
GAMEOVER=spillet er slut

; Hvis Deres HINT-oversættelse er meget længere, vil den sandsynligvis blive
; beskåret. Overvej at udelade referencen til det numeriske tastatur.
; Måske bare oversætte det som "brug piletaster eller mus".

HINT=brug piletaster, numerisk tastatur eller mus

ERROR.MOUSE=kunne ikke finde musen. Den er absolut nødvendig.
ERROR.VIDEO=kunne ikke finde nogen egnet grafikdriver

ERROR.DRIVER.FIND=kunne ikke finde %0-driver
ERROR.DRIVER.INIT=kunne ikke initialisere %0-driver
ERROR.DRIVER.MODE=åbner grafikdriver %0 tilstand %1

ERROR.NOHELP=hjælp ikke tilgængelig
ERROR.FORMAT=kunne ikke genkende formatet på fil %0

; Der er talrige andre fejlmeddelelser/koder mulige. Men disse bør sjældent
; forekomme. Derfor er de fleste udeladt. De resterende bør egentlig kun
; forekomme, når der kompileres i "Debug"-tilstand.

ERROR.1=ugyldig funktion
ERROR.2=fil ikke fundet
ERROR.3=sti ikke fundet
ERROR.4=for mange åbne filer
ERROR.5=filadgang nægtet
ERROR.8=hukommelse opbrugt
ERROR.201=kontrol af datainterval
ERROR.202=stack overflow
ERROR.203=hukommelsesoverløb
ERROR.204=pointer-operation
ERROR.220=kontrol af datatype
ERROR.221=ikke-understøttet handling
ERROR.222=ugyldigt filformat
ERROR.223=struktur for stor
ERROR.224=dataverificering
ERROR.225=ikke-tildelt pointer
ERROR.226=frigørelse af låst aktiv
ERROR.227=fejl i komprimeret billede
ERROR.230=initialiseringsfejl
ERROR.231=fejljusteret driver
ERROR.232=ikke-understøttet drivertype
ERROR.233=ugyldig drivertype
ERROR.234=driververificering
ERROR.240=grafikdriver-fejl
ERROR.241=lyddriver-fejl
ERROR.242=tastaturdriver-fejl
ERROR.243=musedriver-fejl
ERROR.244=joystickdriver-fejl

