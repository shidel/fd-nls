; Assim que o texto principal deste programa estiver pronto, estes arquivos
; específicos de cada idioma serão removidos deste projeto e movidos para o
; projeto de tradução FD-NLS. Traduções ou correções são bem-vindas. No entanto,
; não serão aceitas diretamente no desenvolvimento do código-fonte deste projeto.

VERSION=%0 (versão %1)
LICENSE=Licença BSD 3-Clause
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Todos os direitos reservados.

; Se você quiser crédito pela sua tradução exibida no programa, basta
; editar o campo LANGUAGE e preencher o campo TRANSLATOR. :-)

LANGUAGE=Português do Brasil
TRANSLATOR=

THANKS=Agradecimentos especiais a %0 por fornecer as traduções para o idioma %1.

; Este jogo tem muito pouco texto e muito espaço vazio na tela. Portanto,
; ele usa uma fonte em inglês 12x14 maior por padrão. E nessa fonte, a
; linha HINT ocupa a maior parte da largura da tela. No entanto, para outros
; idiomas as maiores fontes são 10x12 ou 8x16. Você pode encontrar essas fontes
; específicas de cada idioma no FD-NLS no diretório "danger".

LEVEL=Sequência
TRIES=Tentativas
START=clique ou pressione uma tecla
DEATH=incorreto
GAMEOVER=fim de jogo

; Se a sua tradução de HINT for muito mais longa, ela provavelmente será cortada.
; Considere deixar de fora a referência ao teclado numérico. Talvez traduza
; apenas como "use as setas ou o mouse"

HINT=use as setas, o teclado numérico ou o mouse

ERROR.MOUSE=não foi possível encontrar o mouse. Ele é realmente necessário.
ERROR.VIDEO=não foi possível encontrar um driver de vídeo adequado

ERROR.DRIVER.FIND=não foi possível localizar o driver %0
ERROR.DRIVER.INIT=não foi possível inicializar o driver %0
ERROR.DRIVER.MODE=abrindo driver de vídeo %0 modo %1

ERROR.NOHELP=ajuda não disponível
ERROR.FORMAT=não foi possível reconhecer o formato do arquivo %0

; Existem inúmeras outras mensagens/códigos de erro possíveis. Mas essas devem
; ocorrer raramente. Portanto, a maioria foi omitida. Das que restaram, elas
; só devem ocorrer quando compilado no modo "Debug". Eu provavelmente deveria
; omitir essas mensagens também.

ERROR.1=função inválida
ERROR.2=arquivo não encontrado
ERROR.3=caminho não encontrado
ERROR.4=muitos arquivos abertos
ERROR.5=acesso ao arquivo negado
ERROR.8=memória esgotada
ERROR.201=verificação de intervalo de dados
ERROR.202=estouro de pilha
ERROR.203=estouro de memória
ERROR.204=operação de ponteiro
ERROR.220=verificação de tipo de dados
ERROR.221=operação não suportada
ERROR.222=formato de arquivo inválido
ERROR.223=estrutura muito grande
ERROR.224=verificação de dados
ERROR.225=ponteiro não atribuído
ERROR.226=liberar recurso bloqueado
ERROR.227=erro de imagem comprimida
ERROR.230=falha de inicialização
ERROR.231=driver desalinhado
ERROR.232=tipo de driver não suportado
ERROR.233=tipo de driver inválido
ERROR.234=verificação do driver
ERROR.240=falha no driver de vídeo
ERROR.241=falha no driver de áudio
ERROR.242=falha no driver de teclado
ERROR.243=falha no driver de mouse
ERROR.244=falha no driver de joystick

