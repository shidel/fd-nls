; Language: Czech (cz)
; File ending: cz
; Codepage: 852
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Jakmile bude hotov hlavní text pro tento program, budou tyto jazykově
; specifické soubory z tohoto projektu odstraněny a přesunuty do překladatelského
; projektu FD-NLS. Překlady nebo opravy jsou vítány. Nebudou však přijaty
; přímo do vývoje zdrojového kódu tohoto projektu.

VERSION=%0 (verze %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Všechna práva vyhrazena.

; Pokud chcete uvést své jméno u překladu zobrazeného v programu, jednoduše
; upravte pole LANGUAGE a vyplňte pole TRANSLATOR. :-)

LANGUAGE=Čeština
TRANSLATOR=

THANKS=Zvláštní poděkování %0 za poskytnutí překladů do jazyka %1.

; Tato hra má velmi málo textu a hodně prázdného místa na obrazovce. Proto
; standardně používá větší anglické písmo 12x14. V tomto písmu zabírá řádek
; HINT většinu šířky obrazovky. Pro jiné jazyky jsou však největší písma
; 10x12 nebo 8x16. Tyto jazykově specifické fonty naleznete na FD-NLS v
; adresáři "danger".

LEVEL=Sekvence
TRIES=Pokusy
START=klikněte nebo stiskněte klávesu
DEATH=nesprávně
GAMEOVER=konec hry

; Pokud je váš překlad HINT mnohem delší, bude pravděpodobně oříznut. Zvažte
; vynechání odkazu na numerickou klávesnici. Možná jej přeložte jen jako
; "použijte šipky nebo myš".

HINT=použijte šipky, numerickou klávesnici nebo myš

ERROR.MOUSE=nepodařilo se najít myš. Je skutečně nezbytná.
ERROR.VIDEO=nepodařilo se najít žádný vhodný grafický ovladač

ERROR.DRIVER.FIND=nelze nalézt ovladač %0
ERROR.DRIVER.INIT=nelze inicializovat ovladač %0
ERROR.DRIVER.MODE=otevírání grafického ovladače %0 režim %1

ERROR.NOHELP=nápověda není k dispozici
ERROR.FORMAT=nepodařilo se rozpoznat formát souboru %0

; Je možných mnoho dalších chybových hlášení/kódů. Ty by se však měly vyskytovat
; jen zřídka. Proto byla většina vynechána. Z těch zbývajících by se měly
; skutečně vyskytnout pouze při kompilaci v režimu "Debug".

ERROR.1=neplatná funkce
ERROR.2=soubor nenalezen
ERROR.3=cesta nenalezena
ERROR.4=příliš mnoho otevřených souborů
ERROR.5=přístup k souboru odepřen
ERROR.8=nedostatek paměti
ERROR.201=kontrola rozsahu dat
ERROR.202=přetečení zásobníku
ERROR.203=přetečení paměti
ERROR.204=operace s ukazatelem
ERROR.220=kontrola datového typu
ERROR.221=nepodporovaná operace
ERROR.222=neplatný formát souboru
ERROR.223=struktura je příliš velká
ERROR.224=ověření dat
ERROR.225=nepřiřazený ukazatel
ERROR.226=uvolnění uzamčeného prostředku
ERROR.227=chyba komprimovaného obrazu
ERROR.230=chyba inicializace
ERROR.231=nesprávně zarovnaný ovladač
ERROR.232=nepodporovaný typ ovladače
ERROR.233=neplatný typ ovladače
ERROR.234=ověření ovladače
ERROR.240=selhání grafického ovladače
ERROR.241=selhání zvukového ovladače
ERROR.242=selhání ovladače klávesnice
ERROR.243=selhání ovladače myši
ERROR.244=selhání ovladače joysticku

