; Language: Ukrainian (uk)
; File ending: uk
; Codepage: 1125
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Як тільки основний текст програми буде готовий, ці мовні файли
; будуть видалені з цього проекту і перенесені до проекту перекладів FD-NLS.
; Переклади або виправлення вітаються. Проте вони не будуть прийняті
; безпосередньо в розробку вихідного коду цього проекту.

VERSION=%0 (версія %1)
LICENSE=Ліцензія BSD 3-Clause
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Усі права захищено.

; Якщо ви хочете, щоб ваше ім'я як перекладача згадувалося в програмі,
; просто відредагуйте поле LANGUAGE і заповніть поле TRANSLATOR. :-)

LANGUAGE=Українська
TRANSLATOR=

THANKS=Особлива подяка %0 за надання перекладів на %1 мову.

; У цій грі дуже мало тексту і багато порожнього місця на екрані. Тому
; за замовчуванням використовується більший англійський шрифт 12x14. У цьому
; шрифті рядок HINT займає майже всю ширину екрана. Однак для інших мов
; найбільші шрифти — це 10x12 або 8x16. Ви можете знайти ці шрифти
; у проекті FD-NLS у каталозі "danger".

LEVEL=Послідовність
TRIES=Спроби
START=клікніть або натисніть клавішу
DEATH=невірно
GAMEOVER=гру закінчено

; Якщо ваш переклад HINT набагато довший, він, швидше за все, буде обрізаний.
; Подумайте про те, щоб опустити згадку про цифрову клавіатуру. Можливо,
; просто перекладіть це як "використовуйте стрілки або мишу".

HINT=використовуйте стрілки, цифрову клавіатуру або мишу

ERROR.MOUSE=не вдалося знайти мишу. Вона дійсно необхідна.
ERROR.VIDEO=не вдалося знайти відповідний відеодрайвер

ERROR.DRIVER.FIND=не вдалося знайти драйвер %0
ERROR.DRIVER.INIT=не вдалося ініціалізувати драйвер %0
ERROR.DRIVER.MODE=відкриття відеодрайвера %0 режим %1

ERROR.NOHELP=довідка недоступна
ERROR.FORMAT=не вдалося розпізнати формат файлу %0

; Можливі численні інші повідомлення/коди помилок. Але вони повинні
; виникати рідко. Тому більшість із них було опущено. Ті, що залишилися,
; мають виникати лише при компіляції в режимі "Debug".

ERROR.1=недійсна функція
ERROR.2=файл не знайдено
ERROR.3=шлях не знайдено
ERROR.4=забагато відкритих файлів
ERROR.5=доступ до файлу заборонено
ERROR.8=недостатньо пам'яті
ERROR.201=перевірка діапазону даних
ERROR.202=переповнення стека
ERROR.203=переповнення пам'яті
ERROR.204=операція з вказівником
ERROR.220=перевірка типу даних
ERROR.221=непідтримувана операція
ERROR.222=невірний формат файлу
ERROR.223=структура занадто велика
ERROR.224=перевірка даних
ERROR.225=непризначений вказівник
ERROR.226=звільнення заблокованого ресурсу
ERROR.227=помилка стиснутого зображення
ERROR.230=помилка ініціалізації
ERROR.231=неправильно вирівняний драйвер
ERROR.232=тип драйвера не підтримується
ERROR.233=недійсний тип драйвера
ERROR.234=перевірка драйвера
ERROR.240=збій відеодрайвера
ERROR.241=збій аудіодрайвера
ERROR.242=збій драйвера клавіатури
ERROR.243=збій драйвера миші
ERROR.244=збій драйвера джойстика

