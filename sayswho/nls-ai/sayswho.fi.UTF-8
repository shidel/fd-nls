; Kun tämän ohjelman pääteksti on valmis, nämä kielikohtaiset tiedostot
; poistetaan tästä projektista ja siirretään FD-NLS-käännösprojektiin.
; Käännökset ja korjaukset ovat tervetulleita. Niitä ei kuitenkaan oteta
; vastaan suoraan tämän projektin lähdekoodin kehitykseen.

VERSION=%0 (versio %1)
LICENSE=BSD 3-Clause License
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Kaikki oikeudet pidätetään.

; Jos haluatte nimenne näkyviin ohjelman käännöstietoihin, muokkatkaa
; LANGUAGE-kenttää ja täyttäkää TRANSLATOR-kenttä. :-)

LANGUAGE=Suomi
TRANSLATOR=

THANKS=Erityiskiitokset %0:lle %1 kielen käännösten toimittamisesta.

; Tässä pelissä on hyvin vähän tekstiä ja paljon tyhjää tilaa näytöllä. Siksi
; se käyttää oletuksena suurempaa 12x14 englantilaista fonttia. Tässä fontissa
; HINT-rivi vie suurimman osan näytön leveydestä. Muilla kielillä suurimmat
; fontit ovat kuitenkin 10x12 tai 8x16. Löydätte nämä kielikohtaiset fontit
; FD-NLS-palvelusta "danger"-hakemistosta.

LEVEL=Sarja
TRIES=Yritykset
START=klikkaa tai paina näppäintä
DEATH=väärin
GAMEOVER=peli ohi

; Jos HINT-käännöksenne on paljon pidempi, se todennäköisesti leikkautuu.
; Harkitkaa viittauksen jättämistä pois numeronäppäimistöön. Ehkä kääntäisitte
; sen vain muodossa "käytä nuolinäppäimiä tai hiirtä".

HINT=käytä nuolinäppäimiä, numeronäppäimistöä tai hiirtä

ERROR.MOUSE=hiirtä ei löytynyt. Se on välttämätön.
ERROR.VIDEO=sopivaa grafiikka-ajuria ei löytynyt

ERROR.DRIVER.FIND=%0-ajuria ei löytynyt
ERROR.DRIVER.INIT=%0-ajurin alustus epäonnistui
ERROR.DRIVER.MODE=avataan grafiikka-ajurin %0 tila %1

ERROR.NOHELP=ohjetta ei ole saatavilla
ERROR.FORMAT=tiedoston %0 muotoa ei tunnistettu

; Lukuisat muut virheilmoitukset/koodit ovat mahdollisia. Niiden pitäisi
; kuitenkin esiintyä harvoin. Siksi useimmat on jätetty pois. Jäljelle
; jääneiden pitäisi esiintyä vain, kun ohjelma on käännetty "Debug"-tilassa.

ERROR.1=virheellinen funktio
ERROR.2=tiedostoa ei löydy
ERROR.3=polkua ei löydy
ERROR.4=liian monta avointa tiedostoa
ERROR.5=tiedoston käyttö estetty
ERROR.8=muisti lopussa
ERROR.201=tietoalueen tarkistus
ERROR.202=pinon ylivuoto
ERROR.203=muistin ylivuoto
ERROR.204=osoitinoperaatio
ERROR.220=tietotyypin tarkistus
ERROR.221=toimintoa ei tueta
ERROR.222=virheellinen tiedostomuoto
ERROR.223=rakenne on liian suuri
ERROR.224=tietojen varmennus
ERROR.225=osoitinta ei ole määritetty
ERROR.226=vapauta lukittu resurssi
ERROR.227=pakatun kuvan virhe
ERROR.230=alustusvirhe
ERROR.231=väärin kohdistettu ajuri
ERROR.232=ajurityyppiä ei tueta
ERROR.233=virheellinen ajurityyppi
ERROR.234=ajurin varmennus
ERROR.240=grafiikka-ajurin virhe
ERROR.241=ääniajurin virhe
ERROR.242=näppäimistöajurin virhe
ERROR.243=hiiriajurin virhe
ERROR.244=ohjainajurin virhe

