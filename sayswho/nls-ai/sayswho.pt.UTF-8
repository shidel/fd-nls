; Language: Portuguese (pt)
; File ending: pt
; Codepage: 860
; This translation was created by Google AI.
; Please help the FreeDOS group to improve it.

; Assim que o texto principal deste programa estiver pronto, estes ficheiros
; específicos de cada língua serão removidos deste projeto e movidos para o
; projeto de tradução FD-NLS. Traduções ou correções são bem-vindas. No entanto,
; não serão aceites diretamente no desenvolvimento do código-fonte deste projeto.

VERSION=%0 (versão %1)
LICENSE=Licença BSD 3-Clause
COPYRIGHT=Copyright (c) %1, %0
RIGHTS=Todos os direitos reservados.

; Se pretender crédito pela sua tradução mostrada no programa, basta
; editar o campo LANGUAGE e preencher o campo TRANSLATOR. :-)

LANGUAGE=Português
TRANSLATOR=

THANKS=Agradecimentos especiais a %0 por fornecer as traduções para %1.

; Este jogo tem muito pouco texto e muito espaço vazio no ecrã. Por isso,
; utiliza por defeito um tipo de letra inglês 12x14 maior. E nesse tipo de letra,
; a linha HINT ocupa a maior parte da largura do ecrã. No entanto, para outras
; línguas, os tipos de letra maiores são 10x12 ou 8x16. Pode encontrar esses
; tipos de letra específicos no FD-NLS na diretoria "danger".

LEVEL=Sequência
TRIES=Tentativas
START=clica ou prime uma tecla
DEATH=incorreto
GAMEOVER=fim de jogo

; Se a sua tradução de HINT for muito mais longa, será provavelmente cortada.
; Considere omitir a referência ao teclado numérico. Talvez traduza apenas
; como "use as teclas de seta ou o rato"

HINT=use as teclas de seta, teclado numérico ou o rato

ERROR.MOUSE=não foi possível encontrar o rato. Ele é mesmo necessário.
ERROR.VIDEO=não foi possível encontrar um controlador gráfico adequado

ERROR.DRIVER.FIND=não foi possível localizar o controlador %0
ERROR.DRIVER.INIT=não foi possível inicializar o controlador %0
ERROR.DRIVER.MODE=abertura do controlador gráfico %0 modo %1

ERROR.NOHELP=ajuda não disponível
ERROR.FORMAT=não foi possível reconhecer o formato do ficheiro %0

; Existem inúmeras outras mensagens/códigos de erro possíveis. Mas estes devem
; ocorrer raramente. Por isso, a maioria foi omitida. Dos que restam, devem
; apenas ocorrer quando compilado em modo "Debug". Provavelmente deveria
; omitir também essas mensagens.

ERROR.1=função inválida
ERROR.2=ficheiro não encontrado
ERROR.3=caminho não encontrado
ERROR.4=demasiados ficheiros abertos
ERROR.5=acesso ao ficheiro negado
ERROR.8=memória esgotada
ERROR.201=verificação de intervalo de dados
ERROR.202=estouro de pilha (stack overflow)
ERROR.203=estouro de memória
ERROR.204=operação de ponteiro
ERROR.220=verificação de tipo de dados
ERROR.221=operação não suportada
ERROR.222=formato de ficheiro inválido
ERROR.223=estrutura demasiado grande
ERROR.224=verificação de dados
ERROR.225=ponteiro não atribuído
ERROR.226=libertação de recurso bloqueado
ERROR.227=erro de imagem comprimida
ERROR.230=falha de inicialização
ERROR.231=controlador desalinhado
ERROR.232=tipo de controlador não suportado
ERROR.233=tipo de controlador inválido
ERROR.234=verificação do controlador
ERROR.240=falha do controlador gráfico
ERROR.241=falha do controlador de áudio
ERROR.242=falha do controlador de teclado
ERROR.243=falha do controlador de rato
ERROR.244=falha do controlador de joystick

