; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=eo
TITLE=%, Versio %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (daÌrigita)
INC_DIR=%2
INC_TEXT=enkorpigi tekston: %2 %8
INC_HEAD=teksto: %2 %8
USE_COMP=ebligis %0 trapasan kunpremon

VERB_PRE_SCAN=skanis % erojn por aldoni al arkivo
VERB_INC_FILE=inkluzivi: %9%2 (%A)\[%3] %8
VERB_INC_CONT=daÌrigi: %2 [%3] (daÌrigita de de«ovo %6)
VERB_INC_DIR=subdosierujo: %2 (%3)
VERB_INC_HEAD=enkorpigi kapan tekston: %2 %8

; Excluded file or dir
VERB_EXCLUDE=ekskludi: %0 (kongruas "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=aldoni "%1" al %0 listo
LIST_INC=inkluzivi
LIST_EXC=ekskludi

; Same params as reporting
EXT_DIR=dosierujo: %2
EXT_FILE=dosiero: %9%2, %8
EXT_PART=parta: %9%2, %7 de %8
VERB_EXT_RPCL=dosiero %9%2 ekzistas, anstataÌigita
VERB_EXT_SKIP=dosiero %9%2 ekzistas, preterlasita

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategorio: %2
REP_DIR=dosierujo: %2
REP_FILE=dosiero: %9%2, %8
REP_PART=parta: %9%2, %7 de %8
REP_TEXT=teksto: %2, %8
REP_MORE=daÌrigita: %2, %8
REP_CONF=akcepti: %2, %8

VERB_REP_CAT=agordi kategorion: %2, %1
VERB_REP_DIR=dosierujo: %2 (%3), %1 %4 %5
VERB_REP_FILE=kompleta dosiero: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 dosiergrando %8
VERB_REP_PART=parta dosiero: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 de %8 (de«ovo %6)
VERB_REP_TEXT=teksto: %2 %4 {%3}, %8
VERB_REP_MORE=daÌrigita: %2 %4 {%3}, %8
VERB_REP_CONF=akcepti: %2 %4 {%3}, %8
VERB_REP_SIG=subskribo: %2 [%3], %1
VERB_REP_NULL=nula bloko, %1
VERB_REP_OTHER=nekonata bloko %0, %1
VERB_REP_SLICE=elekti arkivparton %

SAF_CREATE=Krei novan slicer-arkivon %
