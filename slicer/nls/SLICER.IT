; Language: Italian
; File ending: it
; Codepage: 858
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=it
TITLE=%, Versione %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (continua)
INC_DIR=%2
INC_TEXT=incorpora testo: %2 %8
INC_HEAD=testo: %2 %8
USE_COMP=pass-through di compressione per %0 abilitato

VERB_PRE_SCAN=scansionati % elementi da aggiungere all'archivio
VERB_INC_FILE=includi: %9%2 (%A)\[%3] %8
VERB_INC_CONT=continua: %2 [%3] (continua dall'offset %6)
VERB_INC_DIR=sottodirectory: %2 (%3)
VERB_INC_HEAD=incorpora testo intestazione: %2 %8

; Excluded file or dir
VERB_EXCLUDE=escludi: %0 (corrisponde a "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=aggiungi "%1" all'elenco %0
LIST_INC=includi
LIST_EXC=escludi

; Same params as reporting
EXT_DIR=directory: %2
EXT_FILE=file: %9%2, %8
EXT_PART=parziale: %9%2, %7 di %8
VERB_EXT_RPCL=il file %9%2 esiste, sostituito
VERB_EXT_SKIP=il file %9%2 esiste, ignorato

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=categoria: %2
REP_DIR=directory: %2
REP_FILE=file: %9%2, %8
REP_PART=parziale: %9%2, %7 di %8
REP_TEXT=testo: %2, %8
REP_MORE=continua: %2, %8
REP_CONF=accetta: %2, %8

VERB_REP_CAT=imposta categoria: %2, %1
VERB_REP_DIR=directory: %2 (%3), %1 %4 %5
VERB_REP_FILE=file completo: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 dimensione file %8
VERB_REP_PART=file parziale: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 di %8 (offset %6)
VERB_REP_TEXT=testo: %2 %4 {%3}, %8
VERB_REP_MORE=continua: %2 %4 {%3}, %8
VERB_REP_CONF=accetta: %2 %4 {%3}, %8
VERB_REP_SIG=firma: %2 [%3], %1
VERB_REP_NULL=blocco nullo, %1
VERB_REP_OTHER=blocco sconosciuto %0, %1
VERB_REP_SLICE=seleziona parte %

SAF_CREATE=Crea nuovo archivio slicer %
SAF_OPEN=Apri archivio slicer esistente %
SAF_APPEND=Aggiungi ad archivio slicer esistente %
SAF_DATE=Creato il %2/%1/%0 alle %3:%4:%5
SAF_SLICE=Crea nuova parte archivio %
SAF_CAT=Imposta categoria archivio %
SAF_SLICING=Divisione archivio in %
VERB_SAF_IUP=Aggiorna informazioni statistiche per l'archivio %

MEDIA=Inserire il dischetto contenente il file %0 nell'unitÖ %1.
PAUSE=Premere un tasto per continuare.

PROMPT_YES=Sç
PROMPT_NO=No
PROMPT_Y=S
PROMPT_N=N
PROMPT_OVER=Sovrascrivere %2%1, %0?
PROMPT_ACCEPT=Accettare %?
PROMPT_STOP=Il file %1 ä danneggiato. Interrompere l'estrazione %0?

SUMMARY=%0 parte/i, %1 dir, %2 file, %3

USAGE=uso: % [opzioni]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=Informazioni sulle opzioni di SLICER:
HELP_1=
HELP_2=  %0q        disabilita tutti i messaggi di stato
HELP_3=  %0v        abilita messaggi di stato dettagliati
HELP_4=  %0t        modalitÖ di test
HELP_5=  %0h        mostra informazioni di aiuto
HELP_6=
HELP_7=  %0i ?      includi elementi corrispondenti alla specifica
HELP_8=  %0I ?      includi elementi dall'elenco di file
HELP_9=  %0e ?      escludi elementi corrispondenti alla specifica
HELP_10=  %0E ?      escludi elementi dall'elenco di file
HELP_11=
HELP_12=  %0d        escludi directory vuote
HELP_13=  %0D        non includere sottodirectory ricorsivamente
HELP_14=  %0a        includi tutti gli elementi nascosti e di sistema
HELP_15=  %0o        sovrascrivi i file esistenti
HELP_16=  %0k        non ignorare maiuscole/minuscole nei nomi file
HELP_17=
HELP_18=  %0g ?      specifica la categoria del gruppo
HELP_19=  %0s ?      dimensione parte archivio (K, M o byte). (valido solo
HELP_20=             creando un nuovo archivio o dividendone uno esistente)
HELP_21=
HELP_22=  %0y        accetta automaticamente tutte le richieste (tranne
HELP_23=             la sovrascrittura di file).
HELP_24=Operazioni relative all'intero archivio:
HELP_25=
HELP_26=  %0f ?      specifica il nome file dell'archivio
HELP_27=  %0c        crea un nuovo archivio
HELP_28=  %0r        aggiungi a un archivio esistente
HELP_29=  %0x        estrai da un archivio esistente
HELP_30=  %0R        genera rapporto archivio
HELP_31=  %0O ?      imposta percorso di destinazione per l'estrazione
HELP_32=
HELP_33=Testo incorporato, avvisi e messaggi:
HELP_34=
HELP_35=  %0L ?      sostituisci lingua predefinita di sistema
HELP_36=  %0m ?      incorpora testo messaggio da file
HELP_37=  %0M ?      incorpora messaggio da file che richiede consenso
HELP_38=
HELP_39=Compressione pass-through:
HELP_40=
HELP_41=  %0p ?      abilita compressione pass-through (GZ, forse altri)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Terra di confusione. Per aiuto usa l'opzione "%0h".

FATAL=ERRORE FATALE:%_
ERROR=ERRORE:%_
BAD_OPT=Parametro riga di comando non valido "%0%1"
BAD_CMB=Impossibile combinare i parametri "%0%1" e "%0%2"
BAD_MCO=Dati riga di comando mancanti per "%0%1"
BAD_INT=Valore numerico "%2" non valido per "%0%1"
BAD_VAL=Valore numerico "%2" fuori dall'intervallo "%3 - %4" per "%0%1"
BAD_MAX=Superato il numero massimo di parti per "%1"
BAD_VER=L'archivio "%1" puï contenere strutture dati non supportate.
BAD_EMB=Puoi specificare un solo file di testo messaggio alla volta.
BAD_MSG=Nota del messaggio "%1" troppo grande. Troncata a %2.
BAD_CMP=Compressione pass-through non supportata "%2"
BAD_TMP=‘ necessaria una directory TEMP.
ER_UNK=codice errore #%0, errore non specificato con "%1" %2
ER_2=Il file "%1" non ä stato trovato.
ER_3=Il percorso del file "%1" non ä stato trovato.
ER_8=Uhm, memoria esaurita.
ER_11=Il file "%1" ha un formato non riconosciuto.
ER_13=Il file "%1" contiene dati danneggiati.
ER_14=Interrotto dall'utente.
ER_23=Firma non corrispondente. Il file "%1" ha dati danneggiati.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2/%1/%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 alle %1

BYTES=% byte
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% dischetto
