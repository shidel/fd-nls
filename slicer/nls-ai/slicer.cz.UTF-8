; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=cz
TITLE=%, Verze %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (pokračování)
INC_DIR=%2
INC_TEXT=vložit text: %2 %8
INC_HEAD=text: %2 %8
USE_COMP=povoleno %0 pass-through komprese

VERB_PRE_SCAN=naskenováno % položek pro přidání do archivu
VERB_INC_FILE=zahrnout: %9%2 (%A)\[%3] %8
VERB_INC_CONT=pokračovat: %2 [%3] (pokračování od offsetu %6)
VERB_INC_DIR=podadresář: %2 (%3)
VERB_INC_HEAD=vložit text hlavičky: %2 %8

; Excluded file or dir
VERB_EXCLUDE=vyloučit: %0 (odpovídá "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=přidat "%1" do seznamu %0
LIST_INC=zahrnout
LIST_EXC=vyloučit

; Same params as reporting
EXT_DIR=adresář: %2
EXT_FILE=soubor: %9%2, %8
EXT_PART=částečný: %9%2, %7 z %8
VERB_EXT_RPCL=soubor %9%2 existuje, nahrazen
VERB_EXT_SKIP=soubor %9%2 existuje, přeskočen

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategorie: %2
REP_DIR=adresář: %2
REP_FILE=soubor: %9%2, %8
REP_PART=částečný: %9%2, %7 z %8
REP_TEXT=text: %2, %8
REP_MORE=pokračování: %2, %8
REP_CONF=přijmout: %2, %8

VERB_REP_CAT=nastavit kategorii: %2, %1
VERB_REP_DIR=adresář: %2 (%3), %1 %4 %5
VERB_REP_FILE=kompletní soubor: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 velikost souboru %8
VERB_REP_PART=částečný soubor: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 z %8 (offset %6)
VERB_REP_TEXT=text: %2 %4 {%3}, %8
VERB_REP_MORE=pokračování: %2 %4 {%3}, %8
VERB_REP_CONF=přijmout: %2 %4 {%3}, %8
VERB_REP_SIG=signatura: %2 [%3], %1
VERB_REP_NULL=nulový blok, %1
VERB_REP_OTHER=neznámý blok %0, %1
VERB_REP_SLICE=vybrat část %

SAF_CREATE=Vytvořit nový slicer archiv %
SAF_OPEN=Otevřít existující slicer archiv %
SAF_APPEND=Připojit k existujícímu slicer archivu %
SAF_DATE=Vytvořeno %2.%1.%0 v %3:%4:%5
SAF_SLICE=Vytvořit novou část archivu %
SAF_CAT=Nastavit kategorii archivu %
SAF_SLICING=Rozdělování archivu na %
VERB_SAF_IUP=Aktualizovat statistické informace pro archiv %

MEDIA=Vložte disketu obsahující soubor %0 do jednotky %1.
PAUSE=Pokračujte stisknutím libovolné klávesy.

PROMPT_YES=Ano
PROMPT_NO=Ne
PROMPT_Y=A
PROMPT_N=N
PROMPT_OVER=Přepsat %2%1, %0?
PROMPT_ACCEPT=Přijmout %?
PROMPT_STOP=Soubor %1 je poškozen. Zrušit extrakci %0?

SUMMARY=%0 část(í), %1 adresář(ů), %2 soubor(ů), %3

USAGE=použití: % [volby]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=Informace o volbách programu SLICER:
HELP_1=
HELP_2=  %0q        zakázat všechny stavové zprávy
HELP_3=  %0v        povolit podrobné stavové zprávy
HELP_4=  %0t        testovací režim
HELP_5=  %0h        zobrazit informace o nápovědě
HELP_6=
HELP_7=  %0i ?      zahrnout položky odpovídající specifikaci souboru
HELP_8=  %0I ?      zahrnout položky ze seznamu souborů
HELP_9=  %0e ?      vyloučit položky odpovídající specifikaci souboru
HELP_10=  %0E ?      vyloučit položky ze seznamu souborů
HELP_11=
HELP_12=  %0d        vyloučit prázdné adresáře
HELP_13=  %0D        neprocházet podadresáře
HELP_14=  %0a        zahrnout všechny skryté a systémové položky
HELP_15=  %0o        přepsat existující soubory
HELP_16=  %0k        neignorovat velikost písmen v názvech souborů
HELP_17=
HELP_18=  %0g ?      určit kategorii skupiny
HELP_19=  %0s ?      velikost části archivu (K, M nebo bajty). (platné pouze při
HELP_20=             vytváření nového nebo rozdělování existujícího archivu)
HELP_21=
HELP_22=  %0y        automaticky přijmout všechny výzvy (kromě přepsání souboru).
HELP_23=
HELP_24=Operace týkající se celého archivu:
HELP_25=
HELP_26=  %0f ?      zadat název souboru archivu
HELP_27=  %0c        vytvořit nový archiv
HELP_28=  %0r        připojit k existujícímu archivu
HELP_29=  %0x        extrahovat z existujícího archivu
HELP_30=  %0R        vygenerovat zprávu o archivu
HELP_31=  %0O ?      nastavit cílovou cestu pro extrakci
HELP_32=
HELP_33=Vložený text, upozornění a zprávy:
HELP_34=
HELP_35=  %0L ?      přepsat výchozí jazyk systému
HELP_36=  %0m ?      vložit text zprávy ze souboru
HELP_37=  %0M ?      vložit text zprávy ze souboru vyžadující souhlas uživatele
HELP_38=
HELP_39=Pass-through komprese:
HELP_40=
HELP_41=  %0p ?      povolit pass-through kompresi (GZ, později možno i další)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Země zmatku. Pro nápovědu použijte volbu "%0h".

FATAL=KRITICKÁ CHYBA:%_
ERROR=CHYBA:%_
BAD_OPT=Neplatný parametr příkazového řádku "%0%1"
BAD_CMB=Nelze kombinovat parametry "%0%1" a "%0%2"
BAD_MCO=Chybějící data příkazového řádku pro "%0%1"
BAD_INT=Neplatná číselná hodnota "%2" pro "%0%1"
BAD_VAL=Číselná hodnota "%2" je mimo rozsah "%3 - %4" pro "%0%1"
BAD_MAX=Překročen maximální počet částí archivu pro "%1"
BAD_VER=Archiv "%1" může obsahovat nepodporované datové struktury.
BAD_EMB=Současně lze zadat pouze jeden soubor s textem zprávy.
BAD_MSG=Upozornění "%1" je příliš velké. Zkráceno na %2.
BAD_CMP=Nepodporovaná pass-through komprese "%2"
BAD_TMP=Je vyžadován adresář TEMP.
ER_UNK=kód chyby #%0, blíže neurčená chyba s "%1" %2
ER_2=Soubor "%1" nebyl nalezen.
ER_3=Cesta k souboru "%1" nebyla nalezena.
ER_8=Ehm, došla mi paměť.
ER_11=Soubor "%1" má nerozpoznaný formát.
ER_13=Soubor "%1" obsahuje poškozená data.
ER_14=Ukončeno uživatelem.
ER_23=Neshoda signatur. Soubor "%1" obsahuje poškozená data.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 v %1

BYTES=% bajt(ů)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% disketa
