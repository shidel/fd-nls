; Language: Serbian
; File ending: sr
; Codepage: 855
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=sr
TITLE=%, Верзија %
COPYRIGHT=Ауторска права (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (наставак)
INC_DIR=%2
INC_TEXT=угради текст: %2 %8
INC_HEAD=текст: %2 %8
USE_COMP=омогућена %0 pass-through компресија

VERB_PRE_SCAN=скенирано % ставки за додавање у архиву
VERB_INC_FILE=укључи: %9%2 (%A)\[%3] %8
VERB_INC_CONT=настави: %2 [%3] (наставак од помака %6)
VERB_INC_DIR=поддиректоријум: %2 (%3)
VERB_INC_HEAD=угради текст заглавља: %2 %8

; Excluded file or dir
VERB_EXCLUDE=искључи: %0 (одговара "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=додај "%1" на %0 листу
LIST_INC=укључи
LIST_EXC=искључи

; Same params as reporting
EXT_DIR=директоријум: %2
EXT_FILE=датотека: %9%2, %8
EXT_PART=делимично: %9%2, %7 од %8
VERB_EXT_RPCL=датотека %9%2 постоји, замењена
VERB_EXT_SKIP=датотека %9%2 постоји, прескочена

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=категорија: %2
REP_DIR=директоријум: %2
REP_FILE=датотека: %9%2, %8
REP_PART=делимично: %9%2, %7 од %8
REP_TEXT=текст: %2, %8
REP_MORE=наставак: %2, %8
REP_CONF=прихвати: %2, %8

VERB_REP_CAT=постави категорију: %2, %1
VERB_REP_DIR=директоријум: %2 (%3), %1 %4 %5
VERB_REP_FILE=цела датотека: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 величина датотеке %8
VERB_REP_PART=делимична датотека: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 од %8 (помак %6)
VERB_REP_TEXT=текст: %2 %4 {%3}, %8
VERB_REP_MORE=наставак: %2 %4 {%3}, %8
VERB_REP_CONF=прихвати: %2 %4 {%3}, %8
VERB_REP_SIG=потпис: %2 [%3], %1
VERB_REP_NULL=нулти блок, %1
VERB_REP_OTHER=непознат блок %0, %1
VERB_REP_SLICE=изабери део %

SAF_CREATE=Направи нову slicer архиву %
SAF_OPEN=Отвори постојећу slicer архиву %
SAF_APPEND=Додај у постојећу slicer архиву %
SAF_DATE=Направљено %2.%1.%0. у %3:%4:%5
SAF_SLICE=Направи нови део архиве %
SAF_CAT=Постави категорију архиве %
SAF_SLICING=Дељење архиве на %
VERB_SAF_IUP=Ажурирај статистичке податке за архиву %

MEDIA=Уметните дискету са датотеком %0 у јединицу %1.
PAUSE=Притисните било који тастер за наставак.

PROMPT_YES=Да
PROMPT_NO=Не
PROMPT_Y=Д
PROMPT_N=Н
PROMPT_OVER=Преписати %2%1, %0?
PROMPT_ACCEPT=Прихватити %?
PROMPT_STOP=Датотека %1 је оштећена. Прекинути издвајање %0?

SUMMARY=%0 део(делова), %1 дир., %2 датотека, %3

USAGE=употреба: % [опције]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER информације о опцијама:
HELP_1=
HELP_2=  %0q        онемогући све статусне поруке
HELP_3=  %0v        омогући детаљне статусне поруке
HELP_4=  %0t        пробни режим
HELP_5=  %0h        прикажи информације о помоћи
HELP_6=
HELP_7=  %0i ?      укључи ставке које одговарају спецификацији датотеке
HELP_8=  %0I ?      укључи ставке са листе датотека
HELP_9=  %0e ?      искључи ставке које одговарају спецификацији датотеке
HELP_10=  %0E ?      искључи ставке са листе датотека
HELP_11=
HELP_12=  %0d        искључи празне директоријуме
HELP_13=  %0D        не претражуј поддиректоријуме
HELP_14=  %0a        укључи све скривене и системске ставке
HELP_15=  %0o        препиши постојеће датотеке
HELP_16=  %0k        не занемаруј велика/мала слова у називима
HELP_17=
HELP_18=  %0g ?      одреди категорију групе
HELP_19=  %0s ?      величина за део архиве (K, M или бајтови). (важи само
HELP_20=             при прављењу нове или дељењу постојеће архиве)
HELP_21=
HELP_22=  %0y        аутоматски прихвати све упите (осим
HELP_23=             преписивања датотека).
HELP_24=Операције везане за целу архиву:
HELP_25=
HELP_26=  %0f ?      одреди назив датотеке архиве
HELP_27=  %0c        направи нову архиву
HELP_28=  %0r        додај у постојећу архиву
HELP_29=  %0x        издвоји из постојеће архиве
HELP_30=  %0R        генериши извештај о архиви
HELP_31=  %0O ?      постави одредишну путању за издвајање
HELP_32=
HELP_33=Уграђени текст, обавештења и поруке:
HELP_34=
HELP_35=  %0L ?      надјачај задати језик система
HELP_36=  %0m ?      угради текст поруке из датотеке
HELP_37=  %0M ?      угради текст поруке који захтева пристанак корисника
HELP_38=
HELP_39=Pass-through компресија:
HELP_40=
HELP_41=  %0p ?      омогући pass-through компресију (GZ, можда и друге)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Земља збуњености. За помоћ користите опцију "%0h".

FATAL=КОБНА ГРЕШКА:%_
ERROR=ГРЕШКА:%_
BAD_OPT=Неважећи параметар командне линије "%0%1"
BAD_CMB=Није могуће комбиновати параметре "%0%1" са "%0%2"
BAD_MCO=Недостају подаци командне линије за "%0%1"
BAD_INT=Неважећа нумеричка вредност "%2" за "%0%1"
BAD_VAL=Нумеричка вредност "%2" је ван опсега "%3 - %4" за "%0%1"
BAD_MAX=Премашен максималан број делова архиве за "%1"
BAD_VER=Архива "%1" можда садржи неподржане структуре података.
BAD_EMB=Могуће је одредити само једну текстуалну датотеку поруке одједном.
BAD_MSG=Обавештење о поруци "%1" превелико. Скраћено на %2.
BAD_CMP=Неподржана pass-through компресија "%2"
BAD_TMP=Потребан је TEMP директоријум.
ER_UNK=код грешке #%0, неодређена грешка са "%1" %2
ER_2=Датотека "%1" није пронађена.
ER_3=Путања датотеке "%1" није пронађена.
ER_8=Хмм, понестало ми је меморије.
ER_11=Датотека "%1" има непрепознат формат.
ER_13=Датотека "%1" садржи оштећене податке.
ER_14=Корисник прекинуо.
ER_23=Неподударност потписа. Датотека "%1" садржи оштећене податке.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0.
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 у %1

BYTES=% бајт(ова)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% дискета
