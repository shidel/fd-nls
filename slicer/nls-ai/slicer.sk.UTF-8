; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=sk
TITLE=%, Verzia %
COPYRIGHT=Autorské práva (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (pokračovanie)
INC_DIR=%2
INC_TEXT=vložiť text: %2 %8
INC_HEAD=text: %2 %8
USE_COMP=povolená %0 pass-through kompresia

VERB_PRE_SCAN=naskenovaných % položiek na pridanie do archívu
VERB_INC_FILE=zahrnúť: %9%2 (%A)\[%3] %8
VERB_INC_CONT=pokračovať: %2 [%3] (pokračuje od posunu %6)
VERB_INC_DIR=podadresár: %2 (%3)
VERB_INC_HEAD=vložiť text hlavičky: %2 %8

; Excluded file or dir
VERB_EXCLUDE=vylúčiť: %0 (zhoduje sa s "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=pridať "%1" do %0 zoznamu
LIST_INC=zahrnúť
LIST_EXC=vylúčiť

; Same params as reporting
EXT_DIR=adresár: %2
EXT_FILE=súbor: %9%2, %8
EXT_PART=čiastočný: %9%2, %7 z %8
VERB_EXT_RPCL=súbor %9%2 existuje, nahradený
VERB_EXT_SKIP=súbor %9%2 existuje, preskočený

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategória: %2
REP_DIR=adresár: %2
REP_FILE=súbor: %9%2, %8
REP_PART=čiastočný: %9%2, %7 z %8
REP_TEXT=text: %2, %8
REP_MORE=pokračovanie: %2, %8
REP_CONF=prijať: %2, %8

VERB_REP_CAT=nastaviť kategóriu: %2, %1
VERB_REP_DIR=adresár: %2 (%3), %1 %4 %5
VERB_REP_FILE=celý súbor: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 veľkosť súboru %8
VERB_REP_PART=čiastočný súbor: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 z %8 (posun %6)
VERB_REP_TEXT=text: %2 %4 {%3}, %8
VERB_REP_MORE=pokračovanie: %2 %4 {%3}, %8
VERB_REP_CONF=prijať: %2 %4 {%3}, %8
VERB_REP_SIG=podpis: %2 [%3], %1
VERB_REP_NULL=nulový blok, %1
VERB_REP_OTHER=neznámy blok %0, %1
VERB_REP_SLICE=vybrať časť %

SAF_CREATE=Vytvoriť nový slicer archív %
SAF_OPEN=Otvoriť existujúci slicer archív %
SAF_APPEND=Pridať do existujúceho slicer archívu %
SAF_DATE=Vytvorené %2.%1.%0 o %3:%4:%5
SAF_SLICE=Vytvoriť novú časť archívu %
SAF_CAT=Nastaviť kategóriu archívu %
SAF_SLICING=Rozdelenie archívu na %
VERB_SAF_IUP=Aktualizovať štatistické informácie pre archív %

MEDIA=Vložte disketu so súborom %0 do jednotky %1.
PAUSE=Pokračujte stlačením ľubovoľného klávesu.

PROMPT_YES=Áno
PROMPT_NO=Nie
PROMPT_Y=A
PROMPT_N=N
PROMPT_OVER=Prepísať %2%1, %0?
PROMPT_ACCEPT=Prijať %?
PROMPT_STOP=Súbor %1 je poškodený. Prerušiť rozbaľovanie %0?

SUMMARY=%0 časť(í), %1 adr., %2 súbor(ov), %3

USAGE=použitie: % [možnosti]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=Informácie o možnostiach SLICER:
HELP_1=
HELP_2=  %0q        zakázať všetky stavové správy
HELP_3=  %0v        povoliť podrobné stavové správy
HELP_4=  %0t        testovací režim
HELP_5=  %0h        zobraziť informácie o pomocníkovi
HELP_6=
HELP_7=  %0i ?      zahrnúť položky zodpovedajúce špecifikácii súboru
HELP_8=  %0I ?      zahrnúť položky zo zoznamu súborov
HELP_9=  %0e ?      vylúčiť položky zodpovedajúce špecifikácii súboru
HELP_10=  %0E ?      vylúčiť položky zo zoznamu súborov
HELP_11=
HELP_12=  %0d        vylúčiť prázdne adresáre
HELP_13=  %0D        nehľadať v podadresároch
HELP_14=  %0a        zahrnúť všetky skryté a systémové položky
HELP_15=  %0o        prepísať existujúce súbory
HELP_16=  %0k        neignorovať veľké/malé písmená v názvoch súborov
HELP_17=
HELP_18=  %0g ?      zadať kategóriu skupiny
HELP_19=  %0s ?      veľkosť pre rozdelenie archívu (K, M, bajty). (platí
HELP_20=             len pri vytváraní nového alebo novom rozdelení)
HELP_21=
HELP_22=  %0y        automaticky prijať všetky výzvy (okrem prepisovania
HELP_23=             súborov).
HELP_24=Operácie týkajúce sa celého archívu:
HELP_25=
HELP_26=  %0f ?      zadať názov súboru archívu
HELP_27=  %0c        vytvoriť nový archív
HELP_28=  %0r        pridať do existujúceho archívu
HELP_29=  %0x        rozbaliť z existujúceho archívu
HELP_30=  %0R        vygenerovať správu o archíve
HELP_31=  %0O ?      nastaviť cieľovú cestu pre rozbalenie
HELP_32=
HELP_33=Vložený text, upozornenia a správy:
HELP_34=
HELP_35=  %0L ?      prepísať predvolený jazyk systému
HELP_36=  %0m ?      vložiť text správy zo súboru
HELP_37=  %0M ?      vložiť text zo súboru, ktorý vyžaduje súhlas používateľa
HELP_38=
HELP_39=Pass-through kompresia:
HELP_40=
HELP_41=  %0p ?      povoliť pass-through kompresiu (GZ, neskôr možno iné)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Krajina zmätku. Pre pomoc použite voľbu "%0h".

FATAL=KRITICKÁ CHYBA:%_
ERROR=CHYBA:%_
BAD_OPT=Neplatný parameter príkazového riadka "%0%1"
BAD_CMB=Nemožno kombinovať parametre "%0%1" a "%0%2"
BAD_MCO=Chýbajúce údaje príkazového riadka pre "%0%1"
BAD_INT=Neplatná číselna hodnota "%2" pre "%0%1"
BAD_VAL=Číselna hodnota "%2" je mimo rozsah "%3 - %4" pre "%0%1"
BAD_MAX=Prekročený maximálny počet častí archívu pre "%1"
BAD_VER=Archív "%1" môže obsahovať nepodporované dátové štruktúry.
BAD_EMB=Súčasne je možné zadať iba jeden textový súbor správy.
BAD_MSG=Poznámka správy "%1" je príliš veľká. Skrátené na %2.
BAD_CMP=Nepodporovaná pass-through kompresia "%2"
BAD_TMP=Vyžaduje sa adresár TEMP.
ER_UNK=kód chyby #%0, nešpecifikovaná chyba s "%1" %2
ER_2=Súbor "%1" nebol nájdený.
ER_3=Cesta k súboru "%1" nebola nájdená.
ER_8=Hmm, nedostatok pamäte.
ER_11=Súbor "%1" má nerozpoznaný formát.
ER_13=Súbor "%1" obsahuje poškodené údaje.
ER_14=Prerušené používateľom.
ER_23=Nezhoda podpisu. Súbor "%1" obsahuje poškodené údaje.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 o %1

BYTES=% bajt(ov)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% disketa
