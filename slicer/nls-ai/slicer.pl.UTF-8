; Language: Polish
; File ending: pl
; Codepage: 852
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=pl
TITLE=%, Wersja %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (kontynuacja)
INC_DIR=%2
INC_TEXT=osadź tekst: %2 %8
INC_HEAD=tekst: %2 %8
USE_COMP=włączono kompresję pass-through dla %0

VERB_PRE_SCAN=przeskanowano % elementów do dodania do archiwum
VERB_INC_FILE=dołącz: %9%2 (%A)\[%3] %8
VERB_INC_CONT=kontynuuj: %2 [%3] (kontynuacja od przesunięcia %6)
VERB_INC_DIR=podkatalog: %2 (%3)
VERB_INC_HEAD=osadź tekst nagłówka: %2 %8

; Excluded file or dir
VERB_EXCLUDE=wyklucz: %0 (pasuje do "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=dodaj "%1" do listy %0
LIST_INC=dołącz
LIST_EXC=wyklucz

; Same params as reporting
EXT_DIR=katalog: %2
EXT_FILE=plik: %9%2, %8
EXT_PART=częściowy: %9%2, %7 z %8
VERB_EXT_RPCL=plik %9%2 istnieje, zastąpiony
VERB_EXT_SKIP=plik %9%2 istnieje, pominięty

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategoria: %2
REP_DIR=katalog: %2
REP_FILE=plik: %9%2, %8
REP_PART=częściowy: %9%2, %7 z %8
REP_TEXT=tekst: %2, %8
REP_MORE=kontynuacja: %2, %8
REP_CONF=akceptuj: %2, %8

VERB_REP_CAT=ustaw kategorię: %2, %1
VERB_REP_DIR=katalog: %2 (%3), %1 %4 %5
VERB_REP_FILE=kompletny plik: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 rozmiar pliku %8
VERB_REP_PART=plik częściowy: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 z %8 (przesunięcie %6)
VERB_REP_TEXT=tekst: %2 %4 {%3}, %8
VERB_REP_MORE=kontynuacja: %2 %4 {%3}, %8
VERB_REP_CONF=akceptuj: %2 %4 {%3}, %8
VERB_REP_SIG=sygnatura: %2 [%3], %1
VERB_REP_NULL=pusty blok, %1
VERB_REP_OTHER=nieznany blok %0, %1
VERB_REP_SLICE=wybierz część %

SAF_CREATE=Utwórz nowe archiwum slicer %
SAF_OPEN=Otwórz istniejące archiwum slicer %
SAF_APPEND=Dołącz do istniejącego archiwum slicer %
SAF_DATE=Utworzono %2.%1.%0 o %3:%4:%5
SAF_SLICE=Utwórz nową część archiwum %
SAF_CAT=Ustaw kategorię archiwum %
SAF_SLICING=Dzielenie archiwum w %
VERB_SAF_IUP=Aktualizacja informacji statystycznych archiwum %

MEDIA=Włóż dyskietkę z plikiem %0 do napędu %1.
PAUSE=Naciśnij dowolny klawisz, aby kontynuować.

PROMPT_YES=Tak
PROMPT_NO=Nie
PROMPT_Y=T
PROMPT_N=N
PROMPT_OVER=Zastąpić %2%1, %0?
PROMPT_ACCEPT=Akceptować %?
PROMPT_STOP=Plik %1 jest uszkodzony. Przerwać rozpakowywanie %0?

SUMMARY=%0 część/części, %1 kat., %2 plik/pliki, %3

USAGE=użycie: % [opcje]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER informacje o opcjach:
HELP_1=
HELP_2=  %0q        wyłącz wszystkie komunikaty o stanie
HELP_3=  %0v        włącz szczegółowe komunikaty o stanie
HELP_4=  %0t        tryb testowy
HELP_5=  %0h        wyświetl informacje pomocy
HELP_6=
HELP_7=  %0i ?      dołącz elementy pasujące do specyfikacji pliku
HELP_8=  %0I ?      dołącz elementy z listy plików
HELP_9=  %0e ?      wyklucz elementy pasujące do specyfikacji pliku
HELP_10=  %0E ?      wyklucz elementy z listy plików
HELP_11=
HELP_12=  %0d        wyklucz puste katalogi
HELP_13=  %0D        nie przeszukuj podkatalogów rekursywnie
HELP_14=  %0a        dołącz wszystkie pliki ukryte i systemowe
HELP_15=  %0o        zastąp istniejące pliki
HELP_16=  %0k        nie ignoruj wielkości liter w nazwach plików
HELP_17=
HELP_18=  %0g ?      określ kategorię grupy
HELP_19=  %0s ?      rozmiar podziału archiwum (K, M lub bajty). (tylko dla
HELP_20=             nowego archiwum lub ponownego podziału istniejącego)
HELP_21=
HELP_22=  %0y        automatycznie akceptuj wszystkie monity (oprócz
HELP_23=             zastępowania plików).
HELP_24=Operacje dotyczące całego archiwum:
HELP_25=
HELP_26=  %0f ?      określ nazwę pliku archiwum
HELP_27=  %0c        utwórz nowe archiwum
HELP_28=  %0r        dołącz do istniejącego archiwum
HELP_29=  %0x        rozpakuj z istniejącego archiwum
HELP_30=  %0R        wygeneruj raport archiwum
HELP_31=  %0O ?      ustaw ścieżkę docelową rozpakowywania
HELP_32=
HELP_33=Osadzony tekst, powiadomienia i komunikaty:
HELP_34=
HELP_35=  %0L ?      nadpisz domyślny język systemu
HELP_36=  %0m ?      osadź tekst komunikatu z pliku
HELP_37=  %0M ?      osadź tekst z pliku wymagający zgody użytkownika
HELP_38=
HELP_39=Kompresja pass-through:
HELP_40=
HELP_41=  %0p ?      włącz kompresję pass-through (GZ, może inne później)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Kraina zamętu. Aby uzyskać pomoc, użyj opcji "%0h".

FATAL=BŁĄD KRYTYCZNY:%_
ERROR=BŁĄD:%_
BAD_OPT=Nieprawidłowy parametr wiersza poleceń "%0%1"
BAD_CMB=Nie można połączyć parametrów "%0%1" z "%0%2"
BAD_MCO=Brak danych wiersza poleceń dla "%0%1"
BAD_INT=Nieprawidłowa wartość liczbowa "%2" dla "%0%1"
BAD_VAL=Wartość liczbowa "%2" poza zakresem "%3 - %4" dla "%0%1"
BAD_MAX=Przekroczono maksymalną liczbę części archiwum dla "%1"
BAD_VER=Archiwum "%1" może zawierać nieobsługiwane struktury danych.
BAD_EMB=Jednocześnie można podać tylko jeden plik tekstowy komunikatu.
BAD_MSG=Notatka komunikatu "%1" zbyt duża. Skrócono do %2.
BAD_CMP=Nieobsługiwana kompresja pass-through "%2"
BAD_TMP=Wymagany jest katalog TEMP.
ER_UNK=kod błędu #%0, nieokreślony błąd z "%1" %2
ER_2=Plik "%1" nie został znaleziony.
ER_3=Ścieżka pliku "%1" nie została znaleziona.
ER_8=Hmm, zabrakło pamięci.
ER_11=Plik "%1" ma nierozpoznany format.
ER_13=Plik "%1" zawiera uszkodzone dane.
ER_14=Przerwano przez użytkownika.
ER_23=Niezgodność sygnatur. Plik "%1" zawiera uszkodzone dane.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 o %1

BYTES=% bajt(ów)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% dyskietka
