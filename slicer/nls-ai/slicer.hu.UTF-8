; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=hu
TITLE=%, % verzió
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (folytatás)
INC_DIR=%2
INC_TEXT=szöveg beágyazása: %2 %8
INC_HEAD=szöveg: %2 %8
USE_COMP=engedélyezve a(z) %0 pass-through tömörítés

VERB_PRE_SCAN=beszkennelve % elem az archívumhoz adáshoz
VERB_INC_FILE=belefoglal: %9%2 (%A)\[%3] %8
VERB_INC_CONT=folytatás: %2 [%3] (folytatva a(z) %6 eltolástól)
VERB_INC_DIR=alkönyvtár: %2 (%3)
VERB_INC_HEAD=fejléc szöveg beágyazása: %2 %8

; Excluded file or dir
VERB_EXCLUDE=kizár: %0 (egyezik ezzel: "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE="%1" hozzáadása a(z) %0 listához
LIST_INC=belefoglal
LIST_EXC=kizár

; Same params as reporting
EXT_DIR=könyvtár: %2
EXT_FILE=fájl: %9%2, %8
EXT_PART=részleges: %9%2, %7 / %8
VERB_EXT_RPCL=%9%2 fájl létezik, lecserélve
VERB_EXT_SKIP=%9%2 fájl létezik, kihagyva

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategória: %2
REP_DIR=könyvtár: %2
REP_FILE=fájl: %9%2, %8
REP_PART=részleges: %9%2, %7 / %8
REP_TEXT=szöveg: %2, %8
REP_MORE=folytatás: %2, %8
REP_CONF=elfogad: %2, %8

VERB_REP_CAT=kategória beállítása: %2, %1
VERB_REP_DIR=könyvtár: %2 (%3), %1 %4 %5
VERB_REP_FILE=teljes fájl: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 fájlméret %8
VERB_REP_PART=részleges fájl: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 / %8 (eltolás %6)
VERB_REP_TEXT=szöveg: %2 %4 {%3}, %8
VERB_REP_MORE=folytatás: %2 %4 {%3}, %8
VERB_REP_CONF=elfogad: %2 %4 {%3}, %8
VERB_REP_SIG=aláírás: %2 [%3], %1
VERB_REP_NULL=null blokk, %1
VERB_REP_OTHER=ismeretlen blokk %0, %1
VERB_REP_SLICE=rész kiválasztása %

SAF_CREATE=Új slicer archívum létrehozása %
SAF_OPEN=Meglévő slicer archívum megnyitása %
SAF_APPEND=Hozzáadás meglévő slicer archívumhoz %
SAF_DATE=Létrehozva %0.%1.%2. %3:%4:%5-kor
SAF_SLICE=Új archívum rész létrehozása %
SAF_CAT=Archívum kategória beállítása %
SAF_SLICING=Archívum darabolása itt: %
VERB_SAF_IUP=A(z) % archívum statisztikai adatainak frissítése

MEDIA=Helyezze be a(z) %0 fájlt tartalmazó lemezt a(z) %1 meghajtóba.
PAUSE=A folytatáshoz nyomjon meg egy gombot.

PROMPT_YES=Igen
PROMPT_NO=Nem
PROMPT_Y=I
PROMPT_N=N
PROMPT_OVER=Felülírja: %2%1, %0?
PROMPT_ACCEPT=Elfogadja: %?
PROMPT_STOP=A(z) %1 fájl sérült. Megszakítja a kibontást %0?

SUMMARY=%0 rész, %1 könyvtár, %2 fájl, %3

USAGE=használat: % [opciók]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER opciók információi:
HELP_1=
HELP_2=  %0q        minden állapotüzenet letiltása
HELP_3=  %0v        részletes állapotüzenetek engedélyezése
HELP_4=  %0t        teszt mód
HELP_5=  %0h        súgóinformációk megjelenítése
HELP_6=
HELP_7=  %0i ?      fájl specifikációnak megfelelő elemek belefoglalása
HELP_8=  %0I ?      elemek belefoglalása a fájllistából
HELP_9=  %0e ?      fájl specifikációnak megfelelő elemek kizárása
HELP_10=  %0E ?      elemek kizárása a fájllistából
HELP_11=
HELP_12=  %0d        üres könyvtárak kizárása
HELP_13=  %0D        ne keressen az alkönyvtárakban
HELP_14=  %0a        minden rejtett és rendszer elem belefoglalása
HELP_15=  %0o        meglévő fájlok felülírása
HELP_16=  %0k        ne hagyja figyelmen kívül a kis/nagybetűket a nevekben
HELP_17=
HELP_18=  %0g ?      csoport kategória megadása
HELP_19=  %0s ?      archívum darabmérete (K, M vagy bájt). (csak új archívum
HELP_20=             létrehozásakor vagy meglévő újradarabolásakor érvényes)
HELP_21=
HELP_22=  %0y        automatikusan elfogad minden kérdést (kivéve a fájlok
HELP_23=             felülírását).
HELP_24=A teljes archívumra vonatkozó műveletek:
HELP_25=
HELP_26=  %0f ?      archívum fájlnevének megadása
HELP_27=  %0c        új archívum létrehozása
HELP_28=  %0r        hozzáadás meglévő archívumhoz
HELP_29=  %0x        kibontás meglévő archívumból
HELP_30=  %0R        archívum jelentés generálása
HELP_31=  %0O ?      kibontás célútvonalának beállítása
HELP_32=
HELP_33=Beágyazott szöveg, értesítések és üzenetek:
HELP_34=
HELP_35=  %0L ?      rendszer alapértelmezett nyelvének felülbírálása
HELP_36=  %0m ?      üzenet szövegének beágyazása fájlból
HELP_37=  %0M ?      felhasználói jóváhagyást igénylő üzenet beágyazása fájlból
HELP_38=
HELP_39=Pass-through tömörítés:
HELP_40=
HELP_41=  %0p ?      pass-through tömörítés engedélyezése (GZ, később talán más)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=A zűrzavar földje. Segítséghez használja a(z) "%0h" opciót.

FATAL=VÉGZETES HIBA:%_
ERROR=HIBA:%_
BAD_OPT=Érvénytelen parancssori paraméter: "%0%1"
BAD_CMB=A(z) "%0%1" és "%0%2" paraméterek nem kombinálhatók
BAD_MCO=Hiányzó parancssori adat a következőhöz: "%0%1"
BAD_INT=Érvénytelen numerikus érték ("%2") a következőhöz: "%0%1"
BAD_VAL=A(z) "%2" számérték a(z) "%3 - %4" tartományon kívül van: "%0%1"
BAD_MAX=A maximális archívum részszám túllépve a következőnél: "%1"
BAD_VER=A(z) "%1" archívum nem támogatott adatstruktúrákat tartalmazhat.
BAD_EMB=Egyszerre csak egy üzenetszöveg-fájl adható meg.
BAD_MSG=A(z) "%1" üzenet túl nagy. Csonkítva %2 méretre.
BAD_CMP=Nem támogatott pass-through tömörítés: "%2"
BAD_TMP=TEMP könyvtár szükséges.
ER_UNK=hibakód #%0, meghatározatlan hiba ezzel: "%1" %2
ER_2=A(z) "%1" fájl nem található.
ER_3=A(z) "%1" fájl útvonala nem található.
ER_8=Ööö, elfogyott a memória.
ER_11=A(z) "%1" fájl formátuma ismeretlen.
ER_13=A(z) "%1" fájl adatai sérültek.
ER_14=Felhasználó által megszakítva.
ER_23=Aláírás eltérés. A(z) "%1" fájl adatai sérültek.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%0.%1.%2.
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 %1

BYTES=% bájt
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% floppy lemez
