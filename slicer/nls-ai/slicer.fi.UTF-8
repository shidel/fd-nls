; Language: Finnish
; File ending: fi
; Codepage: 865
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=fi
TITLE=%, Versio %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (jatkuu)
INC_DIR=%2
INC_TEXT=upota teksti: %2 %8
INC_HEAD=teksti: %2 %8
USE_COMP=sallittu %0 pass-through -pakkaus

VERB_PRE_SCAN=skannattu % kohdetta arkistoon lisättäväksi
VERB_INC_FILE=sisällytä: %9%2 (%A)\[%3] %8
VERB_INC_CONT=jatka: %2 [%3] (jatkuu siirtymästä %6)
VERB_INC_DIR=alihakemisto: %2 (%3)
VERB_INC_HEAD=upota otsikkoteksti: %2 %8

; Excluded file or dir
VERB_EXCLUDE=ohita: %0 (vastaa "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=lisää "%1" luetteloon %0
LIST_INC=sisällytä
LIST_EXC=poissulje

; Same params as reporting
EXT_DIR=hakemisto: %2
EXT_FILE=tiedosto: %9%2, %8
EXT_PART=osittainen: %9%2, %7 / %8
VERB_EXT_RPCL=tiedosto %9%2 on olemassa, korvattu
VERB_EXT_SKIP=tiedosto %9%2 on olemassa, ohitettu

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=luokka: %2
REP_DIR=hakemisto: %2
REP_FILE=tiedosto: %9%2, %8
REP_PART=osittainen: %9%2, %7 / %8
REP_TEXT=teksti: %2, %8
REP_MORE=jatkuu: %2, %8
REP_CONF=hyväksy: %2, %8

VERB_REP_CAT=aseta luokka: %2, %1
VERB_REP_DIR=hakemisto: %2 (%3), %1 %4 %5
VERB_REP_FILE=koko tiedosto: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 tiedostokoko %8
VERB_REP_PART=osittainen tiedosto: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 / %8 (siirtymä %6)
VERB_REP_TEXT=teksti: %2 %4 {%3}, %8
VERB_REP_MORE=jatkuu: %2 %4 {%3}, %8
VERB_REP_CONF=hyväksy: %2 %4 {%3}, %8
VERB_REP_SIG=allekirjoitus: %2 [%3], %1
VERB_REP_NULL=nollalohko, %1
VERB_REP_OTHER=tuntematon lohko %0, %1
VERB_REP_SLICE=valitse osa %

SAF_CREATE=Luo uusi slicer-arkisto %
SAF_OPEN=Avaa olemassa oleva slicer-arkisto %
SAF_APPEND=Lisää olemassa olevaan slicer-arkistoon %
SAF_DATE=Luotu %2.%1.%0 klo %3:%4:%5
SAF_SLICE=Luo uusi arkisto-osa %
SAF_CAT=Aseta arkistoluokka %
SAF_SLICING=Jaetaan arkistoa kohdassa %
VERB_SAF_IUP=Päivitä arkiston % tilastotiedot

MEDIA=Aseta tiedoston %0 sisältävä levyke asemaan %1.
PAUSE=Paina mitä tahansa näppäintä jatkaaksesi.

PROMPT_YES=Kyllä
PROMPT_NO=Ei
PROMPT_Y=K
PROMPT_N=E
PROMPT_OVER=Korvataanko %2%1, %0?
PROMPT_ACCEPT=Hyväksytäänkö %?
PROMPT_STOP=Tiedosto %1 on vioittunut. Keskeytetäänkö purkaminen %0?

SUMMARY=%0 osa(a), %1 hakemisto(a), %2 tiedosto(a), %3

USAGE=käyttö: % [valinnat]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER-valintojen tiedot:
HELP_1=
HELP_2=  %0q        poista kaikki tilaviestit käytöstä
HELP_3=  %0v        ota käyttöön yksityiskohtaiset tilaviestit
HELP_4=  %0t        testitila
HELP_5=  %0h        näytä ohjetiedot
HELP_6=
HELP_7=  %0i ?      sisällytä tiedostomääritystä vastaavat kohteet
HELP_8=  %0I ?      sisällytä kohteet tiedostoluettelosta
HELP_9=  %0e ?      poissulje tiedostomääritystä vastaavat kohteet
HELP_10=  %0E ?      poissulje kohteet tiedostoluettelosta
HELP_11=
HELP_12=  %0d        poissulje tyhjät hakemistot
HELP_13=  %0D        älä käy alihakemistoja läpi
HELP_14=  %0a        sisällytä kaikki piilotetut ja järjestelmäkohteet
HELP_15=  %0o        korvaa olemassa olevat tiedostot
HELP_16=  %0k        älä ohita kirjainkokoa tiedostojen nimissä
HELP_17=
HELP_18=  %0g ?      määritä ryhmäluokka
HELP_19=  %0s ?      arkiston osan koko, K, M tai tavua. (vain uutta
HELP_20=             luotaessa tai olemassa olevaa uudelleen jaettaessa)
HELP_21=
HELP_22=  %0y        hyväksy kaikki kehotteet automaattisesti (ei koske
HELP_23=             tiedostojen korvaamista).
HELP_24=Koko arkistoon liittyvät toiminnot:
HELP_25=
HELP_26=  %0f ?      määritä arkiston tiedostonimi
HELP_27=  %0c        luo uusi arkisto
HELP_28=  %0r        lisää olemassa olevaan arkistoon
HELP_29=  %0x        pura olemassa olevasta arkistosta
HELP_30=  %0R        luo arkistoraportti
HELP_31=  %0O ?      aseta purkamisen kohdepolku
HELP_32=
HELP_33=Upotettu teksti, huomautukset ja viestit:
HELP_34=
HELP_35=  %0L ?      ohita järjestelmän oletuskieli
HELP_36=  %0m ?      upota viestiteksti tiedostosta
HELP_37=  %0M ?      upota viestiteksti tiedostosta, joka vaatii hyväksynnän
HELP_38=
HELP_39=Pass-through -pakkaus:
HELP_40=
HELP_41=  %0p ?      ota käyttöön pass-through -pakkaus (GZ, myöhemmin muita)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Hämmennyksen maa. Saat apua käyttämällä valintaa "%0h".

FATAL=VAKAVA VIRHE:%_
ERROR=VIRHE:%_
BAD_OPT=Virheellinen komentoriviparametri "%0%1"
BAD_CMB=Parametreja "%0%1" ja "%0%2" ei voi yhdistää
BAD_MCO=Puuttuvat komentorivitiedot parametrille "%0%1"
BAD_INT=Virheellinen numeroarvo "%2" parametrille "%0%1"
BAD_VAL=Numeroarvo "%2" on alueen "%3 - %4" ulkopuolella parametrille "%0%1"
BAD_MAX=Arkiston osien enimmäismäärä ylitetty kohteelle "%1"
BAD_VER=Arkisto "%1" voi sisältää tukemattomia tietorakenteita.
BAD_EMB=Voit määrittää vain yhden viestitekstitiedoston kerrallaan.
BAD_MSG=Viestihuomautus "%1" on liian suuri. Typistetty %2:een.
BAD_CMP=Tukematon pass-through -pakkaus "%2"
BAD_TMP=TEMP-hakemisto vaaditaan.
ER_UNK=virhekoodi #%0, määrittämätön virhe: "%1" %2
ER_2=Tiedostoa "%1" ei löytynyt.
ER_3=Tiedoston "%1" polkua ei löytynyt.
ER_8=Öh, muisti loppui.
ER_11=Tiedosto "%1" on tuntemattomassa muodossa.
ER_13=Tiedosto "%1" sisältää vioittunutta tietoa.
ER_14=Käyttäjä keskeytti.
ER_23=Allekirjoituksen ristiriita. Tiedosto "%1" sisältää vioittunutta tietoa.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 klo %1

BYTES=% tavua
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% levyke
