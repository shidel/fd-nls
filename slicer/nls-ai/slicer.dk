; Language: Danish
; File ending: dk
; Codepage: 865
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=dk
TITLE=%, Version %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (fortsat)
INC_DIR=%2
INC_TEXT=indlejr tekst: %2 %8
INC_HEAD=tekst: %2 %8
USE_COMP=aktiveret %0 pass-through komprimering

VERB_PRE_SCAN=scannede % elementer til at tilfõje til arkiv
VERB_INC_FILE=inkluder: %9%2 (%A)\[%3] %8
VERB_INC_CONT=fortsët: %2 [%3] (fortsat fra forskydning %6)
VERB_INC_DIR=undermappe: %2 (%3)
VERB_INC_HEAD=indlejr sidehovedtekst: %2 %8

; Excluded file or dir
VERB_EXCLUDE=ekskluder: %0 (matcher "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=tilfõj "%1" til %0 liste
LIST_INC=inkluder
LIST_EXC=ekskluder

; Same params as reporting
EXT_DIR=mappe: %2
EXT_FILE=fil: %9%2, %8
EXT_PART=delvis: %9%2, %7 af %8
VERB_EXT_RPCL=fil %9%2 findes, overskrevet
VERB_EXT_SKIP=fil %9%2 findes, sprunget over

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategori: %2
REP_DIR=mappe: %2
REP_FILE=fil: %9%2, %8
REP_PART=delvis: %9%2, %7 af %8
REP_TEXT=tekst: %2, %8
REP_MORE=fortsat: %2, %8
REP_CONF=accepter: %2, %8

VERB_REP_CAT=angiv kategori: %2, %1
VERB_REP_DIR=mappe: %2 (%3), %1 %4 %5
VERB_REP_FILE=komplet fil: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 filstõrrelse %8
VERB_REP_PART=delvis fil: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 af %8 (forskydning %6)
VERB_REP_TEXT=tekst: %2 %4 {%3}, %8
VERB_REP_MORE=fortsat: %2 %4 {%3}, %8
VERB_REP_CONF=accepter: %2 %4 {%3}, %8
VERB_REP_SIG=signatur: %2 [%3], %1
VERB_REP_NULL=nul-blok, %1
VERB_REP_OTHER=ukendt blok %0, %1
VERB_REP_SLICE=vëlg delarkiv %

SAF_CREATE=Opret nyt slicer-arkiv %
SAF_OPEN=èbn eksisterende slicer-arkiv %
SAF_APPEND=Tilfõj til eksisterende slicer-arkiv %
SAF_DATE=Oprettet den %2.%1.%0 kl. %3:%4:%5
SAF_SLICE=Opret nyt delarkiv %
SAF_CAT=Angiv arkivkategori %
SAF_SLICING=Opdeler arkiv ved %
VERB_SAF_IUP=Opdaterer statistik for arkiv %

MEDIA=Indsët diskette med filen %0 i drev %1.
PAUSE=Tryk pÜ en vilkÜrlig tast for at fortsëtte.

PROMPT_YES=Ja
PROMPT_NO=Nej
PROMPT_Y=J
PROMPT_N=N
PROMPT_OVER=Overskriv %2%1, %0?
PROMPT_ACCEPT=Accepter %?
PROMPT_STOP=Fil %1 er beskadiget. Afbryd udpakning %0?

SUMMARY=%0 del(e), %1 mappe(r), %2 fil(er), %3

USAGE=brug: % [indstillinger]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER indstillinger:
HELP_1=
HELP_2=  %0q        deaktiver alle statusmeddelelser
HELP_3=  %0v        aktiver detaljerede statusmeddelelser
HELP_4=  %0t        testtilstand
HELP_5=  %0h        vis hjëlpeoplysninger
HELP_6=
HELP_7=  %0i ?      inkluder elementer der matcher filspecifikation
HELP_8=  %0I ?      inkluder elementer fra filliste
HELP_9=  %0e ?      ekskluder elementer der matcher filspecifikation
HELP_10=  %0E ?      ekskluder elementer fra filliste
HELP_11=
HELP_12=  %0d        ekskluder tomme mapper
HELP_13=  %0D        medtag ikke undermapper
HELP_14=  %0a        inkluder alle skjulte filer og systemfiler
HELP_15=  %0o        overskriv eksisterende filer
HELP_16=  %0k        ignorer ikke store/smÜ bogstaver i filnavne
HELP_17=
HELP_18=  %0g ?      angiv gruppekategori
HELP_19=  %0s ?      stõrrelse for delarkiv, K, M eller bytes. (kun gyldigt ved
HELP_20=             oprettelse af et nyt eller opdeling af et eksisterende arkiv)
HELP_21=
HELP_22=  %0y        accepter automatisk alle prompter (undtagen overskriv fil).
HELP_23=
HELP_24=Handlinger relateret til hele arkivet:
HELP_25=
HELP_26=  %0f ?      angiv arkivets filnavn
HELP_27=  %0c        opret et nyt arkiv
HELP_28=  %0r        tilfõj til et eksisterende arkiv
HELP_29=  %0x        udpak fra et eksisterende arkiv
HELP_30=  %0R        generer arkivrapport
HELP_31=  %0O ?      angiv destinationssti for udpakning
HELP_32=
HELP_33=Indlejret tekst, meddelelser og beskeder:
HELP_34=
HELP_35=  %0L ?      tilsidesët systemets standardsprog
HELP_36=  %0m ?      indlejr beskedtekst fra fil
HELP_37=  %0M ?      indlejr beskedtekst fra fil, der krëver at brugeren accepterer
HELP_38=
HELP_39=Pass-through komprimering:
HELP_40=
HELP_41=  %0p ?      aktiver pass-through komprimering (GZ, mÜske flere senere)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Forvirret? Brug indstillingen "%0h" for hjëlp.

FATAL=FATAL FEJL:%_
ERROR=FEJL:%_
BAD_OPT=Ugyldig kommandolinjeparameter "%0%1"
BAD_CMB=Kan ikke kombinere parametrene "%0%1" og "%0%2"
BAD_MCO=Manglende kommandolinjedata for "%0%1"
BAD_INT=Ugyldig numerisk vërdi "%2" for "%0%1"
BAD_VAL=Numerisk vërdi "%2" er uden for omrÜdet "%3 - %4" for "%0%1"
BAD_MAX=Maksimalt antal arkivdele overskredet for "%1"
BAD_VER=Arkiv "%1" kan indeholde datastrukturer, der ikke understõttes.
BAD_EMB=Kan kun angive Çn tekstfil ad gangen.
BAD_MSG=Besked "%1" er for stor. Afkortet til %2.
BAD_CMP=Pass-through komprimering "%2" understõttes ikke
BAD_TMP=TEMP-mappe pÜkrëvet.
ER_UNK=fejlkode #%0, uspecificeret fejl med "%1" %2
ER_2=Filen "%1" blev ikke fundet.
ER_3=Stien til filen "%1" blev ikke fundet.
ER_8=ùv, jeg lõb tõr for hukommelse.
ER_11=Filen "%1" har et ukendt format.
ER_13=Filen "%1" indeholder beskadigede data.
ER_14=Afbrudt af brugeren.
ER_23=Signatur stemmer ikke overens. Filen "%1" har beskadigede data.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 kl. %1

BYTES=% byte(s)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% diskette
