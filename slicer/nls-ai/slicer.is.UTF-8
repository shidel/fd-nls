; Language: Icelandic
; File ending: is
; Codepage: 861
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=is
TITLE=%, Útgáfa %
COPYRIGHT=Höfundarréttur (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (framhald)
INC_DIR=%2
INC_TEXT=fella inn texta: %2 %8
INC_HEAD=texti: %2 %8
USE_COMP=virkjaði %0 pass-through þjöppun

VERB_PRE_SCAN=skannaði % atriði til að bæta við í safn
VERB_INC_FILE=hafa með: %9%2 (%A)\[%3] %8
VERB_INC_CONT=halda áfram: %2 [%3] (framhald frá hliðrun %6)
VERB_INC_DIR=undirmappa: %2 (%3)
VERB_INC_HEAD=fella inn haustexta: %2 %8

; Excluded file or dir
VERB_EXCLUDE=útiloka: %0 (samsvarar "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=bæta "%1" við %0 lista
LIST_INC=hafa með
LIST_EXC=útiloka

; Same params as reporting
EXT_DIR=mappa: %2
EXT_FILE=skrá: %9%2, %8
EXT_PART=að hluta: %9%2, %7 af %8
VERB_EXT_RPCL=skrá %9%2 er til, skipt út
VERB_EXT_SKIP=skrá %9%2 er til, sleppt

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=flokkur: %2
REP_DIR=mappa: %2
REP_FILE=skrá: %9%2, %8
REP_PART=að hluta: %9%2, %7 af %8
REP_TEXT=texti: %2, %8
REP_MORE=framhald: %2, %8
REP_CONF=samþykkja: %2, %8

VERB_REP_CAT=stilla flokk: %2, %1
VERB_REP_DIR=mappa: %2 (%3), %1 %4 %5
VERB_REP_FILE=heil skrá: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 skráarstærð %8
VERB_REP_PART=hlutaskrá: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 af %8 (hliðrun %6)
VERB_REP_TEXT=texti: %2 %4 {%3}, %8
VERB_REP_MORE=framhald: %2 %4 {%3}, %8
VERB_REP_CONF=samþykkja: %2 %4 {%3}, %8
VERB_REP_SIG=undirskrift: %2 [%3], %1
VERB_REP_NULL=núll-blokk, %1
VERB_REP_OTHER=óþekkt blokk %0, %1
VERB_REP_SLICE=velja hluta %

SAF_CREATE=Búa til nýtt slicer safn %
SAF_OPEN=Opna núverandi slicer safn %
SAF_APPEND=Bæta við núverandi slicer safn %
SAF_DATE=Búið til %2.%1.%0 kl. %3:%4:%5
SAF_SLICE=Búa til nýjan safnhluta %
SAF_CAT=Stilla safnflokk %
SAF_SLICING=Hlutar niður safn við %
VERB_SAF_IUP=Uppfæra tölfræðilegar upplýsingar fyrir safn %

MEDIA=Settu diskling með skránni %0 í drif %1.
PAUSE=Ýttu á ýmsan lykil til að halda áfram.

PROMPT_YES=Já
PROMPT_NO=Nei
PROMPT_Y=J
PROMPT_N=N
PROMPT_OVER=Skrifa yfir %2%1, %0?
PROMPT_ACCEPT=Samþykkja %?
PROMPT_STOP=Skrá %1 er skemmd. Hætta við afþjöppun %0?

SUMMARY=%0 hluti/hlutar, %1 mappa/möppur, %2 skrá/skrár, %3

USAGE=notkun: % [valkostir]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER valkosta upplýsingar:
HELP_1=
HELP_2=  %0q        slökkva á öllum stöðuskilaboðum
HELP_3=  %0v        kvekja á ítarlegum stöðuskilaboðum
HELP_4=  %0t        prófunarhamur
HELP_5=  %0h        sýna hjálparupplýsingar
HELP_6=
HELP_7=  %0i ?      hafa með atriði sem passa við skráarforskrift
HELP_8=  %0I ?      hafa með atriði frá skráarlista
HELP_9=  %0e ?      útiloka atriði sem passa við skráarforskrift
HELP_10=  %0E ?      útiloka atriði frá skráarlista
HELP_11=
HELP_12=  %0d        útiloka tómar möppur
HELP_13=  %0D        ekki leita í undirmöppum
HELP_14=  %0a        hafa með allar faldar skrár og kerfisskrár
HELP_15=  %0o        skrifa yfir núverandi skrár
HELP_16=  %0k        ekki hunsa hástafi/lágstafi í skráarnöfnum
HELP_17=
HELP_18=  %0g ?      tilgreina hópaflokk
HELP_19=  %0s ?      stærð til að hluta safn, K, M eða bæti. (aðeins gilt
HELP_20=             við gerð nýs eða endurhlutun á núverandi safni)
HELP_21=
HELP_22=  %0y        samþykkja sjálfkrafa allar beiðnir (nema yfirskrift
HELP_23=             á skrám).
HELP_24=Aðgerðir sem tengjast öllu safninu:
HELP_25=
HELP_26=  %0f ?      tilgreina skráarnafn safns
HELP_27=  %0c        búa til nýtt safn
HELP_28=  %0r        bæta við núverandi safn
HELP_29=  %0x        afþjappa úr núverandi safni
HELP_30=  %0R        búa til skýrslu um safn
HELP_31=  %0O ?      stilla áfangastað fyrir afþjöppun
HELP_32=
HELP_33=Innfelldur texti, tilkynningar og skilaboð:
HELP_34=
HELP_35=  %0L ?      hunsa sjálfgefið kerfismál
HELP_36=  %0m ?      fella inn skilaboðatexta úr skrá
HELP_37=  %0M ?      fella inn texta úr skrá sem krefst samþykkis notanda
HELP_38=
HELP_39=Pass-through þjöppun:
HELP_40=
HELP_41=  %0p ?      virkja pass-through þjöppun (GZ, kannski önnur síðar)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Ruglandi? Fyrir hjálp notaðu "%0h" valkostinn.

FATAL=BANVÆN VILLA:%_
ERROR=VILLA:%_
BAD_OPT=Ógild stika á skipanalínu "%0%1"
BAD_CMB=Ekki er hægt að sameina stikur "%0%1" og "%0%2"
BAD_MCO=Vantar gögn á skipanalínu fyrir "%0%1"
BAD_INT=Ógilt tölugildi "%2" fyrir "%0%1"
BAD_VAL=Tölugildi "%2" er utan marksins "%3 - %4" fyrir "%0%1"
BAD_MAX=Hámarksfjölda safnhluta farið yfir fyrir "%1"
BAD_VER=Safn "%1" gæti innihaldið óstudd gagnamannvirki.
BAD_EMB=Aðeins er hægt að tilgreina eina skilaboðaskrá í einu.
BAD_MSG=Skilaboð "%1" of stór. Stytt í %2.
BAD_CMP=Óstudd pass-through þjöppun "%2"
BAD_TMP=TEMP mappa er nauðsynleg.
ER_UNK=villukóði #%0, ótilgreind villa með "%1" %2
ER_2=Skrá "%1" fannst ekki.
ER_3=Slóð skráar "%1" fannst ekki.
ER_8=Úmm, minnið er búið.
ER_11=Skrá "%1" er á óþekktu sniði.
ER_13=Skrá "%1" inniheldur skemmd gögn.
ER_14=Hætt af notanda.
ER_23=Undirskrift passar ekki. Skrá "%1" inniheldur skemmd gögn.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 kl. %1

BYTES=% bæti
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% disklingur
