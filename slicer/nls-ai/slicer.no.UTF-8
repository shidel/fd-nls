; Language: Norwegian
; File ending: no
; Codepage: 865
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=no
TITLE=%, Versjon %
COPYRIGHT=Copyright (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (fortsetter)
INC_DIR=%2
INC_TEXT=bygg inn tekst: %2 %8
INC_HEAD=tekst: %2 %8
USE_COMP=aktivert %0 pass-through komprimering

VERB_PRE_SCAN=skannet % elementer for å legge til i arkiv
VERB_INC_FILE=inkluder: %9%2 (%A)\[%3] %8
VERB_INC_CONT=fortsett: %2 [%3] (fortsetter fra forskyvning %6)
VERB_INC_DIR=underkatalog: %2 (%3)
VERB_INC_HEAD=bygg inn topptekst: %2 %8

; Excluded file or dir
VERB_EXCLUDE=ekskluder: %0 (samsvarer med "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=legg til "%1" i %0-liste
LIST_INC=inkluder
LIST_EXC=ekskluder

; Same params as reporting
EXT_DIR=katalog: %2
EXT_FILE=fil: %9%2, %8
EXT_PART=delvis: %9%2, %7 av %8
VERB_EXT_RPCL=fil %9%2 eksisterer, erstattet
VERB_EXT_SKIP=fil %9%2 eksisterer, hoppet over

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategori: %2
REP_DIR=katalog: %2
REP_FILE=fil: %9%2, %8
REP_PART=delvis: %9%2, %7 av %8
REP_TEXT=tekst: %2, %8
REP_MORE=fortsetter: %2, %8
REP_CONF=aksepter: %2, %8

VERB_REP_CAT=angi kategori: %2, %1
VERB_REP_DIR=katalog: %2 (%3), %1 %4 %5
VERB_REP_FILE=fullstendig fil: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 filstørrelse %8
VERB_REP_PART=delvis fil: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 av %8 (forskyvning %6)
VERB_REP_TEXT=tekst: %2 %4 {%3}, %8
VERB_REP_MORE=fortsetter: %2 %4 {%3}, %8
VERB_REP_CONF=aksepter: %2 %4 {%3}, %8
VERB_REP_SIG=signatur: %2 [%3], %1
VERB_REP_NULL=nullblokk, %1
VERB_REP_OTHER=ukjent blokk %0, %1
VERB_REP_SLICE=velg del %

SAF_CREATE=Opprett nytt slicer-arkiv %
SAF_OPEN=Åpne eksisterende slicer-arkiv %
SAF_APPEND=Legg til eksisterende slicer-arkiv %
SAF_DATE=Opprettet %2.%1.%0 kl. %3:%4:%5
SAF_SLICE=Opprett ny arkivdel %
SAF_CAT=Angi arkivkategori %
SAF_SLICING=Deler opp arkiv ved %
VERB_SAF_IUP=Oppdater statistisk informasjon for arkiv %

MEDIA=Sett inn diskett med filen %0 i stasjon %1.
PAUSE=Trykk en tast for å fortsette.

PROMPT_YES=Ja
PROMPT_NO=Nei
PROMPT_Y=J
PROMPT_N=N
PROMPT_OVER=Overskriv %2%1, %0?
PROMPT_ACCEPT=Aksepter %?
PROMPT_STOP=Filen %1 er korrupt. Avbryt utpakking %0?

SUMMARY=%0 del(er), %1 kat., %2 fil(er), %3

USAGE=bruk: % [alternativer]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER alternativinformasjon:
HELP_1=
HELP_2=  %0q        deaktiver alle statusmeldinger
HELP_3=  %0v        aktiver detaljerte statusmeldinger
HELP_4=  %0t        testmodus
HELP_5=  %0h        vis hjelpeinformasjon
HELP_6=
HELP_7=  %0i ?      inkluder elementer som samsvarer med filspesifikasjon
HELP_8=  %0I ?      inkluder elementer fra filliste
HELP_9=  %0e ?      ekskluder elementer som samsvarer med filspesifikasjon
HELP_10=  %0E ?      ekskluder elementer fra filliste
HELP_11=
HELP_12=  %0d        ekskluder tomme kataloger
HELP_13=  %0D        ikke søk rekursivt i underkataloger
HELP_14=  %0a        inkluder alle skjulte filer og systemfiler
HELP_15=  %0o        overskriv eksisterende filer
HELP_16=  %0k        ikke ignorer store/små bokstaver i filnavn
HELP_17=
HELP_18=  %0g ?      angi gruppekategori
HELP_19=  %0s ?      størrelse for å dele opp arkiv, K, M eller bytes. (kun
HELP_20=             gyldig ved oppretting eller nyoppdeling av arkiv)
HELP_21=
HELP_22=  %0y        aksepter automatisk alle forespørsler (bortsett fra
HELP_23=             overskriving av filer).
HELP_24=Operasjoner relatert til hele arkivet:
HELP_25=
HELP_26=  %0f ?      angi arkivfilnavn
HELP_27=  %0c        opprett et nytt arkiv
HELP_28=  %0r        legg til i et eksisterende arkiv
HELP_29=  %0x        pakk ut fra et eksisterende arkiv
HELP_30=  %0R        generer arkivrapport
HELP_31=  %0O ?      angi målbanen for utpakking
HELP_32=
HELP_33=Innebygd tekst, merknader og meldinger:
HELP_34=
HELP_35=  %0L ?      overstyr systemets standardspråk
HELP_36=  %0m ?      bygg inn meldingstekst fra fil
HELP_37=  %0M ?      bygg inn tekst fra fil som krever brukerens samtykke
HELP_38=
HELP_39=Pass-through komprimering:
HELP_40=
HELP_41=  %0p ?      aktiver pass-through komprimering (GZ, kanskje andre)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Forvirret? Bruk alternativet "%0h" for hjelp.

FATAL=FATAL FEIL:%_
ERROR=FEIL:%_
BAD_OPT=Ugyldig kommandolinjeparameter "%0%1"
BAD_CMB=Kan ikke kombinere parameter "%0%1" med "%0%2"
BAD_MCO=Mangler kommandolinjedata for "%0%1"
BAD_INT=Ugyldig numerisk verdi "%2" for "%0%1"
BAD_VAL=Numerisk verdi "%2" er utenfor området "%3 - %4" for "%0%1"
BAD_MAX=Maksimalt antall arkivdeler overskredet for "%1"
BAD_VER=Arkiv "%1" kan inneholde ustøttede datastrukturer.
BAD_EMB=Du kan kun spesifisere én meldingstekstfil om gangen.
BAD_MSG=Melding "%1" er for stor. Avkortet til %2.
BAD_CMP=Ustøttet pass-through komprimering "%2"
BAD_TMP=TEMP-katalog er påkrevd.
ER_UNK=feilkode #%0, uspesifisert feil med "%1" %2
ER_2=Filen "%1" ble ikke funnet.
ER_3=Banen til filen "%1" ble ikke funnet.
ER_8=Kremt, jeg gikk tom for minne.
ER_11=Filen "%1" har ukjent format.
ER_13=Filen "%1" inneholder korrupte data.
ER_14=Avbrutt av bruker.
ER_23=Signatur stemmer ikke overens. Fil "%1" har korrupte data.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 kl. %1

BYTES=% byte(s)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% diskett
