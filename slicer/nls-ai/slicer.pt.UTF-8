; Language: Portuguese
; File ending: pt
; Codepage: 860
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=pt
TITLE=%, Versão %
COPYRIGHT=Direitos de autor (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (continuação)
INC_DIR=%2
INC_TEXT=incorporar texto: %2 %8
INC_HEAD=texto: %2 %8
USE_COMP=compressão pass-through activada para %0

VERB_PRE_SCAN=verificados % itens para adicionar ao arquivo
VERB_INC_FILE=incluir: %9%2 (%A)\[%3] %8
VERB_INC_CONT=continuar: %2 [%3] (continuação do offset %6)
VERB_INC_DIR=subdirectório: %2 (%3)
VERB_INC_HEAD=incorporar texto de cabeçalho: %2 %8

; Excluded file or dir
VERB_EXCLUDE=excluir: %0 (corresponde a "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=adicionar "%1" à lista %0
LIST_INC=incluir
LIST_EXC=excluir

; Same params as reporting
EXT_DIR=directório: %2
EXT_FILE=ficheiro: %9%2, %8
EXT_PART=parcial: %9%2, %7 de %8
VERB_EXT_RPCL=ficheiro %9%2 existe, substituído
VERB_EXT_SKIP=ficheiro %9%2 existe, ignorado

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=categoria: %2
REP_DIR=directório: %2
REP_FILE=ficheiro: %9%2, %8
REP_PART=parcial: %9%2, %7 de %8
REP_TEXT=texto: %2, %8
REP_MORE=continuação: %2, %8
REP_CONF=aceitar: %2, %8

VERB_REP_CAT=definir categoria: %2, %1
VERB_REP_DIR=directório: %2 (%3), %1 %4 %5
VERB_REP_FILE=ficheiro completo: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 tamanho do ficheiro %8
VERB_REP_PART=ficheiro parcial: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 de %8 (offset %6)
VERB_REP_TEXT=texto: %2 %4 {%3}, %8
VERB_REP_MORE=continuação: %2 %4 {%3}, %8
VERB_REP_CONF=aceitar: %2 %4 {%3}, %8
VERB_REP_SIG=assinatura: %2 [%3], %1
VERB_REP_NULL=bloco nulo, %1
VERB_REP_OTHER=bloco desconhecido %0, %1
VERB_REP_SLICE=seleccionar parte %

SAF_CREATE=Criar novo arquivo slicer %
SAF_OPEN=Abrir arquivo slicer existente %
SAF_APPEND=Anexar a arquivo slicer existente %
SAF_DATE=Criado a %2/%1/%0 às %3:%4:%5
SAF_SLICE=Criar nova parte de arquivo %
SAF_CAT=Definir categoria de arquivo %
SAF_SLICING=A dividir arquivo em %
VERB_SAF_IUP=Actualizar informação estatística para o arquivo %

MEDIA=Insira a disquete com o ficheiro %0 na unidade %1.
PAUSE=Prima qualquer tecla para continuar.

PROMPT_YES=Sim
PROMPT_NO=Não
PROMPT_Y=S
PROMPT_N=N
PROMPT_OVER=Sobrescrever %2%1, %0?
PROMPT_ACCEPT=Aceitar %?
PROMPT_STOP=O ficheiro %1 está corrompido. Abortar extracção %0?

SUMMARY=%0 parte(s), %1 dir(s), %2 ficheiro(s), %3

USAGE=uso: % [opções]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=Informação das opções do SLICER:
HELP_1=
HELP_2=  %0q        desactivar todas as mensagens de estado
HELP_3=  %0v        activar mensagens de estado detalhadas
HELP_4=  %0t        modo de teste
HELP_5=  %0h        mostrar informação de ajuda
HELP_6=
HELP_7=  %0i ?      incluir itens que correspondam à especificação
HELP_8=  %0I ?      incluir itens da lista de ficheiros
HELP_9=  %0e ?      excluir itens que correspondam à especificação
HELP_10=  %0E ?      excluir itens da lista de ficheiros
HELP_11=
HELP_12=  %0d        excluir directórios vazios
HELP_13=  %0D        não pesquisar subdirectórios recursivamente
HELP_14=  %0a        incluir todos os itens ocultos e de sistema
HELP_15=  %0o        sobrescrever ficheiros existentes
HELP_16=  %0k        não ignorar maiúsculas/minúsculas nos nomes de ficheiros
HELP_17=
HELP_18=  %0g ?      especificar categoria de grupo
HELP_19=  %0s ?      tamanho para dividir arquivo, K, M ou bytes. (apenas
HELP_20=             válido ao criar um novo ou re-dividir arquivo existente)
HELP_21=
HELP_22=  %0y        aceitar automaticamente todos os pedidos (excepto
HELP_23=             a sobrescrita de ficheiros).
HELP_24=Operações relacionadas a todo o arquivo:
HELP_25=
HELP_26=  %0f ?      especificar o nome de ficheiro do arquivo
HELP_27=  %0c        criar um novo arquivo
HELP_28=  %0r        anexar a um arquivo existente
HELP_29=  %0x        extrair de um arquivo existente
HELP_30=  %0R        gerar relatório do arquivo
HELP_31=  %0O ?      definir caminho de destino para extracção
HELP_32=
HELP_33=Texto incorporado, notificações e mensagens:
HELP_34=
HELP_35=  %0L ?      sobrescrever o idioma predefinido do sistema
HELP_36=  %0m ?      incorporar texto de mensagem de um ficheiro
HELP_37=  %0M ?      incorporar texto de um ficheiro que requer consentimento
HELP_38=
HELP_39=Compressão pass-through:
HELP_40=
HELP_41=  %0p ?      activar compressão pass-through (GZ, talvez outros depois)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Terra da confusão. Para ajuda, use a opção "%0h".

FATAL=ERRO FATAL:%_
ERROR=ERRO:%_
BAD_OPT=Parâmetro de linha de comandos inválido "%0%1"
BAD_CMB=Não é possível combinar parâmetros "%0%1" com "%0%2"
BAD_MCO=Faltam dados de linha de comandos para "%0%1"
BAD_INT=Valor numérico inválido "%2" para "%0%1"
BAD_VAL=Valor numérico "%2" fora do intervalo "%3 - %4" para "%0%1"
BAD_MAX=Número máximo de partes de arquivo excedido para "%1"
BAD_VER=O arquivo "%1" pode conter estruturas de dados não suportadas.
BAD_EMB=Apenas é possível especificar um ficheiro de texto de mensagem de cada vez.
BAD_MSG=Nota de mensagem "%1" muito grande. Truncado para %2.
BAD_CMP=Compressão pass-through não suportada "%2"
BAD_TMP=Directório TEMP é necessário.
ER_UNK=código de erro #%0, erro não especificado com "%1" %2
ER_2=O ficheiro "%1" não foi encontrado.
ER_3=O caminho do ficheiro "%1" não foi encontrado.
ER_8=Uhm, fiquei sem memória.
ER_11=O ficheiro "%1" tem um formato não reconhecido.
ER_13=O ficheiro "%1" tem dados corrompidos.
ER_14=Terminado pelo utilizador.
ER_23=Incompatibilidade de assinatura. O ficheiro "%1" tem dados corrompidos.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2/%1/%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 às %1

BYTES=% byte(s)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% disquete
