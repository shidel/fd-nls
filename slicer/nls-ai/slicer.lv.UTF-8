; Language: Latvian
; File ending: lv
; Codepage: 775
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=lv
TITLE=%, Versija %
COPYRIGHT=Autortiesības (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (turpinājums)
INC_DIR=%2
INC_TEXT=iegult tekstu: %2 %8
INC_HEAD=teksts: %2 %8
USE_COMP=iespējota %0 pass-through saspiešana

VERB_PRE_SCAN=noskenēti % vienumi pievienošanai arhīvam
VERB_INC_FILE=iekļaut: %9%2 (%A)\[%3] %8
VERB_INC_CONT=turpināt: %2 [%3] (turpinājums no nobīdes %6)
VERB_INC_DIR=apakšdirektorijs: %2 (%3)
VERB_INC_HEAD=iegult galvenes tekstu: %2 %8

; Excluded file or dir
VERB_EXCLUDE=izslēgt: %0 (atbilst "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=pievienot "%1" %0 sarakstam
LIST_INC=iekļaut
LIST_EXC=izslēgt

; Same params as reporting
EXT_DIR=direktorijs: %2
EXT_FILE=fails: %9%2, %8
EXT_PART=daļējs: %9%2, %7 no %8
VERB_EXT_RPCL=fails %9%2 eksistē, aizstāts
VERB_EXT_SKIP=fails %9%2 eksistē, izlaists

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategorija: %2
REP_DIR=direktorijs: %2
REP_FILE=fails: %9%2, %8
REP_PART=daļējs: %9%2, %7 no %8
REP_TEXT=teksts: %2, %8
REP_MORE=turpinājums: %2, %8
REP_CONF=pieņemt: %2, %8

VERB_REP_CAT=iestatīt kategoriju: %2, %1
VERB_REP_DIR=direktorijs: %2 (%3), %1 %4 %5
VERB_REP_FILE=viss fails: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 faila lielums %8
VERB_REP_PART=daļējs fails: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 no %8 (nobīde %6)
VERB_REP_TEXT=teksts: %2 %4 {%3}, %8
VERB_REP_MORE=turpinājums: %2 %4 {%3}, %8
VERB_REP_CONF=pieņemt: %2 %4 {%3}, %8
VERB_REP_SIG=paraksts: %2 [%3], %1
VERB_REP_NULL=nulles bloks, %1
VERB_REP_OTHER=nezināms bloks %0, %1
VERB_REP_SLICE=izvēlēties daļu %

SAF_CREATE=Izveidot jaunu slicer arhīvu %
SAF_OPEN=Atvērt esošu slicer arhīvu %
SAF_APPEND=Pievienot esošam slicer arhīvam %
SAF_DATE=Izveidots %2.%1.%0 plkst. %3:%4:%5
SAF_SLICE=Izveidot jaunu arhīva daļu %
SAF_CAT=Iestatīt arhīva kategoriju %
SAF_SLICING=Sadalīt arhīvu pie %
VERB_SAF_IUP=Atjaunināt statistikas informāciju arhīvam %

MEDIA=Ievietojiet disketi ar failu %0 dzinī %1.
PAUSE=Nospiediet jebkuru taustiņu, lai turpinātu.

PROMPT_YES=Jā
PROMPT_NO=Nē
PROMPT_Y=J
PROMPT_N=N
PROMPT_OVER=Pārrakstīt %2%1, %0?
PROMPT_ACCEPT=Pieņemt %?
PROMPT_STOP=Fails %1 ir bojāts. Pārtraukt izgūšanu %0?

SUMMARY=%0 daļa(s), %1 dir., %2 fails(i), %3

USAGE=lietojums: % [opcijas]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER opciju informācija:
HELP_1=
HELP_2=  %0q        atspējot visus statusa ziņojumus
HELP_3=  %0v        iespējot detalizētus statusa ziņojumus
HELP_4=  %0t        testa režīms
HELP_5=  %0h        parādīt palīdzības informāciju
HELP_6=
HELP_7=  %0i ?      iekļaut vienumus, kas atbilst faila specifikācijai
HELP_8=  %0I ?      iekļaut vienumus no failu saraksta
HELP_9=  %0e ?      izslēgt vienumus, kas atbilst faila specifikācijai
HELP_10=  %0E ?      izslēgt vienumus no failu saraksta
HELP_11=
HELP_12=  %0d        izslēgt tukšus direktorijus
HELP_13=  %0D        neiekļaut apakšdirektorijus
HELP_14=  %0a        iekļaut visus slēptos un sistēmas vienumus
HELP_15=  %0o        pārrakstīt esošos failus
HELP_16=  %0k        neignorēt lielo/mazo burtu reģistru failu nosaukumos
HELP_17=
HELP_18=  %0g ?      norādīt grupas kategoriją
HELP_19=  %0s ?      arhīva daļas lielums (K, M vai baiti). (derīgs tikai
HELP_20=             veidojot jaunu vai sadalot esošu arhīvu)
HELP_21=
HELP_22=  %0y        automātiski pieņemt visas uzvednes (izņemot failu
HELP_23=             pārrakstīšanu).
HELP_24=Darbības, kas saistītas ar visu arhīvu:
HELP_25=
HELP_26=  %0f ?      norādīt arhīva faila nosaukumu
HELP_27=  %0c        izveidot jaunu arhīvu
HELP_28=  %0r        pievienot esošam arhīvam
HELP_29=  %0x        izgūt no esoša arhīva
HELP_30=  %0R        ģenerēt arhīva atskaiti
HELP_31=  %0O ?      iestatīt mērķa ceļu izgūšanai
HELP_32=
HELP_33=Iegultais teksts, paziņojumi un ziņojumi:
HELP_34=
HELP_35=  %0L ?      ignorēt sistēmas noklusējuma valodu
HELP_36=  %0m ?      iegult ziņojuma tekstu no faila
HELP_37=  %0M ?      iegult tekstu no faila, kas prasa lietotāja piekrišanu
HELP_38=
HELP_39=Pass-through saspiešana:
HELP_40=
HELP_41=  %0p ?      iespējot pass-through saspiešanu (GZ, vēlāk varbūt citi)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Apjukuma zeme. Palīdzībai izmantojiet opciju "%0h".

FATAL=KRITISKA KĻŪDA:%_
ERROR=KĻŪDA:%_
BAD_OPT=Nederīgs komandrindas parametrs "%0%1"
BAD_CMB=Nevar kombinēt parametrus "%0%1" un "%0%2"
BAD_MCO=Trūkst komandrindas datu "%0%1"
BAD_INT=Nederīga skaitliskā vērtība "%2" priekš "%0%1"
BAD_VAL=Skaitliskā vērtība "%2" ir ārpus diapazona "%3 - %4" priekš "%0%1"
BAD_MAX=Pārsniegts maksimālais arhīva daļu skaits priekš "%1"
BAD_VER=Arhīvs "%1" var saturēt neatbalstītas datu struktūras.
BAD_EMB=Vienlaicīgi var norādīt tikai vienu ziņojuma teksta failu.
BAD_MSG=Ziņojuma piezīme "%1" pārāk liela. Saīsināta līdz %2.
BAD_CMP=Neatbalstīta pass-through saspiešana "%2"
BAD_TMP=Nepieciešams TEMP direktorijs.
ER_UNK=kļūdas kods #%0, nenorādīta kļūda ar "%1" %2
ER_2=Fails "%1" netika atrasts.
ER_3=Ceļš failam "%1" netika atrasts.
ER_8=Hmm, beidzās atmiņa.
ER_11=Failam "%1" ir neatpazīts formāts.
ER_13=Fails "%1" satur bojātus datus.
ER_14=Lietotājs pārtrauca.
ER_23=Parakstu nesakritība. Fails "%1" satur bojātus datus.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 plkst. %1

BYTES=% baits(i)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% diskete
