; Language: Ukrainian
; File ending: uk
; Codepage: 1125
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=uk
TITLE=%, Версія %
COPYRIGHT=Авторські права (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (продовження)
INC_DIR=%2
INC_TEXT=вбудувати текст: %2 %8
INC_HEAD=текст: %2 %8
USE_COMP=увімкнено %0 pass-through стиснення

VERB_PRE_SCAN=проскановано % елементів для додавання до архіву
VERB_INC_FILE=включити: %9%2 (%A)\[%3] %8
VERB_INC_CONT=продовжити: %2 [%3] (продовження зі зміщення %6)
VERB_INC_DIR=підкаталог: %2 (%3)
VERB_INC_HEAD=вбудувати текст заголовка: %2 %8

; Excluded file or dir
VERB_EXCLUDE=виключити: %0 (збігається з "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=додати "%1" до списку %0
LIST_INC=включити
LIST_EXC=виключити

; Same params as reporting
EXT_DIR=каталог: %2
EXT_FILE=файл: %9%2, %8
EXT_PART=частковий: %9%2, %7 з %8
VERB_EXT_RPCL=файл %9%2 існує, замінено
VERB_EXT_SKIP=файл %9%2 існує, пропущено

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=категорія: %2
REP_DIR=каталог: %2
REP_FILE=файл: %9%2, %8
REP_PART=частковий: %9%2, %7 з %8
REP_TEXT=текст: %2, %8
REP_MORE=продовження: %2, %8
REP_CONF=прийняти: %2, %8

VERB_REP_CAT=встановити категорію: %2, %1
VERB_REP_DIR=каталог: %2 (%3), %1 %4 %5
VERB_REP_FILE=повний файл: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 розмір файлу %8
VERB_REP_PART=частковий файл: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 з %8 (зміщення %6)
VERB_REP_TEXT=текст: %2 %4 {%3}, %8
VERB_REP_MORE=продовження: %2 %4 {%3}, %8
VERB_REP_CONF=прийняти: %2 %4 {%3}, %8
VERB_REP_SIG=підпис: %2 [%3], %1
VERB_REP_NULL=нульовий блок, %1
VERB_REP_OTHER=невідомий блок %0, %1
VERB_REP_SLICE=вибрати частину %

SAF_CREATE=Створити новий архів slicer %
SAF_OPEN=Відкрити існуючий архів slicer %
SAF_APPEND=Додати до існуючого архіву slicer %
SAF_DATE=Створено %2.%1.%0 о %3:%4:%5
SAF_SLICE=Створити нову частину архіву %
SAF_CAT=Встановити категорію архіву %
SAF_SLICING=Розбиття архіву на %
VERB_SAF_IUP=Оновити статистичну інформацію для архіву %

MEDIA=Вставте дискету з файлом %0 у дисковод %1.
PAUSE=Натисніть будь-яку клавішу для продовження.

PROMPT_YES=Так
PROMPT_NO=Ні
PROMPT_Y=Т
PROMPT_N=Н
PROMPT_OVER=Перезаписати %2%1, %0?
PROMPT_ACCEPT=Прийняти %?
PROMPT_STOP=Файл %1 пошкоджено. Перервати вилучення %0?

SUMMARY=%0 част., %1 кат., %2 файл(ів), %3

USAGE=використання: % [параметри]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=Інформація про параметри SLICER:
HELP_1=
HELP_2=  %0q        вимкнути всі повідомлення про стан
HELP_3=  %0v        увімкнути детальні повідомлення про стан
HELP_4=  %0t        тестовий режим
HELP_5=  %0h        показати довідкову інформацію
HELP_6=
HELP_7=  %0i ?      включити елементи, що відповідають специфікації
HELP_8=  %0I ?      включити елементи зі списку файлів
HELP_9=  %0e ?      виключити елементи, що відповідають специфікації
HELP_10=  %0E ?      виключити елементи зі списку файлів
HELP_11=
HELP_12=  %0d        виключити порожні каталоги
HELP_13=  %0D        не виконувати рекурсивний пошук у підкаталогах
HELP_14=  %0a        включити всі приховані та системні елементи
HELP_15=  %0o        перезаписувати існуючі файли
HELP_16=  %0k        не ігнорувати регістр в іменах файлів
HELP_17=
HELP_18=  %0g ?      вказати категорію групи
HELP_19=  %0s ?      розмір для розбиття архіву (K, M або байти). (тільки
HELP_20=             при створенні нового або перерозбитті існуючого)
HELP_21=
HELP_22=  %0y        автоматично приймати всі запити (крім
HELP_23=             перезапису файлів).
HELP_24=Операції, що стосуються всього архіву:
HELP_25=
HELP_26=  %0f ?      вказати ім'я файлу архіву
HELP_27=  %0c        створити новий архів
HELP_28=  %0r        додати до існуючого архіву
HELP_29=  %0x        вилучити з існуючого архіву
HELP_30=  %0R        згенерувати звіт про архів
HELP_31=  %0O ?      задати цільовий шлях для вилучення
HELP_32=
HELP_33=Вбудований текст, сповіщення та повідомлення:
HELP_34=
HELP_35=  %0L ?      перевизначити системну мову за замовчуванням
HELP_36=  %0m ?      вбудувати текст повідомлення з файлу
HELP_37=  %0M ?      вбудувати текст з файлу, що вимагає згоди користувача
HELP_38=
HELP_39=Стиснення pass-through:
HELP_40=
HELP_41=  %0p ?      увімкнути pass-through стиснення (GZ, можливо інші)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Країна плутанини. Для отримання допомоги використовуйте параметр "%0h".

FATAL=КРИТИЧНА ПОМИЛКА:%_
ERROR=ПОМИЛКА:%_
BAD_OPT=Неприпустимий параметр командного рядка "%0%1"
BAD_CMB=Неможливо об'єднати параметри "%0%1" та "%0%2"
BAD_MCO=Відсутні дані командного рядка для "%0%1"
BAD_INT=Неприпустиме числове значення "%2" для "%0%1"
BAD_VAL=Числове значення "%2" поза діапазоном "%3 - %4" для "%0%1"
BAD_MAX=Перевищено максимальну кількість частин архіву для "%1"
BAD_VER=Архів "%1" може містити непідтримувані структури даних.
BAD_EMB=Одночасно можна вказати лише один текстовий файл повідомлення.
BAD_MSG=Текст повідомлення "%1" завеликий. Усічено до %2.
BAD_CMP=Непідтримуване pass-through стиснення "%2"
BAD_TMP=Потрібен каталог TEMP.
ER_UNK=код помилки #%0, неуточнена помилка з "%1" %2
ER_2=Файл "%1" не знайдено.
ER_3=Шлях до файлу "%1" не знайдено.
ER_8=Ой, не вистачає пам'яті.
ER_11=Файл "%1" має нерозпізнаний формат.
ER_13=Файл "%1" містить пошкоджені дані.
ER_14=Перервано користувачем.
ER_23=Невідповідність підпису. Файл "%1" містить пошкоджені дані.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%2.%1.%0
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0 о %1

BYTES=% байт
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% дискета
