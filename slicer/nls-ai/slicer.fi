; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (jatkuu)
INC_DIR=%2
INC_TEXT=upota teksti: %2 %8
INC_HEAD=teksti: %2 %8
USE_COMP=sallittu %0 pass-through -pakkaus

