; Language: Lithuanian
; File ending: lt
; Codepage: 775
; This translation was made by Google Gemini.
; Please help the FreeDOS group to improve it.

; English Langauge Resource and Translation File
; changes by W. Spiegl: added %0 and %1 in line 84
; note %_ is a space, %% is percent, %r is CRLF,
; %0-F (1 char hex) are params, % alone is next param.
; Items that start VERB_ are Verbose mode versions.

LANGUAGE=lt
TITLE=%, % Versija
COPYRIGHT=Autorių teisės (c) 2019-%, Jerome Shidel

; Same params as reporting
INC_FILE=%9%2 %8
INC_CONT=%2 (tęsinys)
INC_DIR=%2
INC_TEXT=įterpti tekstą: %2 %8
INC_HEAD=tekstas: %2 %8
USE_COMP=įjungtas %0 pass-through glaudinimas

VERB_PRE_SCAN=nuskenuota % elementų pridėjimui į archyvą
VERB_INC_FILE=įtraukti: %9%2 (%A)\[%3] %8
VERB_INC_CONT=tęsti: %2 [%3] (tęsiama nuo poslinkio %6)
VERB_INC_DIR=pakatalogis: %2 (%3)
VERB_INC_HEAD=įterpti antraštės tekstą: %2 %8

; Excluded file or dir
VERB_EXCLUDE=išskirti: %0 (atitinka "%1")

; Lists %0 is list, %1 is file
LIST_ITEM=%
LIST_FILE=pridėti "%1" į %0 sąrašą
LIST_INC=įtraukti
LIST_EXC=išskirti

; Same params as reporting
EXT_DIR=katalogas: %2
EXT_FILE=failas: %9%2, %8
EXT_PART=dalinis: %9%2, %7 iš %8
VERB_EXT_RPCL=failas %9%2 egzistuoja, pakeistas
VERB_EXT_SKIP=failas %9%2 egzistuoja, praleistas

; Report & Extraction parameters
; %0 block ID    (all)
; %1 block size  (all)
; %2 name       (dir & file name, or text language)
; %3 unique ID (all)
; %4 attributes (dir & file attribs, or text verbose level)
; %5 time stamp (dir & file only)
; %6 file offest (file only)
; %7 file bytes (file only)
; %8 total file size (file and text only)
; %9 path (file only)
; %A path ID (file only)
REP_CAT=kategorija: %2
REP_DIR=katalogas: %2
REP_FILE=failas: %9%2, %8
REP_PART=dalinis: %9%2, %7 iš %8
REP_TEXT=tekstas: %2, %8
REP_MORE=tęsinys: %2, %8
REP_CONF=priimti: %2, %8

VERB_REP_CAT=nustatyti kategoriją: %2, %1
VERB_REP_DIR=katalogas: %2 (%3), %1 %4 %5
VERB_REP_FILE=visas failas: %9%2 (%A)\[%3], %1
VERB_REP_FILE2=%4 %5 failo dydis %8
VERB_REP_PART=dalinis failas: %9%2 (%A)\[%3], %1
VERB_REP_PART2=%4 %5 %7 iš %8 (poslinkis %6)
VERB_REP_TEXT=tekstas: %2 %4 {%3}, %8
VERB_REP_MORE=tęsinys: %2 %4 {%3}, %8
VERB_REP_CONF=priimti: %2 %4 {%3}, %8
VERB_REP_SIG=parašas: %2 [%3], %1
VERB_REP_NULL=nulinis blokas, %1
VERB_REP_OTHER=nežinomas blokas %0, %1
VERB_REP_SLICE=pasirinkti dalį %

SAF_CREATE=Sukurti naują slicer archyvą %
SAF_OPEN=Atidaryti esamą slicer archyvą %
SAF_APPEND=Pridėti prie esamo slicer archyvo %
SAF_DATE=Sukurta %0-%1-%2, %3:%4:%5
SAF_SLICE=Sukurti naują archyvo dalį %
SAF_CAT=Nustatyti archyvo kategoriją %
SAF_SLICING=Archyvo skaidymas ties %
VERB_SAF_IUP=Atnaujinti statistinę informaciją archyvui %

MEDIA=Įdėkite diskelį su failu %0 į įrenginį %1.
PAUSE=Paspauskite bet kurį klavišą, kad tęstumėte.

PROMPT_YES=Taip
PROMPT_NO=Ne
PROMPT_Y=T
PROMPT_N=N
PROMPT_OVER=Perrašyti %2%1, %0?
PROMPT_ACCEPT=Priimti %?
PROMPT_STOP=Failas %1 sugadintas. Nutraukti išskleidimą %0?

SUMMARY=%0 dalis(-ys), %1 kat., %2 failas(-ai), %3

USAGE=naudojimas: % [parinktys]

; All help lines are displayed in order until the first missing number is
; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=SLICER parinkčių informacija:
HELP_1=
HELP_2=  %0q        išjungti visus būsenos pranešimus
HELP_3=  %0v        įjungti išsamius būsenos pranešimus
HELP_4=  %0t        testavimo režimas
HELP_5=  %0h        rodyti pagalbos informaciją
HELP_6=
HELP_7=  %0i ?      įtraukti elementus, atitinkančius failo specifikaciją
HELP_8=  %0I ?      įtraukti elementus iš failų sąrašo
HELP_9=  %0e ?      išskirti elementus, atitinkančius failo specifikaciją
HELP_10=  %0E ?      išskirti elementus iš failų sąrašo
HELP_11=
HELP_12=  %0d        išskirti tuščius katalogus
HELP_13=  %0D        neieškoti pakatalogiuose
HELP_14=  %0a        įtraukti visus paslėptus ir sistemos elementus
HELP_15=  %0o        perrašyti esamus failus
HELP_16=  %0k        neignoruoti didžiųjų/mažųjų raidžių failų pavadinimuose
HELP_17=
HELP_18=  %0g ?      nurodyti grupės kategoriją
HELP_19=  %0s ?      dydis archyvo skaidymui (K, M arba baitai). (galioja
HELP_20=             tik kuriant naują arba iš naujo skaidant esamą archyvą)
HELP_21=
HELP_22=  %0y        automatiškai priimti visus raginimus (išskyrus failų
HELP_23=             perrašymą).
HELP_24=Operacijos susijusios su visu archyvu:
HELP_25=
HELP_26=  %0f ?      nurodyti archyvo failo pavadinimą
HELP_27=  %0c        sukurti naują archyvą
HELP_28=  %0r        pridėti prie esamo archyvo
HELP_29=  %0x        išskleisti iš esamo archyvo
HELP_30=  %0R        generuoti archyvo ataskaitą
HELP_31=  %0O ?      nustatyti išskleidimo paskirties kelią
HELP_32=
HELP_33=Įterptas tekstas, pranešimai ir pastabos:
HELP_34=
HELP_35=  %0L ?      nepaisyti numatytosios sistemos kalbos
HELP_36=  %0m ?      įterpti pranešimo tekstą iš failo
HELP_37=  %0M ?      įterpti pranešimą, reikalaujantį naudotojo sutikimo
HELP_38=
HELP_39=Pass-through glaudinimas:
HELP_40=
HELP_41=  %0p ?      įjungti pass-through glaudinimą (GZ, galbūt ir kitus)
HELP_42=

; Reserved for future use
; HELP_00=  %0u        update existing archive
; HELP_00=  %0S        re-slice archive
; HELP_00=  %0w        write verification
; HELP_00=  %0z        use compression

NEEDHELP=Sumišimo šalis. Pagalbai naudokite parinktį "%0h".

FATAL=KRITINĖ KLAIDA:%_
ERROR=KLAIDA:%_
BAD_OPT=Neteisingas komandų eilutės parametras "%0%1"
BAD_CMB=Negalima derinti parametrų "%0%1" su "%0%2"
BAD_MCO=Trūksta komandų eilutės duomenų parametrui "%0%1"
BAD_INT=Neteisinga skaitinė reikšmė "%2" parametrui "%0%1"
BAD_VAL=Skaitinė reikšmė "%2" yra už diapazono "%3 - %4" ribų "%0%1"
BAD_MAX=Viršytas maksimalus archyvo dalių skaičius "%1"
BAD_VER=Archyve "%1" gali būti nepalaikomų duomenų struktūrų.
BAD_EMB=Vienu metu galima nurodyti tik vieną pranešimo teksto failą.
BAD_MSG=Pranešimo pastaba "%1" per didelė. Sutrumpinta iki %2.
BAD_CMP=Nepalaikomas pass-through glaudinimas "%2"
BAD_TMP=Būtinas TEMP katalogas.
ER_UNK=klaidos kodas #%0, nenurodyta klaida su "%1" %2
ER_2=Failas "%1" nerastas.
ER_3=Failo "%1" kelias nerastas.
ER_8=Amm, man pritrūko atminties.
ER_11=Failas "%1" yra neatpažinto formato.
ER_13=Faile "%1" yra sugadintų duomenų.
ER_14=Nutraukė naudotojas.
ER_23=Parašų neatitikimas. Faile "%1" yra sugadintų duomenų.

; Used for date time stamps
; DATE = %0 4 digit Year, %1 2 digit Month, %2 2 digit Day,
;        %3 2 digit year, %4 1-2 digit Month, %5 1-2 digit day
DATE=%0-%1-%2
; TIME = %0 Hour (24 hour), %1 Minute, %2 Second
;        %3 12 hour clock, %4 AM/PM
TIME=%0:%1:%2
AM=a
PM=p
; STAMP = %0 date, %1 time
STAMP=%0, %1

BYTES=% baitas(-ai)
KBYTES=% KiB
MBYTES=% MiB
FLOPPY=% diskelis
