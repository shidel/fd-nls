; encountered. You can add lines. But, keep the numbers in order by renumbering
; all lines after your additional help message. %0 is the Switch Character / or -
HELP_0=Ўнформацўя про параметри SLICER:
HELP_1=
HELP_2=  %0q        вимкнути всў повўдомлення про стан
HELP_3=  %0v        увўмкнути детальнў повўдомлення про стан
HELP_4=  %0t        тестовий режим
HELP_5=  %0h        показати довўдкову ўнформацўю
HELP_6=
HELP_7=  %0i ?      включити елементи, що вўдповўдають специфўкацў∙
HELP_8=  %0I ?      включити елементи зў списку файлўв
HELP_9=  %0e ?      виключити елементи, що вўдповўдають специфўкацў∙
HELP_10=  %0E ?      виключити елементи зў списку файлўв
HELP_11=
HELP_12=  %0d        виключити порожнў каталоги
HELP_13=  %0D        не виконувати рекурсивний пошук у пўдкаталогах
HELP_14=  %0a        включити всў прихованў та системнў елементи
HELP_15=  %0o        перезаписувати ўснуючў файли
HELP_16=  %0k        не ўгнорувати регўстр в ўменах файлўв
HELP_17=
HELP_18=  %0g ?      вказати категорўю групи
HELP_19=  %0s ?      розмўр для розбиття архўву (K, M або байти). (тўльки
HELP_20=             при створеннў нового або перерозбиттў ўснуючого)
HELP_21=
HELP_22=  %0y        автоматично приймати всў запити (крўм
HELP_23=             перезапису файлўв).
HELP_24=Операцў∙, що стосуються всього архўву:
HELP_25=
HELP_26=  %0f ?      вказати ўм'я файлу архўву
HELP_27=  %0c        створити новий архўв
HELP_28=  %0r        додати до ўснуючого архўву
HELP_29=  %0x        вилучити з ўснуючого архўву
